{% extends 'base.html.twig' %}

{# Présentation guidée (OnboardingController) : gabarit commun des 4 étapes.
   Variables : step, stepCount, steps (numéro => titre), user.
   Blocs : step_title, step_intro, step_body, step_actions (boutons du bas, par défaut « Passer cette étape »).
   Pied : « Retour » (lien, étape > 1) à gauche · action(s) de l'étape à droite (primaire en dernier). #}

{% block title %}Bienvenue — Étape {{ step }}/{{ stepCount }} — SprueHub{% endblock %}

{% set onb_primary = 'btn btn-primary' %}
{% set onb_secondary = 'btn btn-secondary' %}
{% set onb_link = 'link' %}

{% block body %}
{% import '_macros/ui.html.twig' as ui %}
{% set percent = (step * 100 / stepCount)|round %}
<div class="mx-auto max-w-2xl space-y-6">

    {# ─── Progression ─── #}
    <header class="space-y-4">
        <div class="flex items-center justify-between gap-4">
            <p class="eyebrow text-primary-text">Présentation · étape {{ step }} sur {{ stepCount }}</p>
            <a href="{{ path('app_home') }}" class="btn btn-ghost btn-sm -mr-2">Continuer plus tard</a>
        </div>
        <div class="progress" role="progressbar"
             aria-label="Progression de la présentation" aria-valuemin="1" aria-valuemax="{{ stepCount }}"
             aria-valuenow="{{ step }}" aria-valuetext="Étape {{ step }} sur {{ stepCount }}">
            <div class="progress-bar" style="width: {{ percent }}%"></div>
        </div>
        <nav aria-label="Étapes de la présentation">
            <ol class="grid grid-cols-4 gap-2">
                {% for number, title in steps %}
                    {% set state = number == step ? 'current' : (number < step ? 'past' : 'next') %}
                    <li>
                        <a href="{{ path('app_onboarding_step', {step: number}) }}"
                           {% if state == 'current' %}aria-current="step"{% endif %}
                           class="flex min-h-11 flex-col items-center gap-1.5 rounded-control px-1 py-1 text-center text-caption transition-colors duration-(--duration-fast) {{ state == 'current' ? 'font-semibold text-fg' : 'text-muted hover:text-fg' }}">
                            <span class="flex size-8 items-center justify-center rounded-pill border-2 text-small font-bold
                                         {{ state == 'current' ? 'border-primary-text bg-primary text-primary-fg' : (state == 'past' ? 'border-primary-text/60 bg-primary-soft text-primary-text' : 'border-line-strong bg-surface text-muted') }}" aria-hidden="true">
                                {%- if state == 'past' %}{{ ui.icon('check', 'size-4') }}{% else %}{{ number }}{% endif -%}
                            </span>
                            <span class="hidden leading-tight sm:block">{{ title }}</span>
                            <span class="sr-only sm:hidden">Étape {{ number }} : {{ title }}</span>
                        </a>
                    </li>
                {% endfor %}
            </ol>
        </nav>
    </header>

    {# ─── Étape ─── #}
    <section class="card" aria-labelledby="onboarding-title">
        <div class="card-body sm:p-7">
            <h1 id="onboarding-title" class="text-h1 text-fg">{% block step_title %}{{ steps[step] }}{% endblock %}</h1>
            <div class="mt-2 max-w-prose text-fg-secondary">{% block step_intro %}{% endblock %}</div>
            <div class="mt-6">
                {% block step_body %}{% endblock %}
            </div>
        </div>
    </section>

    {# ─── Navigation (barre collante : les actions restent visibles pendant le défilement) ─── #}
    <div class="sticky bottom-[calc(var(--bottom-bar-h)+env(safe-area-inset-bottom))] z-(--z-sticky) -mx-4 flex items-center gap-2 border-t border-line bg-canvas/90 px-4 py-3 backdrop-blur sm:mx-0 sm:gap-3 sm:rounded-card sm:border md:bottom-4">
        {% if step > 1 %}
            <a href="{{ path('app_onboarding_step', {step: step - 1}) }}" class="btn btn-ghost shrink-0 px-3">{{ ui.icon('arrow-left') }}<span class="sr-only sm:not-sr-only">Retour</span></a>
        {% endif %}
        <div class="flex flex-1 items-center justify-end gap-2 *:flex-1 sm:gap-3 sm:*:flex-none">
            {% block step_actions %}
                {% if step < stepCount %}
                    <form method="post" action="{{ path('app_onboarding_next', {step: step}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('onboarding') }}">
                        <button type="submit" class="{{ onb_secondary }} w-full"><span>Passer<span class="hidden sm:inline"> cette étape</span></span></button>
                    </form>
                {% endif %}
            {% endblock %}
        </div>
    </div>
</div>
{% endblock %}
