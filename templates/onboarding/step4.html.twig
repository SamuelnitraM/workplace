{% extends 'onboarding/_layout.html.twig' %}
{% import '_macros/ui.html.twig' as ui %}

{% block step_intro %}
    Ton profil est prêt. Voici comment progresser sur SprueHub.
{% endblock %}

{% block step_body %}
<div class="space-y-6">
    <section aria-labelledby="xp-title" class="rounded-control border border-accent/30 bg-accent-soft p-4">
        <h2 id="xp-title" class="flex items-center gap-2 text-h3 text-fg"><span class="text-accent-text">{{ ui.icon('star') }}</span>Comment gagner de l'XP</h2>
        <ul class="mt-3 space-y-2.5 text-small text-fg-secondary">
            <li class="flex gap-3"><span class="mt-0.5 text-accent-text">{{ ui.icon('calendar', 'size-4') }}</span><span><strong class="text-fg">+{{ dailyLoginXp }} XP</strong> par jour de connexion.</span></li>
            <li class="flex gap-3"><span class="mt-0.5 text-accent-text">{{ ui.icon('flame', 'size-4') }}</span><span><strong class="text-fg">+{{ streakBonusXp }} XP</strong> tous les {{ streakBonusEvery }} jours de série.</span></li>
            <li class="flex gap-3"><span class="mt-0.5 text-accent-text">{{ ui.icon('shield', 'size-4') }}</span><span>Ta série est conservée jusqu'à {{ streakMaxMissedDays }} jours d'absence.</span></li>
            <li class="flex gap-3"><span class="mt-0.5 text-accent-text">{{ ui.icon('medal', 'size-4') }}</span><span>Des <strong class="text-fg">badges</strong> récompensent ta participation (sujets, réponses, votes reçus…) : chacun rapporte de l'XP et peut devenir ton titre.</span></li>
        </ul>
    </section>

    <section aria-labelledby="first-actions-title">
        <h2 id="first-actions-title" class="text-h3 text-fg">Tes premières actions</h2>
        <ul class="mt-3 space-y-2">
            {% for action in [
                {icon: 'message-square', title: 'Publier ton premier sujet', text: 'Badge Pionnier I : +50 XP', url: path('app_forum_index'), reward: true},
                {icon: 'compass', title: 'Explorer le forum', text: 'Peinture, listes d\'armée, rapports de bataille…', url: path('app_forum_index'), reward: false},
                {icon: 'trophy', title: 'Voir le classement', text: 'Les membres les plus actifs de la communauté.', url: path('app_leaderboard'), reward: false},
            ] %}
                <li>
                    <a href="{{ action.url }}" class="card card-interactive flex items-center gap-3 bg-surface-raised p-4 shadow-none">
                        <span class="flex size-10 shrink-0 items-center justify-center rounded-control bg-primary-soft text-primary-text">{{ ui.icon(action.icon) }}</span>
                        <span class="min-w-0 flex-1">
                            <span class="block font-semibold text-fg">{{ action.title }}</span>
                            <span class="block text-small {{ action.reward ? 'text-accent-text' : 'text-muted' }}">{{ action.text }}</span>
                        </span>
                        <span class="text-muted">{{ ui.icon('chevron-right', 'size-4') }}</span>
                    </a>
                </li>
            {% endfor %}
        </ul>
    </section>
</div>
{% endblock %}

{% block step_actions %}
    <form method="post" action="{{ path('app_onboarding_finish') }}">
        <input type="hidden" name="_token" value="{{ csrf_token('onboarding') }}">
        <button type="submit" class="{{ onb_primary }} w-full sm:w-auto">{{ ui.icon('check') }}Terminer</button>
    </form>
{% endblock %}
