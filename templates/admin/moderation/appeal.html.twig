{% extends '@EasyAdmin/page/content.html.twig' %}

{% block page_title %}Réclamation #{{ appeal.id }} — {{ member.username }}{% endblock %}

{#
    Appeal of a suspended member: message, sanction appealed against (captured when the appeal was sent),
    history of the reports about the member (each entry opens its report page and the reported content),
    then the decision: lift or uphold the sanction, with the answer e-mailed to the member.
#}
{% block main %}
<div class="row g-4">
    <div class="col-lg-7">
        <section class="card mb-4">
            <div class="card-body">
                <p class="text-muted small mb-1">Reçue le {{ appeal.createdAt|date('d/m/Y à H:i', 'Europe/Paris') }} · <a href="{{ path('admin_moderation_member', {id: member.id}) }}">fiche du membre</a></p>
                <h2 class="h5 mb-3">Message de {{ member.username }}</h2>
                <blockquote class="border-start border-3 ps-3 mb-0 text-break" style="white-space: pre-line">{{ appeal.message }}</blockquote>
            </div>
        </section>

        <section class="card mb-4">
            <div class="card-body">
                <h2 class="h6 mb-2">Sanction contestée</h2>
                <p class="mb-1">
                    {% if appeal.againstPermanentBan %}
                        <span class="badge sanction sanction-ban">Banni définitivement</span>
                    {% else %}
                        <span class="badge sanction sanction-suspension">Suspendu jusqu'au {{ appeal.suspendedUntil|date('d/m/Y à H:i', 'Europe/Paris') }}</span>
                    {% endif %}
                </p>
                <p class="mb-0"><strong>Motif :</strong> {{ appeal.suspensionReason ?: 'non précisé' }}</p>
            </div>
        </section>

        <section class="card">
            <div class="card-body">
                <h2 class="h6">Historique des sanctions et signalements visant {{ member.username }} ({{ reports|length }})</h2>
                {% if reports is empty %}
                    <p class="text-muted mb-0">Aucun signalement : la sanction a été prise depuis la fiche du membre.</p>
                {% else %}
                    <ul class="list-group list-group-flush">
                        {% for report in reports %}
                            <li class="list-group-item px-0 small">
                                <a href="{{ path('admin_moderation_report', {id: report.id}) }}" class="moderation-history-item">
                                    <span>#{{ report.id }} · {{ report.createdAt|date('d/m/Y') }} · {{ report.targetType.label }} · {{ report.reason.label }}</span>
                                    {% if report.pending %}<span class="badge bg-warning text-dark">en attente</span>{% else %}{% for resolution in report.resolutions %}<span class="badge sanction sanction-{{ resolution.severity }}">{{ resolution.label }}</span>{% endfor %}{% endif %}
                                </a>
                                <p class="text-muted mb-0 mt-1 text-truncate">« {{ report.excerpt }} »</p>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </div>
        </section>
    </div>

    <div class="col-lg-5">
        {% if appeal.pending %}
            <section class="card">
                <form method="post" action="{{ path('admin_moderation_appeal_decision', {id: appeal.id}) }}" class="card-body">
                    <input type="hidden" name="_token" value="{{ csrf_token(csrfTokenId) }}">
                    <h2 class="h6 mb-2">Décision</h2>
                    {% if canSanction %}
                        {% if member.suspended %}
                            <p class="small text-muted">La réponse est envoyée par e-mail au membre, avec la décision.</p>
                        {% else %}
                            <div class="alert alert-secondary small">La sanction a déjà pris fin ou a été levée.</div>
                        {% endif %}
                        <label class="form-label" for="appeal-response">Réponse au membre</label>
                        <textarea class="form-control mb-3" id="appeal-response" name="response" rows="5" required></textarea>
                        <div class="d-flex flex-wrap gap-2">
                            <button type="submit" name="decision" value="lift" class="btn btn-success"><i class="fa fa-unlock"></i> Lever la sanction</button>
                            <button type="submit" name="decision" value="uphold" class="btn btn-danger"><i class="fa fa-lock"></i> Maintenir la sanction</button>
                        </div>
                    {% else %}
                        <div class="alert alert-secondary mb-0">Ce compte ne peut pas être sanctionné depuis ton rôle : un administrateur doit traiter la réclamation.</div>
                    {% endif %}
                </form>
            </section>
        {% else %}
            <section class="card">
                <div class="card-body">
                    <h2 class="h6">Réclamation traitée</h2>
                    <p class="mb-2">
                        <span class="badge {{ appeal.status == 'lifted' ? 'bg-success' : 'bg-secondary' }}">{{ appeal.statusLabel }}</span>
                        {% if appeal.handledBy %} par {{ appeal.handledBy.username }}{% endif %} le {{ appeal.handledAt|date('d/m/Y à H:i', 'Europe/Paris') }}.
                    </p>
                    <p class="small mb-0" style="white-space: pre-line">{{ appeal.response }}</p>
                </div>
            </section>
        {% endif %}

        {% if otherAppeals is not empty %}
            <section class="card mt-4">
                <div class="card-body">
                    <h2 class="h6">Autres réclamations de {{ member.username }}</h2>
                    <ul class="list-unstyled small mb-0">
                        {% for other in otherAppeals %}
                            <li><a href="{{ path('admin_moderation_appeal', {id: other.id}) }}">#{{ other.id }} · {{ other.createdAt|date('d/m/Y') }}</a> · {{ other.statusLabel }}</li>
                        {% endfor %}
                    </ul>
                </div>
            </section>
        {% endif %}
        <p class="mt-3"><a href="{{ appealsUrl }}"><i class="fa fa-arrow-left"></i> Retour aux réclamations</a></p>
    </div>
</div>
{% endblock %}
