{% extends '@EasyAdmin/page/content.html.twig' %}

{% block page_title %}Signalement #{{ report.id }}{% endblock %}

{% block main %}
{% set author = report.targetAuthor %}
{% set type = report.targetType %}
<div class="row g-4">
    <div class="col-lg-7">
        <section class="card mb-4">
            <div class="card-body">
                <p class="text-muted small mb-1">{{ type.label }} · reçu le {{ report.createdAt|date('d/m/Y à H:i') }}</p>
                <h2 class="h5 mb-3">{{ report.reason.label }}</h2>
                <blockquote class="border-start border-3 ps-3 mb-3 text-break">{{ report.excerpt }}</blockquote>
                {% if report.details %}
                    <p class="mb-2"><strong>Précisions :</strong> {{ report.details }}</p>
                {% endif %}
                <ul class="list-unstyled small mb-0">
                    <li>Signalé par : {{ report.reporter ? report.reporter.username : 'compte supprimé' }}</li>
                    <li>Auteur : {% if author %}<a href="{{ path('admin_moderation_member', {id: author.id}) }}">{{ author.username }}</a>{% if author.suspended %} <span class="badge bg-danger">suspendu</span>{% endif %}{% else %}compte supprimé{% endif %}</li>
                    <li>
                        Contenu :
                        {% if not targetAvailable %}<span class="badge bg-secondary">supprimé</span>
                        {% elseif targetHidden %}<span class="badge bg-warning text-dark">masqué</span>
                        {% else %}<span class="badge bg-success">en ligne</span>{% endif %}
                        {% if targetAvailable and report.targetUrl %}<a href="{{ report.targetUrl }}" target="_blank" rel="noopener">voir sur le site</a>{% endif %}
                    </li>
                </ul>
            </div>
        </section>

        <section class="card">
            <div class="card-body">
                <h2 class="h6">Signalements de ce contenu ({{ relatedReports|length }})</h2>
                <ul class="list-group list-group-flush">
                    {% for related in relatedReports %}
                        <li class="list-group-item px-0 small">
                            {{ related.createdAt|date('d/m/Y H:i') }} · {{ related.reason.label }} · {{ related.reporter ? related.reporter.username : 'compte supprimé' }}
                            {% if related.pending %}<span class="badge bg-warning text-dark">en attente</span>
                            {% else %}{% for resolution in related.resolutions %}<span class="badge sanction sanction-{{ resolution.severity }} me-1">{{ resolution.label }}</span>{% endfor %}{% if related.handledBy %} par {{ related.handledBy.username }}{% endif %}{% if related.moderatorNote %} — {{ related.moderatorNote }}{% endif %}{% endif %}
                        </li>
                    {% endfor %}
                </ul>
            </div>
        </section>

        {% if author %}
            {# Every report about the contents of the author; each entry opens its report page #}
            <section class="card mt-4">
                <div class="card-body">
                    <h2 class="h6">Historique des signalements visant {{ author.username }} ({{ authorHistory|length }})</h2>
                    <ul class="list-group list-group-flush">
                        {% for entry in authorHistory %}
                            <li class="list-group-item px-0 small">
                                <a href="{{ path('admin_moderation_report', {id: entry.id}) }}" class="moderation-history-item {{ entry.id == report.id ? 'is-current' }}">
                                    <span>#{{ entry.id }} · {{ entry.createdAt|date('d/m/Y H:i') }} · {{ entry.targetType.label }} · {{ entry.reason.label }}</span>
                                    {% if entry.pending %}<span class="badge bg-warning text-dark">en attente</span>
                                    {% else %}{% for resolution in entry.resolutions %}<span class="badge sanction sanction-{{ resolution.severity }}">{{ resolution.label }}</span>{% endfor %}{% endif %}
                                    {% if entry.id == report.id %}<span class="text-muted">(ce signalement)</span>{% endif %}
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            </section>
        {% endif %}
    </div>

    <div class="col-lg-5">
        {% if report.pending %}
            {#
                Combined decision: every action is prepared first, then applied together by « Traiter »
                after a confirmation window listing them (moderation-decision script below).
            #}
            <form method="post" action="{{ path('admin_moderation_report_decision', {id: report.id}) }}" id="moderation-decision" class="card">
                <input type="hidden" name="_token" value="{{ csrf_token(csrfTokenId) }}">
                <div class="card-body">
                    <h2 class="h6 mb-1">Décision</h2>
                    <p class="small text-muted">Prépare toutes les actions puis valide-les ensemble. Sans aucune action, le signalement est classé sans suite. La décision s'applique à tous les signalements en attente de ce contenu ; l'auteur est prévenu par notification et par e-mail.</p>

                    <fieldset class="mb-3">
                        <legend class="form-label fw-semibold fs-6">Contenu</legend>
                        {% for action in contentActions %}
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="content" id="content-{{ action.value }}" value="{{ action.value }}" {{ loop.first ? 'checked' }} data-summary="{{ action.label }}{{ action.value == 'delete' ? ' (définitif' ~ (type.value in ['sujet', 'reponse'] ? ', un message d\'ouverture supprime tout le sujet' : '') ~ (type.value == 'groupe' ? ', avec ses salons, messages et tâches' : '') ~ ')' }}">
                                <label class="form-check-label" for="content-{{ action.value }}">{{ action.label }}</label>
                            </div>
                        {% endfor %}
                        {% if not targetAvailable %}<p class="small text-muted mb-0 mt-1">Le contenu n'existe plus.</p>{% endif %}
                    </fieldset>

                    {% if author %}
                        <fieldset class="mb-3 border-top pt-3">
                            <legend class="form-label fw-semibold fs-6">Avertir {{ author.username }}</legend>
                            <label class="form-label small text-muted" for="decision-warning">Message envoyé au membre (laisser vide pour ne pas avertir)</label>
                            <textarea class="form-control" id="decision-warning" name="warning" rows="3"></textarea>
                        </fieldset>
                        {% if canSuspendAuthor %}
                            <fieldset class="mb-3 border-top pt-3">
                                <legend class="form-label fw-semibold fs-6">Suspendre {{ author.username }}</legend>
                                {{ include('admin/moderation/_suspension_fields.html.twig', {field_id: 'decision-duration', optional: true}) }}
                                <label class="form-label mt-2" for="decision-suspension-reason">Motif communiqué au membre</label>
                                <textarea class="form-control" id="decision-suspension-reason" name="suspension_reason" rows="2"></textarea>
                            </fieldset>
                        {% endif %}
                    {% endif %}

                    <div class="border-top pt-3">
                        <label class="form-label" for="decision-note">Note interne (facultative)</label>
                        <textarea class="form-control" id="decision-note" name="note" rows="2"></textarea>
                    </div>
                </div>
                <div class="card-footer d-flex justify-content-end">
                    <button type="submit" class="btn btn-primary"><i class="fa fa-gavel"></i> Traiter</button>
                </div>
            </form>

            <dialog id="moderation-confirm" class="moderation-confirm" aria-labelledby="moderation-confirm-title">
                <h2 id="moderation-confirm-title" class="h6">Confirmer la décision</h2>
                <ul id="moderation-confirm-list" class="small mb-3"></ul>
                <div class="d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-secondary" data-confirm-cancel>Annuler</button>
                    <button type="button" class="btn btn-primary" data-confirm-accept><i class="fa fa-check"></i> Confirmer</button>
                </div>
            </dialog>
        {% else %}
            <section class="card">
                <div class="card-body">
                    <h2 class="h6">Signalement traité</h2>
                    <p class="mb-2">
                        {% for resolution in report.resolutions %}<span class="badge sanction sanction-{{ resolution.severity }} me-1">{{ resolution.label }}</span>{% endfor %}
                        {% if report.handledBy %} par {{ report.handledBy.username }}{% endif %} le {{ report.handledAt|date('d/m/Y à H:i') }}.
                    </p>
                    {% if report.moderatorNote %}<p class="small text-muted" style="white-space: pre-line">{{ report.moderatorNote }}</p>{% endif %}
                    {% if targetHidden %}
                        <form method="post" action="{{ path('admin_moderation_report_restore', {id: report.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token(csrfTokenId) }}">
                            <button type="submit" class="btn btn-secondary"><i class="fa fa-eye"></i> Rétablir le contenu</button>
                        </form>
                    {% endif %}
                </div>
            </section>
        {% endif %}
        <p class="mt-3"><a href="{{ queueUrl }}"><i class="fa fa-arrow-left"></i> Retour à la file de modération</a></p>
    </div>
</div>
{% endblock %}

{% block body_javascript %}
    {{ parent() }}
    <script>
        (() => {
            // Opens the confirmation window listing the prepared actions; the form is sent once they are confirmed
            const form = document.getElementById('moderation-decision');
            const dialog = document.getElementById('moderation-confirm');
            if (!form || !dialog) return;
            const list = document.getElementById('moderation-confirm-list');
            const valueOf = name => (form.elements[name]?.value || '').trim();
            const describeDecision = () => {
                const actions = [];
                const content = form.querySelector('input[name="content"]:checked');
                if (content && content.value !== 'keep') actions.push(content.dataset.summary);
                if (valueOf('warning')) actions.push('Avertissement : « ' + valueOf('warning') + ' »');
                const duration = form.elements.duration;
                if (duration && duration.value) actions.push('Suspension (' + duration.options[duration.selectedIndex].text.toLowerCase() + ') : « ' + valueOf('suspension_reason') + ' »');
                return actions.length ? actions : ['Classer sans suite'];
            };
            form.addEventListener('submit', event => {
                event.preventDefault();
                list.replaceChildren(...describeDecision().map(text => Object.assign(document.createElement('li'), { textContent: text })));
                dialog.showModal();
            });
            dialog.querySelector('[data-confirm-cancel]').addEventListener('click', () => dialog.close());
            dialog.querySelector('[data-confirm-accept]').addEventListener('click', () => form.submit());
        })();
    </script>
{% endblock %}
