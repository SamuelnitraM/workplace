{#
    Bar chart of the admin dashboard: expects "chart" (App\Statistics\BarChart).
    One bar per day from a single baseline, value axis with three round ticks, detail on hover or keyboard focus,
    one date label a week, ending on the last day, and a table view carrying every value.
#}
{% set unit = chart.unit %}
<figure class="hf-card hf-chart p-3 p-md-4 h-100 mb-0" aria-labelledby="{{ chart.id }}-title">
    <figcaption class="mb-3">
        <h3 id="{{ chart.id }}-title" class="h6 fw-bold mb-1">{{ chart.title }}</h3>
        <p class="text-muted small mb-0">{{ chart.description }}</p>
    </figcaption>
    <div class="hf-chart-frame">
        <div class="hf-chart-axis" aria-hidden="true">
            {% for tick in chart.ticks|reverse %}
                <span style="bottom: {{ chart.heightOf(tick) }}%">{{ tick|number_format(0, ',', ' ') }}{{ unit }}</span>
            {% endfor %}
        </div>
        <div class="hf-chart-plot">
            {% for tick in chart.ticks %}<span class="hf-chart-grid" style="bottom: {{ chart.heightOf(tick) }}%" aria-hidden="true"></span>{% endfor %}
            <ol class="hf-chart-bars" aria-label="{{ chart.title }}">
                {% for point in chart.points %}
                    <li class="hf-chart-slot" tabindex="0" data-detail="{{ point.detail }}" aria-label="{{ point.detail }}">
                        <span class="hf-chart-bar{{ point.value is null ? ' is-empty' }}" style="height: {{ chart.heightOf(point.value) }}%"></span>
                    </li>
                {% endfor %}
            </ol>
        </div>
        <ol class="hf-chart-labels" aria-hidden="true">
            {% for point in chart.points %}<li>{{ loop.revindex0 % 7 == 0 ? point.label }}</li>{% endfor %}
        </ol>
    </div>
    <details class="mt-3 small">
        <summary class="text-primary">Voir le tableau</summary>
        <div class="hf-chart-table">
            <table class="table table-sm mb-0">
                <thead><tr><th scope="col">Jour</th><th scope="col" class="text-end">Valeur</th></tr></thead>
                <tbody>
                    {% for point in chart.points|reverse %}
                        <tr><td>{{ point.label }}</td><td class="text-end">{{ point.value is null ? '—' : point.value|number_format(unit == '%' ? 1 : 0, ',', ' ') ~ (unit ? ' ' ~ unit) }}</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </details>
</figure>
