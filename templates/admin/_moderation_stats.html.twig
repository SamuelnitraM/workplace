{# Moderation block of the dashboard: expects "moderationStats" (App\Moderation\ModerationStatistics::summary, durations formatted) and "recentDays". #}
{% macro summary_table(title, rows, column_label) %}
    <div class="hf-card">
        <h3 class="hf-card-title">{{ title }}</h3>
        {% if rows is empty %}
            <p class="hf-dash-hint mb-0">Aucun signalement.</p>
        {% else %}
            <table class="table hf-table mb-0">
                <thead><tr><th scope="col">{{ column_label }}</th><th scope="col" class="text-end">Nombre</th></tr></thead>
                <tbody>
                    {% for row in rows %}
                        <tr>
                            <td>{% if row.severity is defined %}<span class="badge sanction sanction-{{ row.severity }}">{{ row.label }}</span>{% else %}{{ row.label }}{% endif %}</td>
                            <td class="text-end">{{ row.count|number_format(0, ',', ' ') }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>
{% endmacro %}
{% import _self as moderation %}

<section class="hf-dash-section" aria-labelledby="moderation-stats-title">
    <h2 id="moderation-stats-title" class="hf-dash-section-title">Modération</h2>
    <div class="hf-dash-grid hf-dash-grid-4">
        <div class="hf-tile hf-tile-column">
            <span class="hf-tile-icon"><i class="fa fa-stopwatch"></i></span>
            <span class="hf-tile-body">
                <span class="hf-tile-label">Temps moyen de traitement</span>
                <strong class="hf-tile-value">{{ moderationStats.recentAverageHandling }}</strong>
                <span class="hf-tile-note">sur les {{ recentDays }} derniers jours · {{ moderationStats.averageHandling }} depuis le début</span>
            </span>
        </div>
        {{ moderation.summary_table('Motifs les plus fréquents', moderationStats.reasons, 'Motif') }}
        {{ moderation.summary_table('Contenus les plus signalés', moderationStats.targetTypes, 'Type de contenu') }}
        {{ moderation.summary_table('Décisions prises', moderationStats.resolutions, 'Décision') }}
    </div>
</section>
