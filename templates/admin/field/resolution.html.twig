{# Decision of a report in the moderation lists, with the colour code of its severity (App\Moderation\ReportResolution::severity()). #}
{% set resolution = field.value %}
{% if resolution %}
    <span class="badge sanction sanction-{{ resolution.severity }}">{{ resolution.label }}</span>
{% else %}
    <span class="text-muted">—</span>
{% endif %}
