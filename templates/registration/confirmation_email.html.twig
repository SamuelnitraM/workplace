<div style="margin:0;padding:24px 12px;background-color:#f4f5f8;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#1f2430;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:520px;margin:0 auto;background-color:#ffffff;border:1px solid #e3e6ec;border-radius:12px;">
        <tr>
            <td style="padding:28px 28px 8px 28px;">
                <p style="margin:0 0 4px 0;font-size:12px;font-weight:600;letter-spacing:0.06em;text-transform:uppercase;color:#4f46e5;">SprueHub</p>
                <h1 style="margin:0;font-size:22px;line-height:1.3;font-weight:700;color:#1f2430;">Bonjour ! Merci de confirmer votre adresse email</h1>
            </td>
        </tr>
        <tr>
            <td style="padding:12px 28px 0 28px;font-size:16px;line-height:1.6;color:#3d4454;">
                <p style="margin:0 0 20px 0;">Pour activer votre compte, confirmez votre adresse email en cliquant sur le bouton ci-dessous.</p>
                <p style="margin:0 0 20px 0;">
                    <a href="{{ signedUrl|raw }}" style="display:inline-block;padding:12px 22px;background-color:#4f46e5;color:#ffffff;font-weight:600;text-decoration:none;border-radius:8px;">Confirmer mon adresse email</a>
                </p>
                <p style="margin:0 0 20px 0;font-size:14px;color:#5b6272;">Ce lien expirera dans {{ expiresAtMessageKey|trans(expiresAtMessageData, 'VerifyEmailBundle') }}.</p>
            </td>
        </tr>
        <tr>
            <td style="padding:0 28px 28px 28px;border-top:1px solid #e3e6ec;font-size:14px;line-height:1.5;color:#5b6272;">
                <p style="margin:16px 0 0 0;">À bientôt sur SprueHub !</p>
            </td>
        </tr>
    </table>
</div>
