{% extends 'base.html.twig' %}

{% block title %}Créer un compte{% endblock %}

{% block body %}

<div class="max-w-md mx-auto">

    {# CARTE #}
    <div class="bg-gray-800 border border-gray-700 rounded-2xl p-8 shadow-xl">

        {# HEADER #}
        <div class="text-center mb-8">
            <h1 class="text-3xl font-bold text-white mb-2">
                Rejoindre HighlightForge
            </h1>

            <p class="text-gray-400">
                Crée ton compte et rejoins la communauté des passionnés de figurines.
            </p>
        </div>

        {# ERREURS EMAIL VERIFY #}
        {% for flash_error in app.flashes('verify_email_error') %}
            <div class="mb-6 bg-red-500/10 border border-red-500 text-red-400 px-4 py-3 rounded-lg">
                {{ flash_error }}
            </div>
        {% endfor %}

        {{ form_start(registrationForm, {
            attr: {
                class: 'space-y-6'
            }
        }) }}

            {# EMAIL #}
            <div>
                {{ form_label(registrationForm.email, 'Adresse email', {
                    label_attr: {
                        class: 'block text-sm font-medium text-gray-300 mb-2'
                    }
                }) }}

                {{ form_widget(registrationForm.email, {
                    attr: {
                        class: 'w-full rounded-xl bg-gray-900 border border-gray-700 px-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition',
                        placeholder: 'exemple@email.com'
                    }
                }) }}

                {{ form_errors(registrationForm.email) }}
            </div>

            {# USERNAME #}
            <div>
                {{ form_label(registrationForm.username, 'Pseudo', {
                    label_attr: {
                        class: 'block text-sm font-medium text-gray-300 mb-2'
                    }
                }) }}

                {{ form_widget(registrationForm.username, {
                    attr: {
                        class: 'w-full rounded-xl bg-gray-900 border border-gray-700 px-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition',
                        placeholder: 'Pseudo'
                    }
                }) }}

                {{ form_errors(registrationForm.username) }}
            </div>

            {# MOT DE PASSE #}
            <div>
                {{ form_label(registrationForm.plainPassword, 'Mot de passe', {
                    label_attr: {
                        class: 'block text-sm font-medium text-gray-300 mb-2'
                    }
                }) }}

                {{ form_widget(registrationForm.plainPassword, {
                    attr: {
                        class: 'w-full rounded-xl bg-gray-900 border border-gray-700 px-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition',
                        placeholder: '••••••••'
                    }
                }) }}

                <p class="text-xs text-gray-500 mt-2">
                    Utilise un mot de passe sécurisé.
                </p>

                {{ form_errors(registrationForm.plainPassword) }}
            </div>

            {# CONDITIONS #}
            <div class="flex items-start gap-3">
                {{ form_widget(registrationForm.agreeTerms, {
                    attr: {
                        class: 'mt-1 rounded border-gray-600 bg-gray-900 text-indigo-600 focus:ring-indigo-500'
                    }
                }) }}

                <label for="{{ registrationForm.agreeTerms.vars.id }}"
                       class="text-sm text-gray-400 leading-relaxed">
                    J’accepte les conditions d’utilisation de la plateforme.
                </label>
            </div>

            {{ form_errors(registrationForm.agreeTerms) }}

            {# BOUTON #}
            <button type="submit"
                    class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 rounded-xl transition duration-200 shadow-lg shadow-indigo-600/20">
                Créer mon compte
            </button>

        {{ form_end(registrationForm) }}

        {# FOOTER #}
        <div class="mt-6 text-center text-sm text-gray-500">
            Déjà membre ?
            <a href="{{ path('app_login') }}"
               class="text-indigo-400 hover:text-indigo-300 transition">
                Se connecter
            </a>
        </div>

    </div>

</div>

{% endblock %}