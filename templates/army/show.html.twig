{% extends 'base.html.twig' %}
{% import '_macros/ui.html.twig' as ui %}

{% block title %}{{ armyList.name }}{% endblock %}

{% block body %}
{% set can_edit = is_granted('ARMY_EDIT', armyList) %}
{% set model_count = armyList.units|reduce((carry, u) => carry + u.quantity, 0) %}
{% set battle_size = armyList.battleSize %}
<div class="max-w-4xl mx-auto" data-controller="modal">

    <header class="page-header">
        <div class="min-w-0">
            {% if can_edit %}
                <p class="page-header-eyebrow"><a href="{{ path('app_army_index') }}" class="link">Mes listes d'armée</a>{{ ui.icon('chevron-right', 'size-4') }}Liste</p>
            {% else %}
                <p class="page-header-eyebrow"><a href="{{ path('app_army_explorer') }}" class="link">Explorer</a>{{ ui.icon('chevron-right', 'size-4') }}Liste de <a href="{{ path('app_profil_show', {username: armyList.owner.username}) }}" class="link">{{ armyList.owner.username }}</a></p>
            {% endif %}
            <h1 class="page-header-title break-words">{{ armyList.name }}</h1>
            <div class="mt-3 flex flex-wrap items-center gap-2">
                <span class="chip chip-primary">{{ ui.icon('shield') }}{{ armyList.faction }}</span>
                {% if armyList.detachment %}<span class="chip">{{ armyList.detachment }}</span>{% endif %}
                {% if battle_size %}
                    <span class="chip chip-accent">{{ ui.icon('trophy') }}Officielle · {{ battle_size.label }} {{ battle_size.pointsLimit }} pts</span>
                {% else %}
                    <span class="chip">{{ ui.icon('paintbrush') }}Liste libre</span>
                {% endif %}
                {% if armyList.isPublic %}
                    <span class="chip chip-success">{{ ui.icon('globe') }}Publique</span>
                {% else %}
                    <span class="chip">{{ ui.icon('lock') }}Privée</span>
                {% endif %}
            </div>
            {# Audience by other members (the owner's own views, exports and copies are not counted) #}
            <p class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1 text-small text-muted">
                <span class="inline-flex items-center gap-1.5" title="Vues">{{ ui.icon('eye', 'size-4') }}{{ armyList.viewCount }} vue{{ armyList.viewCount > 1 ? 's' }}</span>
                <span class="inline-flex items-center gap-1.5" title="Exports (texte, impression)">{{ ui.icon('download', 'size-4') }}{{ armyList.exportCount }} export{{ armyList.exportCount > 1 ? 's' }}</span>
                <span class="inline-flex items-center gap-1.5" title="Copies dans les listes d'autres membres">{{ ui.icon('copy', 'size-4') }}{{ armyList.duplicationCount }} duplication{{ armyList.duplicationCount > 1 ? 's' }}</span>
            </p>
        </div>

        <div class="page-header-actions">
            <div x-data="{ open: false }" class="dropdown" @keydown.escape="open = false">
                <button type="button" class="btn btn-secondary" @click="open = !open" :aria-expanded="open.toString()" aria-expanded="false" aria-haspopup="true">
                    {{ ui.icon('upload') }}Exporter{{ ui.icon('chevron-down') }}
                </button>
                <div class="menu" x-show="open" x-cloak @click.outside="open = false" x-transition.opacity>
                    <button type="button" class="menu-item w-full" data-action="modal#open" data-modal-id-param="army-export" @click="open = false">{{ ui.icon('file-text') }}Texte (application officielle)</button>
                    <a href="{{ path('app_army_export_text', {id: armyList.id}) }}" class="menu-item" data-turbo="false">{{ ui.icon('upload') }}Télécharger en .txt</a>
                    <a href="{{ path('app_army_print', {id: armyList.id}) }}" class="menu-item" target="_blank" rel="noopener">{{ ui.icon('file-text') }}Imprimer / PDF</a>
                    {% if armyList.isPublic %}
                        <div class="menu-separator"></div>
                        <div data-controller="clipboard" data-clipboard-text-value="{{ url('app_army_show', {id: armyList.id}) }}" data-clipboard-done-value="Lien copié !">
                            <button type="button" class="menu-item w-full" data-action="clipboard#copy">{{ ui.icon('link') }}<span data-clipboard-target="label">Copier le lien de partage</span></button>
                        </div>
                    {% endif %}
                </div>
            </div>
            {% if app.user %}
                <form method="post" action="{{ path('app_army_duplicate', {id: armyList.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('army_duplicate_' ~ armyList.id) }}">
                    <button type="submit" class="btn {{ can_edit ? 'btn-ghost' : 'btn-primary' }}">{{ ui.icon('clipboard-list') }}{{ can_edit ? 'Dupliquer' : 'Dupliquer dans mes listes' }}</button>
                </form>
            {% endif %}
            {% if can_edit %}
                <form method="post" action="{{ path('app_army_delete', {id: armyList.id}) }}"
                      {{ stimulus_controller('confirm', {message: 'Supprimer cette liste ?'})|stimulus_action('confirm', 'ask', 'submit') }}>
                    <input type="hidden" name="_token" value="{{ csrf_token('army_delete_' ~ armyList.id) }}">
                    <button type="submit" class="btn btn-ghost btn-icon text-danger-text hover:text-danger-text" aria-label="Supprimer la liste">{{ ui.icon('trash') }}</button>
                </form>
                <a href="{{ path('app_army_edit', {id: armyList.id}) }}" class="btn btn-primary">{{ ui.icon('pencil') }}Modifier</a>
            {% endif %}
        </div>
    </header>

    {# Official list: rules status #}
    {% if battle_size %}
        {% if ruleReport.errors is not empty %}
            <div class="alert alert-danger mb-6" role="alert">
                {{ ui.icon('alert-circle') }}
                <div><p class="alert-title">Liste non conforme</p><ul class="mt-1 list-disc pl-4">{% for message in ruleReport.errors %}<li>{{ message }}</li>{% endfor %}</ul></div>
            </div>
        {% elseif ruleReport.warnings is not empty %}
            <div class="alert alert-warning mb-6" role="status">
                {{ ui.icon('alert-triangle') }}
                <div><p class="alert-title">Liste à compléter</p><ul class="mt-1 list-disc pl-4">{% for message in ruleReport.warnings %}<li>{{ message }}</li>{% endfor %}</ul></div>
            </div>
        {% else %}
            <div class="alert alert-success mb-6" role="status">
                {{ ui.icon('check-circle') }}
                <p>Liste conforme au format {{ battle_size.label }} ({{ battle_size.pointsLimit }} pts).</p>
            </div>
        {% endif %}
    {% endif %}

    {# Summary #}
    <dl class="mb-6 grid grid-cols-3 gap-3">
        <div class="card card-body">
            <dt class="text-caption text-muted">Total</dt>
            <dd class="text-h2 font-bold text-accent-text tabular-nums">{{ armyList.totalPoints }}<span class="text-small font-semibold">{{ battle_size ? ' / ' ~ battle_size.pointsLimit : '' }} pts</span></dd>
        </div>
        <div class="card card-body">
            <dt class="text-caption text-muted">Unités</dt>
            <dd class="text-h2 font-bold text-fg tabular-nums">{{ model_count }}</dd>
        </div>
        <div class="card card-body">
            <dt class="text-caption text-muted">Fiches différentes</dt>
            <dd class="text-h2 font-bold text-fg tabular-nums">{{ armyList.units|map(u => u.name)|reduce((names, name) => name in names ? names : names|merge([name]), [])|length }}</dd>
        </div>
    </dl>

    {% if armyList.description %}
        <section class="card mb-6" aria-labelledby="army-description-title">
            <div class="card-body">
                <h2 id="army-description-title" class="eyebrow mb-2">Description</h2>
                <p class="text-fg-secondary whitespace-pre-line break-words">{{ armyList.description }}</p>
            </div>
        </section>
    {% endif %}

    {# UNITS #}
    {% if armyList.units is empty %}
        {{ include('_partials/_empty_state.html.twig', {
            icon: 'swords',
            title: 'Aucune unité dans cette liste',
            text: can_edit ? 'Ajoutez des unités depuis le catalogue de votre faction : le total de points se met à jour automatiquement.' : null,
            cta: can_edit ? {label: 'Ajouter des unités', url: path('app_army_edit', {id: armyList.id}), icon: 'plus'} : null,
        }) }}
    {% else %}
        <section class="card" aria-labelledby="roster-title">
            <div class="card-header">
                <h2 id="roster-title" class="text-h3 text-fg">Composition</h2>
                <span class="text-caption text-muted">Touche une unité pour ouvrir sa fiche</span>
            </div>

            <div class="roster-head" aria-hidden="true">
                <span></span><span>Unité</span><span class="text-center">Qté</span><span class="text-right">Points</span>
            </div>

            {% for group in unitGroups %}
            <section class="roster-group" aria-labelledby="roster-group-{{ group.key }}">
                <div class="unit-group-head roster-group-head">
                    <span class="unit-group-icon" aria-hidden="true">{{ ui.icon(group.icon) }}</span>
                    <h3 id="roster-group-{{ group.key }}" class="unit-group-title">{{ group.plural }}</h3>
                    <span class="unit-group-count">{{ group.count }} unité{{ group.count > 1 ? 's' }}</span>
                    <span class="unit-group-points"><span class="sr-only">Sous-total : </span>{{ group.points }} pts</span>
                </div>
                <ol class="roster">
                    {% for unit in group.units %}
                        <li class="roster-item">
                            <button type="button" class="roster-row roster-row-button" data-action="modal#open" data-modal-id-param="datasheet-{{ unit.id }}" aria-haspopup="dialog">
                                <span class="roster-chevron" aria-hidden="true">{{ ui.icon('file-text', 'size-4') }}</span>
                                <span class="roster-name">
                                    {{ unit.name }}
                                    <span class="mt-1 flex flex-wrap gap-1.5">
                                        {% if unit.warlord %}<span class="chip chip-accent">{{ ui.icon('crown') }}Seigneur de guerre</span>{% endif %}
                                        {% if unit.enhancementName %}<span class="chip chip-primary">{{ ui.icon('sparkles') }}{{ unit.enhancementName }}</span>{% endif %}
                                        {% if unit.modelCount %}<span class="chip">{{ unit.modelCount }} fig.</span>{% endif %}
                                    </span>
                                </span>
                                <span class="roster-qty"><span class="sr-only">Quantité : </span>×{{ unit.quantity }}</span>
                                <span class="roster-points">
                                    {{ unit.totalPoints }} pts
                                    {% if unit.quantity > 1 or unit.enhancementPoints > 0 %}
                                        <span class="block text-caption font-normal text-muted">{{ unit.points }}{{ unit.quantity > 1 ? ' × ' ~ unit.quantity }}{{ unit.enhancementPoints > 0 ? ' + ' ~ unit.enhancementPoints }}</span>
                                    {% endif %}
                                </span>
                            </button>
                        </li>
                    {% endfor %}
                </ol>
            </section>
            {% endfor %}

            <div class="roster-total">
                <span class="text-fg-secondary font-semibold">Total</span>
                <span class="text-h3 font-bold text-accent-text tabular-nums">{{ armyList.totalPoints }} pts</span>
            </div>
        </section>

        {# Datasheet windows #}
        {% for unit in armyList.units %}
            <dialog id="datasheet-{{ unit.id }}" class="modal modal-wide" aria-labelledby="datasheet-{{ unit.id }}-title" data-action="click->modal#closeOnBackdrop">
                <div class="modal-header">
                    <p class="modal-title" id="datasheet-{{ unit.id }}-title">Fiche technique</p>
                    <button type="button" class="btn btn-ghost btn-icon btn-sm" data-action="modal#close" aria-label="Fermer">{{ ui.icon('x') }}</button>
                </div>
                <div class="modal-body">
                    {{ include('army/_datasheet.html.twig', {unit: unit, heading_level: 2}) }}
                </div>
            </dialog>
        {% endfor %}
    {% endif %}

    {# Text export window #}
    <dialog id="army-export" class="modal" aria-labelledby="army-export-title" data-action="click->modal#closeOnBackdrop">
        <div class="modal-header">
            <p class="modal-title" id="army-export-title">Export texte</p>
            <button type="button" class="btn btn-ghost btn-icon btn-sm" data-action="modal#close" aria-label="Fermer">{{ ui.icon('x') }}</button>
        </div>
        <div class="modal-body" data-controller="clipboard" data-clipboard-done-value="Texte copié !">
            <p class="mb-3 text-small text-fg-secondary">Format de l'application officielle : colle-le dans un autre outil, ou dans l'import de SprueHub.</p>
            <label for="army-export-text" class="sr-only">Texte de la liste</label>
            <textarea id="army-export-text" class="textarea font-mono text-caption" rows="14" readonly data-clipboard-target="source">{{ exportText }}</textarea>
            <div class="mt-3 flex justify-end">
                <button type="button" class="btn btn-primary" data-action="clipboard#copy">{{ ui.icon('clipboard-list') }}<span data-clipboard-target="label">Copier le texte</span></button>
            </div>
        </div>
    </dialog>

</div>
{% endblock %}
