{% extends 'base.html.twig' %}

{% block title %}Modifier — {{ armyList.name }}{% endblock %}

{% block body %}
<div class="max-w-6xl mx-auto px-4 py-8"
     x-data="armyEditForm(JSON.parse(document.getElementById('initial-units-data').textContent))">

    <script type="application/json" id="initial-units-data">{{ initialUnitsJson|raw }}</script>

    <div class="mb-6">
        <a href="{{ path('app_army_show', {id: armyList.id}) }}" class="text-gray-400 hover:text-white text-sm transition">
            ← Retour à la liste
        </a>
        <h1 class="text-2xl font-bold text-white mt-1">✏️ Modifier la liste</h1>
    </div>

    <form method="post">

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
            <div>
                <label class="block text-sm text-gray-400 mb-1">Nom de la liste</label>
                <input type="text" name="name" required value="{{ armyList.name }}"
                       class="w-full bg-gray-700 border border-gray-600 rounded-lg px-4 py-2 text-white focus:outline-none focus:border-indigo-500">
            </div>

            <div>
                <label class="block text-sm text-gray-400 mb-1">Faction</label>
                <div class="w-full bg-gray-900 border border-gray-700 rounded-lg px-4 py-2 text-gray-400">
                    {{ armyList.faction }}
                    <span class="text-xs text-gray-600 ml-2">(non modifiable)</span>
                </div>
            </div>

            <div>
                <label class="block text-sm text-gray-400 mb-1">Détachement</label>
                <select name="detachment" x-model="selectedDetachment"
                        class="w-full bg-gray-700 border border-gray-600 rounded-lg px-4 py-2 text-white focus:outline-none focus:border-indigo-500">
                    <option value="">-- Aucun / à définir --</option>
                    <template x-for="det in availableDetachments" :key="det.id">
                        <option :value="det.nameEn" x-text="det.name"></option>
                    </template>
                </select>
            </div>

            <div class="flex items-end">
                <label class="flex items-center gap-3 cursor-pointer">
                    <input type="checkbox" name="isPublic" value="1" {{ armyList.isPublic ? 'checked' : '' }}
                           class="w-5 h-5 accent-indigo-500">
                    <span class="text-white text-sm">🌍 Liste publique</span>
                </label>
            </div>
        </div>

        <div class="mb-6">
            <label class="block text-sm text-gray-400 mb-1">Description / Lore</label>
            <textarea name="description" rows="3"
                      class="w-full bg-gray-700 border border-gray-600 rounded-lg px-4 py-2 text-white focus:outline-none focus:border-indigo-500">{{ armyList.description }}</textarea>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 border-t border-gray-700 pt-6">

            <div>
                <h2 class="text-lg font-semibold text-white mb-3">Unités disponibles</h2>

                <template x-if="loadingUnits">
                    <p class="text-gray-400 text-sm">Chargement...</p>
                </template>

                <template x-for="group in groupOrder" :key="group">
                    <div class="mb-5" x-show="groupedUnits[group] && groupedUnits[group].length > 0">
                        <h3 class="text-sm uppercase tracking-wide text-indigo-400 font-semibold mb-2" x-text="group"></h3>
                        <div class="space-y-2">
                            <template x-for="unit in groupedUnits[group]" :key="unit.id">
                                <div class="flex justify-between items-center bg-gray-700 rounded-lg px-4 py-2">
                                    <span class="text-white" x-text="unit.name"></span>
                                    <div class="flex items-center gap-3">
                                        <span class="text-sm text-indigo-400" x-text="unit.points + ' pts'"></span>
                                        <button type="button" @click="addUnit(unit)"
                                                class="text-sm bg-indigo-600 hover:bg-indigo-700 text-white px-3 py-1 rounded">
                                            Ajouter
                                        </button>
                                    </div>
                                </div>
                            </template>
                        </div>
                    </div>
                </template>
            </div>

            {# Colonne droite : la liste du joueur #}
            <div>
                <h2 class="text-lg font-semibold text-gray-100 mb-3">
                    Ma liste (<span x-text="totalPoints"></span> pts)
                </h2>

                

                <template x-if="addedUnits.length === 0">
                    <p class="text-gray-500 text-sm">Ajoute des unités depuis la colonne de gauche.</p>
                </template>

                <template x-for="group in groupOrder" :key="group">
                    <div class="mb-5" x-show="groupedAddedUnits[group] && groupedAddedUnits[group].length > 0">
                        <h3 class="text-sm uppercase tracking-wide text-indgo-400 font-semibold mb-2" x-text="group"></h3>
                        <div class="space-y-2">
                            <template x-for="unit in groupedAddedUnits[group]" :key="unit.uid">
                                <div class="bg-gray-900 border border-gray-700 rounded-lg px-4 py-2">
                                    <div class="flex justify-between items-center">
                                        <div class="flex items-center gap-2">
                                            <button type="button" @click="unit.showDetails = !unit.showDetails"
                                                    class="text-gray-500 hover:text-indigo-400 text-xs">
                                                <span x-text="unit.showDetails ? '▼' : '▶'"></span>
                                            </button>
                                            <span class="text-gray-100" x-text="unit.name"></span>
                                        </div>
                                        <div class="flex items-center gap-3">
                                            <input type="number" min="1" x-model.number="unit.quantity"
                                                @input="unit.quantity = unit.quantity < 1 ? 1 : unit.quantity"
                                                class="w-14 bg-gray-800 border border-gray-700 rounded text-center text-gray-100 text-sm py-1">
                                            <span class="text-sm text-indigo-400" x-text="(unit.points * unit.quantity) + ' pts'"></span>
                                            <button type="button" @click="removeUnit(unit.uid)"
                                                    class="text-gray-500 hover:text-indigo-400 text-sm">
                                                ✕
                                            </button>
                                        </div>
                                    </div>

                                    {# --- Fiche stats/armes/capacités --- #}
                                    <div x-show="unit.showDetails" x-cloak class="mt-3 pt-3 border-t border-gray-800 text-xs">

                                        <template x-if="unit.statsData && unit.statsData.keywords && unit.statsData.keywords.length">
                                            <p class="text-gray-500 mb-3">
                                                <span class="uppercase text-[10px]">Mots-clés :</span>
                                                <span x-text="unit.statsData.keywords.join(', ')"></span>
                                            </p>
                                        </template>

                                        {# --- STATS empilées --- #}
                                        <template x-for="model in (unit.statsData?.models || [])" :key="model.name">
                                            <div class="mb-2">
                                                <p class="text-gray-100 font-semibold mb-1" x-text="model.name"></p>
                                                <table class="w-full text-center max-w-md">
                                                    <thead>
                                                        <tr class="text-gray-500 text-[10px] uppercase">
                                                            <th>M</th><th>E</th><th>Sv</th><th>PV</th><th>Cd</th><th>Co</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <tr class="text-gray-100 font-semibold">
                                                            <td x-text="model.stats.M"></td>
                                                            <td x-text="model.stats.T"></td>
                                                            <td x-text="model.stats.Sv"></td>
                                                            <td x-text="model.stats.W"></td>
                                                            <td x-text="model.stats.LD"></td>
                                                            <td x-text="model.stats.OC"></td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                            </div>
                                        </template>

                                        <hr class="border-gray-800 my-3">

                                        {# --- ARMES : par modèle si plusieurs, puis rôles en continuité --- #}
                                        <p class="text-gray-500 uppercase text-[10px] mb-2">Armes</p>

                                        <template x-for="model in (unit.statsData?.models || [])" :key="'w-' + model.name">
                                            <div>
                                                <template x-if="unit.statsData.models.length > 1">
                                                    <p class="text-gray-400 font-semibold mb-1" x-text="model.name"></p>
                                                </template>
                                                <template x-if="model.weapons && model.weapons.length">
                                                    <table class="w-full text-left mb-3">
                                                        <thead>
                                                            <tr class="text-gray-500 text-[10px] uppercase">
                                                                <th class="pr-2 py-1">Arme</th>
                                                                <th class="pr-2">Portée</th>
                                                                <th class="pr-2">A</th>
                                                                <th class="pr-2">C/T</th>
                                                                <th class="pr-2">F</th>
                                                                <th class="pr-2">PA</th>
                                                                <th>D</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            <template x-for="w in model.weapons" :key="w.name">
                                                                <tr class="text-gray-300 border-t border-gray-800">
                                                                    <td class="pr-2 py-1" x-text="w.name"></td>
                                                                    <td class="pr-2" x-text="w.Range"></td>
                                                                    <td class="pr-2" x-text="w.A"></td>
                                                                    <td class="pr-2" x-text="w.BS || w.WS"></td>
                                                                    <td class="pr-2" x-text="w.S"></td>
                                                                    <td class="pr-2" x-text="w.AP"></td>
                                                                    <td x-text="w.D"></td>
                                                                </tr>
                                                            </template>
                                                        </tbody>
                                                    </table>
                                                </template>
                                            </div>
                                        </template>

                                        <template x-for="role in (unit.statsData?.roles || [])" :key="'rw-' + role.name">
                                            <div>
                                                <p class="text-indigo-400 font-semibold text-[11px] uppercase mb-1" x-text="role.name"></p>
                                                <template x-if="role.weapons && role.weapons.length">
                                                    <table class="w-full text-left mb-3">
                                                        <thead>
                                                            <tr class="text-gray-500 text-[10px] uppercase">
                                                                <th class="pr-2 py-1">Arme</th>
                                                                <th class="pr-2">Portée</th>
                                                                <th class="pr-2">A</th>
                                                                <th class="pr-2">C/T</th>
                                                                <th class="pr-2">F</th>
                                                                <th class="pr-2">PA</th>
                                                                <th>D</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            <template x-for="w in role.weapons" :key="w.name">
                                                                <tr class="text-gray-300 border-t border-gray-800">
                                                                    <td class="pr-2 py-1" x-text="w.name"></td>
                                                                    <td class="pr-2" x-text="w.Range"></td>
                                                                    <td class="pr-2" x-text="w.A"></td>
                                                                    <td class="pr-2" x-text="w.BS || w.WS"></td>
                                                                    <td class="pr-2" x-text="w.S"></td>
                                                                    <td class="pr-2" x-text="w.AP"></td>
                                                                    <td x-text="w.D"></td>
                                                                </tr>
                                                            </template>
                                                        </tbody>
                                                    </table>
                                                </template>
                                            </div>
                                        </template>

                                        <hr class="border-gray-800 my-3">

                                        {# --- CAPACITÉS : par défaut, puis rôles en continuité --- #}
                                        <template x-if="(unit.statsData?.abilities?.length) || (unit.statsData?.roles?.length)">
                                            <div>
                                                <p class="text-gray-500 uppercase text-[10px] mb-2">Capacités</p>

                                                <template x-for="a in (unit.statsData?.abilities || [])" :key="a.name">
                                                    <p class="text-gray-300 mb-1">
                                                        <span class="text-gray-100 font-semibold" x-text="a.name"></span> —
                                                        <span x-text="a.description"></span>
                                                    </p>
                                                </template>

                                                <template x-for="role in (unit.statsData?.roles || [])" :key="'ra-' + role.name">
                                                    <div>
                                                        <template x-if="role.abilities && role.abilities.length">
                                                            <div>
                                                                <p class="text-indigo-400 font-semibold text-[11px] uppercase mt-2 mb-1" x-text="role.name"></p>
                                                                <template x-for="a in role.abilities" :key="a.name">
                                                                    <p class="text-gray-300 mb-1">
                                                                        <span class="text-gray-100 font-semibold" x-text="a.name"></span> —
                                                                        <span x-text="a.description"></span>
                                                                    </p>
                                                                </template>
                                                            </div>
                                                        </template>
                                                    </div>
                                                </template>
                                            </div>
                                        </template>

                                    </div>
                                </div>
                            </template>
                        </div>
                    </div>
                </template>
            </div>
        </div>

        <input type="hidden" name="units_json" :value="unitsPayload">

        <div class="flex gap-3 mt-8">
            <button type="submit" class="bg-indigo-600 hover:bg-indigo-700 px-6 py-2 rounded-lg transition">
                💾 Sauvegarder
            </button>
            <a href="{{ path('app_army_show', {id: armyList.id}) }}"
               class="bg-gray-700 hover:bg-gray-600 px-6 py-2 rounded-lg transition">
                Annuler
            </a>
        </div>
    </form>
</div>

<script>
    function armyEditForm(initialUnits) {
    return {
        selectedFaction: {{ armyList.faction|json_encode|raw }},
        selectedDetachment: {{ armyList.detachment ? armyList.detachment|json_encode|raw : "''" }},
        availableUnits: [],
        availableDetachments: [],
        addedUnits: (initialUnits || []).map(u => ({ ...u, uid: crypto.randomUUID(), showDetails: false })),
        loadingUnits: false,
        groupOrder: ['Héros', 'Personnage', 'Véhicule', 'Transport', 'Infanterie', 'Montés', 'Autre'],

        categoryGroup(category) {
            const map = {
                'Epic Hero': 'Héros',
                'Character': 'Personnage',
                'Vehicle': 'Véhicule',
                'Dedicated Transport': 'Transport',
                'Infantry': 'Infanterie',
                'Mounted': 'Montés',
            };
            return map[category] || 'Autre';
        },

        get groupedUnits() {
            const groups = {};
            for (const unit of this.availableUnits) {
                const g = this.categoryGroup(unit.category);
                if (!groups[g]) groups[g] = [];
                groups[g].push(unit);
            }
            return groups;
        },

        get groupedAddedUnits() {
            const groups = {};
            for (const unit of this.addedUnits) {
                const g = this.categoryGroup(unit.category);
                if (!groups[g]) groups[g] = [];
                groups[g].push(unit);
            }
            return groups;
        },

        get totalPoints() {
            return this.addedUnits.reduce((sum, u) => sum + (u.points * u.quantity), 0);
        },

        get unitsPayload() {
            return JSON.stringify(this.addedUnits.map(u => ({
                name: u.name,
                points: u.points,
                quantity: u.quantity,
                category: u.category,
                statsData: u.statsData,
            })));
        },

        async init() {
            this.loadingUnits = true;
            try {
                const [unitsRes, detsRes] = await Promise.all([
                    fetch('/army/units/' + encodeURIComponent(this.selectedFaction)),
                    fetch('/army/detachments/' + encodeURIComponent(this.selectedFaction)),
                ]);
                this.availableUnits = await unitsRes.json();
                this.availableDetachments = await detsRes.json();

                // On rattache les stats actuelles à chaque unité déjà présente dans la liste
                for (const added of this.addedUnits) {
                    const match = this.availableUnits.find(u => u.name === added.name);
                    if (match) {
                        added.statsData = match.statsData;
                    }
                }
            } catch (e) {
                console.error('Erreur de chargement', e);
            } finally {
                this.loadingUnits = false;
            }
        },

        addUnit(unit) {
            this.addedUnits.push({
                uid: crypto.randomUUID(),
                name: unit.name,
                points: unit.points,
                quantity: 1,
                category: unit.category,
                statsData: unit.statsData,
                showDetails: false,
            });
        },

        removeUnit(uid) {
            this.addedUnits = this.addedUnits.filter(u => u.uid !== uid);
        },
    };
}
</script>
{% endblock %}