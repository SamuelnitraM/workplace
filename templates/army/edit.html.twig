{% extends 'base.html.twig' %}
{% import '_macros/ui.html.twig' as ui %}

{% block title %}Modifier — {{ armyList.name }}{% endblock %}

{% block body %}
<div class="max-w-6xl mx-auto">
    <header class="page-header">
        <div class="min-w-0">
            <p class="page-header-eyebrow"><a href="{{ path('app_army_show', {id: armyList.id}) }}" class="link">{{ armyList.name }}</a>{{ ui.icon('chevron-right', 'size-4') }}Modifier</p>
            <h1 class="page-header-title">Modifier la liste</h1>
        </div>
    </header>

    <div {{ stimulus_controller('army-form', {
            unitsUrl: path('app_army_units_by_faction', {faction: '__FACTION__'}),
            detachmentsUrl: path('app_army_detachments_by_faction', {faction: '__FACTION__'}),
            groups: unitGroups,
            faction: armyList.faction,
            detachment: armyList.detachment ?? '',
            initialUnits: initialUnits,
        }) }}>
        {# Formulaire rendu par le composant Alpine « armyForm » (assets/controllers/army_form_controller.js) #}
        <template data-army-form-target="template">
            {{- include('army/_form.html.twig', {
                army_list: armyList,
                action: path('app_army_edit', {id: armyList.id}),
                submit_label: 'Enregistrer',
                unit_groups: unitGroups,
                cancel_url: path('app_army_show', {id: armyList.id}),
            }) -}}
        </template>
        <noscript><div class="alert alert-warning"><p>JavaScript est nécessaire pour modifier une liste d'armée.</p></div></noscript>
    </div>
</div>
{% endblock %}
