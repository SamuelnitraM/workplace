{#
    Army list builder (creation and edition), rendered in the <template> of the "army-form" controller and driven by
    the Alpine component "armyForm" (assets/controllers/army_form_controller.js).
    Parameters: army_list (App\Entity\ArmyList, null on creation), action, submit_label, cancel_url,
    unit_groups (App\Army\UnitCategory::all(): icons of the group headers),
    faction_groups (creation: App\Service\BsDataFetcher::factionGroups(), faction menu),
    battle_sizes (App\Army\BattleSize::cases()).
    Posted fields: _token, name, faction (creation), detachment, battleSize, isPublic, description, units_json.
#}
{% import '_macros/ui.html.twig' as ui %}
{% set is_edit = army_list is not null %}

{# Icon of the Alpine group `group` (x-for over `groups`): design system icons pre-rendered, one visible #}
{% macro group_icon(unit_groups) %}
    {%- import '_macros/ui.html.twig' as ui -%}
    <span class="unit-group-icon" aria-hidden="true">
        {%- for g in unit_groups -%}
            <template x-if="group.key === '{{ g.key|e('js') }}'">{{ ui.icon(g.icon) }}</template>
        {%- endfor -%}
    </span>
{% endmacro %}

<div x-data="armyForm">
    <form method="post" action="{{ action }}" class="army-form">
        <input type="hidden" name="_token" value="{{ csrf_token('army_list') }}">

        {# --- General information --- #}
        <section class="card mb-6" aria-labelledby="army-info-title">
            <div class="card-header">
                <h2 id="army-info-title" class="text-h3 text-fg">Informations</h2>
            </div>
            <div class="card-body grid grid-cols-1 gap-4 md:grid-cols-2">
                <div class="field">
                    <label for="army-name" class="label">Nom de la liste</label>
                    <input type="text" id="army-name" name="name" required maxlength="255" class="input" placeholder="Ex. : Croisade de la 3e Compagnie" value="{{ is_edit ? army_list.name : '' }}">
                </div>

                <div class="field">
                    {% if is_edit %}
                        <span class="label" id="army-faction-label">Faction</span>
                        <p class="input flex items-center gap-2 bg-canvas text-fg-secondary" aria-labelledby="army-faction-label">
                            {{ ui.icon('lock', 'size-4 text-muted') }}{{ army_list.faction }}
                            <span class="ml-auto text-caption text-muted">non modifiable</span>
                        </p>
                    {% else %}
                        <label for="army-faction" class="label">Faction</label>
                        <select id="army-faction" name="faction" x-model="selectedFaction" @change="onFactionChange" required class="select">
                            <option value="">Choisir une faction…</option>
                            {% for group in faction_groups|default([]) %}
                                <optgroup label="{{ group.label }}">
                                    {% for faction in group.factions %}
                                        <option{% if faction.featured %} class="text-success-text"{% endif %} value="{{ faction.value }}">{{ faction.value }}</option>
                                    {% endfor %}
                                </optgroup>
                            {% endfor %}
                        </select>
                        <p class="help">Changer de faction vide la liste d'unités.</p>
                    {% endif %}
                </div>

                <div class="field">
                    <label for="army-detachment" class="label">Détachement</label>
                    <select id="army-detachment" name="detachment" x-model="selectedDetachment" @change="onDetachmentChange" class="select">
                        <option value="">Aucun / à définir</option>
                        <template x-for="det in availableDetachments" :key="det.id">
                            <option :value="det.nameEn" x-text="det.name" :selected="det.nameEn === selectedDetachment"></option>
                        </template>
                    </select>
                    {% if not is_edit %}<p class="help" x-show="!selectedFaction">Choisissez d'abord une faction.</p>{% endif %}
                    <p class="help" x-show="selectedDetachment" x-text="detachmentEnhancements.length ? detachmentEnhancements.length + ' amélioration(s) disponible(s) pour vos personnages.' : 'Aucune amélioration connue pour ce détachement.'"></p>
                </div>

                <div class="field content-end">
                    <label class="check">
                        <input type="checkbox" name="isPublic" value="1" class="checkbox" {{ is_edit and army_list.isPublic ? 'checked' : '' }}>
                        <span>Liste publique <span class="block text-caption text-muted">Visible sur ton profil et dans l'Explorer.</span></span>
                    </label>
                </div>

                {# List type: free, or official with a battle size #}
                <fieldset class="field md:col-span-2">
                    <legend class="label">Type de liste</legend>
                    <div class="grid grid-cols-1 gap-2 sm:grid-cols-2 lg:grid-cols-4">
                        <label class="choice-card items-start">
                            <input type="radio" name="battleSize" value="" class="sr-only" :checked="battleSize === ''" @change="onBattleSizeChange">
                            <span class="mt-0.5 text-primary-text">{{ ui.icon('paintbrush') }}</span>
                            <span><span class="block font-semibold text-fg">Libre</span><span class="block text-caption font-normal text-muted">Aucune règle vérifiée : collection, projet, narratif.</span></span>
                        </label>
                        {% for size in battle_sizes %}
                            <label class="choice-card items-start">
                                <input type="radio" name="battleSize" value="{{ size.value }}" class="sr-only" :checked="battleSize === '{{ size.value }}'" @change="onBattleSizeChange">
                                <span class="mt-0.5 text-accent-text">{{ ui.icon('trophy') }}</span>
                                <span><span class="block font-semibold text-fg">{{ size.label }}</span><span class="block text-caption font-normal text-muted">Officielle, {{ size.pointsLimit }} pts maximum.</span></span>
                            </label>
                        {% endfor %}
                    </div>
                    <p class="help">Liste officielle : 3 exemplaires par fiche au plus (6 pour les troupes de ligne et les transports assignés), un seul personnage épique de chaque, un Seigneur de guerre, les améliorations du détachement.</p>
                </fieldset>

                <div class="field md:col-span-2">
                    <label for="army-description" class="label">Description / Lore <span class="label-hint">(facultatif)</span></label>
                    <textarea id="army-description" name="description" rows="3" class="textarea"
                              placeholder="Contexte, thème de l'armée, stratégie envisagée…">{{ is_edit ? army_list.description : '' }}</textarea>
                </div>
            </div>
        </section>

        {# --- Catalogue (left) / My list (right) --- #}
        <div class="army-builder" {% if not is_edit %}x-show="selectedFaction" x-cloak{% endif %}>

            {# Catalogue: available units grouped by type, with a filter #}
            <section class="card" aria-labelledby="army-catalogue-title"
                     x-data="{ q: '', match(u) { const s = this.q.trim().toLowerCase(); return !s || u.name.toLowerCase().includes(s); } }">
                <div class="card-header flex-wrap">
                    <h2 id="army-catalogue-title" class="text-h3 text-fg">Catalogue d'unités</h2>
                    <span class="chip tabular-nums" x-text="availableUnits.length + ' unités'"></span>
                </div>
                <div class="card-body">
                    <div class="relative mb-4">
                        {{ ui.icon('search', 'pointer-events-none absolute left-3 top-1/2 size-4 -translate-y-1/2 text-muted') }}
                        <label for="army-unit-search" class="sr-only">Filtrer les unités</label>
                        <input type="search" id="army-unit-search" x-model="q" class="input pl-9" placeholder="Filtrer les unités…" autocomplete="off" @keydown.enter.prevent>
                    </div>

                    <template x-if="loadingUnits">
                        <div class="space-y-2" aria-live="polite">
                            <span class="sr-only">Chargement des unités…</span>
                            <div class="skeleton h-12 rounded-control"></div>
                            <div class="skeleton h-12 rounded-control"></div>
                            <div class="skeleton h-12 rounded-control"></div>
                        </div>
                    </template>

                    <template x-if="!loadingUnits && availableUnits.length === 0">
                        <p class="text-small text-muted">Aucune unité trouvée pour cette faction (données pas encore synchronisées).</p>
                    </template>

                    <template x-for="group in groups" :key="group.key">
                        <div class="mb-5 last:mb-0" x-show="groupedUnits[group.key] && groupedUnits[group.key].some(u => match(u))">
                            <h3 class="eyebrow mb-2 flex items-center gap-2">
                                {{ _self.group_icon(unit_groups|default([])) }}
                                <span x-text="group.plural"></span>
                            </h3>
                            <ul class="space-y-1.5">
                                <template x-for="unit in groupedUnits[group.key]" :key="unit.id">
                                    <li class="unit-option" x-show="match(unit)">
                                        <button type="button" class="unit-option-name" @click="openDatasheet(unit, true)" :aria-label="'Fiche de ' + unit.name" x-text="unit.name"></button>
                                        <template x-if="unit.statsData && unit.statsData.legends"><span class="chip chip-warning shrink-0">Legends</span></template>
                                        <span class="shrink-0 text-small font-semibold text-accent-text tabular-nums" x-text="unit.points + ' pts'"></span>
                                        <button type="button" @click="addUnit(unit)" class="btn btn-secondary btn-sm shrink-0" :aria-label="'Ajouter ' + unit.name">
                                            {{ ui.icon('plus') }}<span class="hidden sm:inline">Ajouter</span>
                                        </button>
                                    </li>
                                </template>
                            </ul>
                        </div>
                    </template>
                    <p class="text-small text-muted" x-show="q && !loadingUnits && availableUnits.length > 0 && !availableUnits.some(u => match(u))">Aucune unité ne correspond à « <span x-text="q"></span> ».</p>
                </div>
            </section>

            {# My list #}
            <section class="card army-list-panel" aria-labelledby="army-list-title">
                <div class="card-header flex-wrap">
                    <h2 id="army-list-title" class="text-h3 text-fg">Ma liste</h2>
                    <span class="text-h3 font-bold tabular-nums" :class="pointsLimit && totalPoints > pointsLimit ? 'text-danger-text' : 'text-accent-text'" aria-live="polite">
                        <span x-text="totalPoints"></span><span x-show="pointsLimit" x-text="' / ' + pointsLimit"></span> pts
                    </span>
                    <div class="points-gauge w-full" x-show="pointsLimit" x-cloak aria-hidden="true"><span :style="'width: ' + pointsRatio + '%'"></span></div>
                </div>
                <div class="card-body army-list-body">
                    <p class="alert alert-warning mb-4" x-show="missingWarlord" x-cloak>{{ ui.icon('crown') }}<span>Désigne un Seigneur de guerre parmi tes personnages.</span></p>

                    <template x-if="addedUnits.length === 0">
                        <div class="empty-state empty-state-compact">
                            <div class="empty-state-icon" aria-hidden="true">{{ ui.icon('swords') }}</div>
                            <p class="empty-state-title">Liste vide</p>
                            <p class="empty-state-text">Ajoute des unités depuis le catalogue.</p>
                        </div>
                    </template>

                    <template x-for="group in groups" :key="group.key">
                        <section class="mb-5 last:mb-0" x-show="groupedAddedUnits[group.key] && groupedAddedUnits[group.key].length > 0"
                                 :aria-labelledby="'army-list-group-' + group.key">
                            <div class="unit-group-head mb-2 border-b border-line pb-1">
                                {{ _self.group_icon(unit_groups|default([])) }}
                                <h3 class="unit-group-title" :id="'army-list-group-' + group.key" x-text="group.plural"></h3>
                                <span class="unit-group-count" x-text="groupCount(group.key) + (groupCount(group.key) > 1 ? ' unités' : ' unité')"></span>
                                <span class="unit-group-points"><span class="sr-only">Sous-total : </span><span x-text="groupPoints(group.key)"></span> pts</span>
                            </div>
                            <ul class="space-y-2">
                                <template x-for="unit in groupedAddedUnits[group.key]" :key="unit.uid">
                                    <li class="card-inset army-entry">
                                        <div class="flex items-start gap-2">
                                            <button type="button" class="army-entry-name" @click="openDatasheet(unit)" :aria-label="'Fiche de ' + unit.name">
                                                <span x-text="unit.name"></span>
                                            </button>
                                            <span class="ml-auto shrink-0 text-small font-semibold text-accent-text tabular-nums" x-text="unitCost(unit) + ' pts'"></span>
                                            <button type="button" @click="removeUnit(unit.uid)" class="btn btn-ghost btn-icon btn-sm -my-1 shrink-0 hover:text-danger-text" :aria-label="'Retirer ' + unit.name">
                                                {{ ui.icon('x') }}
                                            </button>
                                        </div>
                                        <div class="army-entry-controls">
                                            <template x-if="sizesOf(unit).length > 1">
                                                <label class="army-control">
                                                    <span class="sr-only" x-text="'Taille de ' + unit.name"></span>
                                                    <select class="select select-sm" @change="setSize(unit, $event)">
                                                        <template x-for="size in sizesOf(unit)" :key="size.models">
                                                            <option :value="size.models" :selected="size.models === (unit.modelCount ?? sizesOf(unit)[0].models)" x-text="size.models + ' fig. · ' + size.points + ' pts'"></option>
                                                        </template>
                                                    </select>
                                                </label>
                                            </template>
                                            <template x-if="!isOfficial">
                                                <label class="army-control">
                                                    <span class="text-caption text-muted">Qté</span>
                                                    <input type="number" min="1" max="99" :value="unit.quantity" @change="setQuantity(unit, $event)" :aria-label="'Quantité : ' + unit.name" class="input army-qty">
                                                </label>
                                            </template>
                                            <template x-if="canBeWarlord(unit)">
                                                <button type="button" class="btn btn-sm btn-toggle" :aria-pressed="unit.warlord ? 'true' : 'false'" @click="toggleWarlord(unit)">
                                                    {{ ui.icon('crown') }}<span x-text="unit.warlord ? 'Seigneur de guerre' : 'Nommer Seigneur de guerre'"></span>
                                                </button>
                                            </template>
                                            <template x-if="canTakeEnhancement(unit) && (detachmentEnhancements.length || unit.enhancement)">
                                                <label class="army-control min-w-0 flex-1">
                                                    <span class="sr-only" x-text="'Amélioration de ' + unit.name"></span>
                                                    <select class="select select-sm w-full" @change="setEnhancement(unit, $event)">
                                                        <option value="">Sans amélioration</option>
                                                        <template x-for="enhancement in detachmentEnhancements" :key="enhancement.name">
                                                            <option :value="enhancement.name" :selected="enhancement.name === unit.enhancement" x-text="enhancement.name + ' (+' + enhancement.points + ' pts)'"></option>
                                                        </template>
                                                    </select>
                                                </label>
                                            </template>
                                        </div>
                                    </li>
                                </template>
                            </ul>
                        </section>
                    </template>
                </div>
            </section>
        </div>

        <input type="hidden" name="units_json" :value="unitsPayload">

        {# Sticky action bar: total always visible #}
        <div class="army-form-bar">
            <p class="min-w-0 text-small text-fg-secondary">
                <span class="block text-caption text-muted">Total</span>
                <strong class="text-h3 text-accent-text tabular-nums"><span x-text="totalPoints"></span><span x-show="pointsLimit" x-text="' / ' + pointsLimit"></span> pts</strong>
                <span class="hidden text-muted sm:inline"> · <span x-text="addedUnits.length"></span> entrée(s)</span>
            </p>
            <div class="flex shrink-0 items-center gap-2">
                <a href="{{ cancel_url }}" class="btn btn-ghost">Annuler</a>
                <button type="submit" class="btn btn-primary">{{ ui.icon(is_edit ? 'check' : 'plus') }}{{ submit_label }}</button>
            </div>
        </div>
    </form>

    {# Rule popup (official list) #}
    <dialog x-ref="ruleDialog" class="modal" aria-labelledby="army-rule-title" @click="$event.target === $el && $el.close()">
        <div class="modal-header">
            <span class="text-warning-text">{{ ui.icon('alert-triangle') }}</span>
            <p class="modal-title" id="army-rule-title" x-text="ruleAlert.title"></p>
        </div>
        <div class="modal-body">
            <ul class="space-y-2 text-fg-secondary">
                <template x-for="message in ruleAlert.messages" :key="message">
                    <li class="flex gap-2">{{ ui.icon('x-circle', 'size-4 mt-1 shrink-0 text-danger-text') }}<span x-text="message"></span></li>
                </template>
            </ul>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-primary" @click="$refs.ruleDialog.close()" autofocus>Compris</button>
        </div>
    </dialog>

    {# Datasheet window #}
    <dialog x-ref="datasheetDialog" class="modal modal-wide" aria-labelledby="army-datasheet-title" @click="$event.target === $el && $el.close()">
        <div class="modal-header">
            <p class="modal-title" id="army-datasheet-title" x-text="'Fiche : ' + datasheet.title"></p>
            <button type="button" class="btn btn-ghost btn-icon btn-sm" @click="$refs.datasheetDialog.close()" aria-label="Fermer">{{ ui.icon('x') }}</button>
        </div>
        <div class="modal-body">
            <div x-show="datasheet.loading" class="space-y-2" aria-live="polite">
                <span class="sr-only">Chargement de la fiche…</span>
                <div class="skeleton h-10 rounded-control"></div>
                <div class="skeleton h-32 rounded-control"></div>
            </div>
            <div x-show="!datasheet.loading" x-html="datasheet.html"></div>
        </div>
    </dialog>
</div>
