{% extends 'base.html.twig' %}
{% import '_macros/ui.html.twig' as ui %}

{% block title %}Mes listes d'armées{% endblock %}

{% block body %}
<div class="mx-auto max-w-7xl">

    <header class="page-header">
        <div>
            <h1 class="page-header-title">Mes listes d'armée</h1>
            <p class="page-header-subtitle">Compose tes listes, suis tes points et partage les publiques sur ton profil.</p>
        </div>
        <div class="page-header-actions">
            <a href="{{ path('app_army_explorer') }}" class="btn btn-ghost" data-tour="army-explorer">{{ ui.icon('compass') }}Explorer</a>
            <a href="{{ path('app_army_import') }}" class="btn btn-secondary" data-tour="army-import">{{ ui.icon('upload') }}Importer</a>
            {% if lists is not empty %}
                <a href="{{ path('app_army_new') }}" class="btn btn-primary" data-tour="army-new">{{ ui.icon('plus') }}Nouvelle liste</a>
            {% endif %}
        </div>
    </header>

    <div class="grid items-start gap-6 xl:grid-cols-[minmax(0,1fr)_19rem]">
        <div class="min-w-0">
            {% if lists is empty %}
                {{ include('_partials/_empty_state.html.twig', {
                    icon: 'swords',
                    title: 'Aucune liste d\'armée pour le moment',
                    text: 'Choisis une faction et un détachement, ajoute tes unités : le total de points se calcule tout seul. Rends la liste publique pour l\'afficher sur ton profil.',
                    cta: {label: 'Créer ma première liste', url: path('app_army_new'), icon: 'plus'},
                }) }}
            {% else %}
                <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
                    {% for list in lists %}
                        <li class="flex">{{ include('army/_card.html.twig', {list: list}) }}</li>
                    {% endfor %}
                </ul>
            {% endif %}
        </div>
        {{ include('army/_popular_sidebar.html.twig', {mostDuplicated: mostDuplicated, mostExported: mostExported}, with_context = false) }}
    </div>
</div>
{% endblock %}
