{% extends 'base.html.twig' %}
{% import '_macros/ui.html.twig' as ui %}

{% block title %}Mes listes d'armées{% endblock %}

{% block body %}
<div class="max-w-5xl mx-auto">

    <header class="page-header">
        <div>
            <h1 class="page-header-title">Mes listes d'armée</h1>
            <p class="page-header-subtitle">Composez vos listes, suivez vos points et partagez les publiques sur votre profil.</p>
        </div>
        {% if lists is not empty %}
            <div class="page-header-actions">
                <a href="{{ path('app_army_new') }}" class="btn btn-primary">{{ ui.icon('plus') }}Nouvelle liste</a>
            </div>
        {% endif %}
    </header>

    {% if lists is empty %}
        {{ include('_partials/_empty_state.html.twig', {
            icon: 'swords',
            title: 'Aucune liste d\'armée pour le moment',
            text: 'Choisissez une faction et un détachement, ajoutez vos unités : le total de points se calcule tout seul. Rendez la liste publique pour l\'afficher sur votre profil.',
            cta: {label: 'Créer ma première liste', url: path('app_army_new'), icon: 'plus'},
        }) }}
    {% else %}
        <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {% for list in lists %}
                <li class="flex">{{ include('army/_card.html.twig', {list: list}) }}</li>
            {% endfor %}
        </ul>
    {% endif %}

</div>
{% endblock %}
