{% extends 'base.html.twig' %}

{% block title %}Nouvelle liste d'armée{% endblock %}

{% block body %}
<div class="max-w-2xl mx-auto">

    <div class="mb-6">
        <a href="{{ path('app_army_index') }}"
           class="text-gray-400 hover:text-white text-sm transition">
            ← Retour à mes listes
        </a>
        <h1 class="text-2xl font-bold text-white mt-1">✚ Nouvelle liste d'armée</h1>
    </div>

    <div class="bg-gray-800 rounded-xl border border-gray-700 p-8">
        <form method="post">

            <div class="space-y-5">

                <div>
                    <label class="block text-sm text-gray-400 mb-1">Nom de la liste</label>
                    <input type="text" name="name" required
                           placeholder="Ex: Space Marines 2000pts"
                           class="w-full bg-gray-700 border border-gray-600 rounded-lg px-4 py-2 text-white focus:outline-none focus:border-indigo-500">
                </div>

                <div>
                    <label class="block text-sm text-gray-400 mb-1">Faction</label>
                    <select name="faction" required
                            class="w-full bg-gray-700 border border-gray-600 rounded-lg px-4 py-2 text-white focus:outline-none focus:border-indigo-500">
                        <option value="">-- Choisir une faction --</option>
                        <optgroup label="Imperium">
                            <option value="Space Marines">Space Marines</option>
                            <option value="Blood Angels">Blood Angels</option>
                            <option value="Dark Angels">Dark Angels</option>
                            <option value="Space Wolves">Space Wolves</option>
                            <option value="Grey Knights">Grey Knights</option>
                            <option value="Deathwatch">Deathwatch</option>
                            <option value="Adeptus Custodes">Adeptus Custodes</option>
                            <option value="Sisters of Battle">Sisters of Battle</option>
                            <option value="Astra Militarum">Astra Militarum</option>
                            <option value="Adeptus Mechanicus">Adeptus Mechanicus</option>
                            <option value="Imperial Knights">Imperial Knights</option>
                        </optgroup>
                        <optgroup label="Chaos">
                            <option value="Chaos Space Marines">Chaos Space Marines</option>
                            <option value="Death Guard">Death Guard</option>
                            <option value="Thousand Sons">Thousand Sons</option>
                            <option value="World Eaters">World Eaters</option>
                            <option value="Emperor's Children">Emperor's Children</option>
                            <option value="Chaos Knights">Chaos Knights</option>
                            <option value="Daemons">Daemons of Chaos</option>
                        </optgroup>
                        <optgroup label="Xenos">
                            <option value="Orks">Orks</option>
                            <option value="Eldar">Aeldari</option>
                            <option value="Dark Eldar">Drukhari</option>
                            <option value="Tyranids">Tyranids</option>
                            <option value="Genestealer Cults">Genestealer Cults</option>
                            <option value="Tau">T'au Empire</option>
                            <option value="Necrons">Necrons</option>
                            <option value="Leagues of Votann">Leagues of Votann</option>
                        </optgroup>
                    </select>
                </div>

                <div>
                    <label class="block text-sm text-gray-400 mb-1">
                        Détachement <span class="text-gray-600">(optionnel)</span>
                    </label>
                    <input type="text" name="detachment"
                           placeholder="Ex: Gladius Task Force"
                           class="w-full bg-gray-700 border border-gray-600 rounded-lg px-4 py-2 text-white focus:outline-none focus:border-indigo-500">
                </div>

                <div class="bg-gray-700 rounded-lg p-4">
                    <label class="flex items-center gap-3 cursor-pointer">
                        <input type="checkbox" name="isPublic" value="1"
                               class="w-5 h-5 accent-indigo-500">
                        <div>
                            <div class="text-white font-semibold">🌍 Liste publique</div>
                            <div class="text-gray-400 text-xs">
                                Visible sur votre profil public
                            </div>
                        </div>
                    </label>
                </div>

            </div>

            <div class="flex gap-3 mt-8">
                <button type="submit"
                        class="bg-indigo-600 hover:bg-indigo-700 px-6 py-2 rounded-lg transition">
                    ✚ Créer la liste
                </button>
                <a href="{{ path('app_army_index') }}"
                   class="bg-gray-700 hover:bg-gray-600 px-6 py-2 rounded-lg transition">
                    Annuler
                </a>
            </div>

        </form>
    </div>

</div>
{% endblock %}