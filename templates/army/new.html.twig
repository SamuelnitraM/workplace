{% extends 'base.html.twig' %}
{% import '_macros/ui.html.twig' as ui %}

{% block title %}Créer une liste d'armée{% endblock %}

{% block body %}
<div class="max-w-6xl mx-auto">
    <header class="page-header">
        <div>
            <p class="page-header-eyebrow"><a href="{{ path('app_army_index') }}" class="link">Mes listes d'armée</a>{{ ui.icon('chevron-right', 'size-4') }}Nouvelle</p>
            <h1 class="page-header-title">Créer une liste d'armée</h1>
            <p class="page-header-subtitle">Choisissez votre faction, puis ajoutez vos unités depuis le catalogue : le total se calcule tout seul.</p>
        </div>
    </header>

    <div {{ stimulus_controller('army-form', {
            unitsUrl: path('app_army_units_by_faction', {faction: '__FACTION__'}),
            detachmentsUrl: path('app_army_detachments_by_faction', {faction: '__FACTION__'}),
            enhancementsUrl: path('app_army_enhancements_by_faction', {faction: '__FACTION__'}),
            datasheetUrl: path('app_army_datasheet'),
            unitDatasheetUrl: path('app_army_unit_datasheet'),
            rules: rulesConfig,
            groups: unitGroups,
        }) }}>
        {# Formulaire rendu par le composant Alpine « armyForm » (assets/controllers/army_form_controller.js) #}
        <template data-army-form-target="template">
            {{- include('army/_form.html.twig', {
                army_list: null,
                action: path('app_army_new'),
                submit_label: 'Créer la liste',
                unit_groups: unitGroups,
                battle_sizes: enum_cases('App\\Army\\BattleSize'),
                faction_groups: factionGroups,
                cancel_url: path('app_army_index'),
            }) -}}
        </template>
        <noscript><div class="alert alert-warning"><p>JavaScript est nécessaire pour composer une liste d'armée.</p></div></noscript>
    </div>
</div>
{% endblock %}
