{% extends 'base.html.twig' %}
{% import '_macros/ui.html.twig' as ui %}

{% block title %}Mes messages{% endblock %}

{% block body %}
<div class="container-reading">

    <header class="page-header">
        <div>
            <h1 class="page-header-title">Messages</h1>
            <p class="page-header-subtitle">Vos conversations privées avec vos amis.</p>
        </div>
        {% if conversations is not empty %}
            <div class="page-header-actions">
                <a href="{{ path('app_friendship_list') }}" class="btn btn-secondary">{{ ui.icon('users') }}Mes amis</a>
            </div>
        {% endif %}
    </header>

    {% if conversations is empty %}
        {{ include('_partials/_empty_state.html.twig', {
            icon: 'mail',
            title: 'Aucune conversation pour le moment',
            text: 'Les messages privés s\'échangent entre amis : ouvrez le profil d\'un ami et cliquez sur « Envoyer un message ».',
            cta: {label: 'Mes amis', url: path('app_friendship_list'), icon: 'users'},
            secondary: {label: 'Trouver des joueurs', url: path('app_leaderboard'), icon: 'trophy'},
        }) }}
    {% else %}
        {# Most recent activity first; rows move to the top live when a message arrives (conversation_list_controller.js) #}
        <ul role="list" class="card overflow-hidden divide-y divide-line" data-controller="conversation-list">
            {% for conversation in conversations %}
                {% set other = conversation.participant1 == app.user ? conversation.participant2 : conversation.participant1 %}
                {% set unread = unreadCounts[conversation.id] ?? 0 %}
                {% set lastMessage = lastMessages[conversation.id] ?? null %}
                <li data-conversation-id="{{ conversation.id }}">
                    <a href="{{ path('app_message_show', {username: other.username}) }}" class="list-row">
                        <span class="relative shrink-0">
                            {{- ui.avatar(other, 'md') -}}
                        </span>
                        <span class="list-row-main">
                            <span class="flex items-baseline justify-between gap-3">
                                <span class="truncate font-semibold text-fg {{ unread > 0 ? 'font-bold' }}" data-conversation-name>{{ other.username }}</span>
                                <time class="shrink-0 text-caption {{ unread > 0 ? 'font-semibold text-primary-text' : 'text-muted' }}" data-conversation-time
                                      {% if conversation.updatedAt %}datetime="{{ conversation.updatedAt|date('c') }}" title="{{ conversation.updatedAt|date('d/m/Y à H:i') }}"{% endif %}>
                                    {{- conversation.updatedAt ? conversation.updatedAt|time_ago -}}
                                </time>
                            </span>
                            <span class="mt-0.5 flex items-center justify-between gap-3">
                                <span class="truncate text-small {{ unread > 0 ? 'text-fg' : 'text-fg-secondary' }}" data-conversation-preview>
                                    {%- if lastMessage -%}
                                        {%- if lastMessage.author == app.user %}<span class="text-muted">Vous : </span>{% endif -%}
                                        {{- lastMessage.content -}}
                                    {%- else -%}
                                        <span class="text-muted">Aucun message</span>
                                    {%- endif -%}
                                </span>
                                <span class="count-badge shrink-0 {{ unread > 0 ? '' : 'hidden' }}" data-conversation-unread data-count="{{ unread }}">
                                    {{- unread > 99 ? '99+' : unread -}}<span class="sr-only"> non lu(s)</span>
                                </span>
                            </span>
                        </span>
                    </a>
                </li>
            {% endfor %}
        </ul>
    {% endif %}

</div>
{% endblock %}
