{% extends 'base.html.twig' %}
{% import '_macros/ui.html.twig' as ui %}

{% block title %}{{ targetUser.username }}{% endblock %}

{% block body %}
{% set _days = ['lundi', 'mardi', 'mercredi', 'jeudi', 'vendredi', 'samedi', 'dimanche'] %}
{% set _months = ['janvier', 'février', 'mars', 'avril', 'mai', 'juin', 'juillet', 'août', 'septembre', 'octobre', 'novembre', 'décembre'] %}
{% set _today = 'now'|date('Y-m-d') %}
{% set _yesterday = '-1 day'|date('Y-m-d') %}
{% set _year = 'now'|date('Y') %}
<div class="container-reading">

    {# EN-TÊTE DE LA CONVERSATION #}
    <header class="mb-4 flex items-center gap-2 sm:gap-3">
        <a href="{{ path('app_message_index') }}" class="btn btn-ghost btn-icon shrink-0" aria-label="Retour aux messages">
            {{- ui.icon('arrow-left') -}}
        </a>
        <a href="{{ path('app_profil_show', {username: targetUser.username}) }}" class="flex min-w-0 items-center gap-3 rounded-control">
            {{- ui.avatar(targetUser, 'md') -}}
            <div class="min-w-0">
                <div class="flex flex-wrap items-center gap-x-2 gap-y-0.5">
                    <h1 class="truncate text-h3 text-fg">{{ targetUser.username }}</h1>
                    {{ include('gamification/_user_title.html.twig', {user: targetUser}) }}
                </div>
                <p class="text-caption text-muted">{{ canSend ? 'Voir le profil' : 'Conversation en lecture seule' }}</p>
            </div>
        </a>
    </header>

    {# ZONE CHAT (assets/controllers/chat_controller.js) #}
    <div class="card chat-panel"
         data-controller="chat"
         data-chat-user-id-value="{{ app.user.id }}"
         data-chat-avatar-base-value="{{ asset('uploads/avatars/') }}"
         data-chat-send-url-value="{{ path('app_message_send', {username: targetUser.username}) }}"
         {% if conversation %}
         data-chat-channel-value="private-conversation-{{ conversation.id }}"
         data-chat-conversation-id-value="{{ conversation.id }}"
         data-chat-read-url-value="{{ path('app_message_ajax_read', {id: conversation.id}) }}"
         {% else %}
         data-chat-reload-after-first-message-value="true"
         {% endif %}>

        {# MESSAGES #}
        <div class="chat-stream" id="chat-messages" role="log" aria-label="Messages avec {{ targetUser.username }}"
             data-chat-target="messages" data-action="scroll->chat#onScroll">
            {% if messages is empty %}
                <div id="chat-empty" data-chat-target="empty" class="my-auto">
                    {{ include('_partials/_empty_state.html.twig', {
                        icon: 'sparkles',
                        title: 'Commencez la conversation avec ' ~ targetUser.username,
                        text: canSend ? 'Un bonjour, une question sur ses figurines, une idée de partie…' : null,
                        cta: canSend ? {label: 'Écrire le premier message', for: 'message-input', icon: 'pencil'} : null,
                        variant: 'plain',
                        compact: true,
                    }) }}
                </div>
            {% else %}
                {% set _prev_day = null %}
                {% for message in messages %}
                    {% set _day = message.createdAt|date('Y-m-d') %}
                    {% if _day != _prev_day %}
                        {% set _label = _day == _today ? 'Aujourd\'hui'
                            : (_day == _yesterday ? 'Hier'
                            : (_days[message.createdAt|date('N') - 1] ~ ' ' ~ message.createdAt|date('j') ~ ' ' ~ _months[message.createdAt|date('n') - 1]
                               ~ (message.createdAt|date('Y') != _year ? ' ' ~ message.createdAt|date('Y') : ''))) %}
                        <div class="chat-day" data-chat-day="{{ _day }}" role="separator" aria-label="{{ _label }}"><span>{{ _label|capitalize }}</span></div>
                        {% set _prev_day = _day %}
                    {% endif %}
                    {% set _own = message.author == app.user %}
                    <div class="chat-msg {{ _own ? 'chat-msg-own' }}" id="msg-{{ message.id }}">
                        {% if not _own %}{{ ui.avatar(message.author, 'sm') }}{% endif %}
                        <div class="chat-msg-body">
                            <div class="chat-meta">
                                {%- if _own %}<span class="sr-only">Vous, </span>{% else %}<span class="sr-only">{{ message.author.username }}, </span>{% endif -%}
                                <time datetime="{{ message.createdAt|date('c') }}" title="{{ message.createdAt|date('d/m/Y à H:i') }}">{{ message.createdAt|date('H:i') }}</time>
                                {%- if not _own %} <a href="{{ path('app_report', {type: 'message', id: message.id}) }}" class="link text-muted" rel="nofollow" aria-label="Signaler ce message" title="Signaler ce message">{{ ui.icon('flag', 'size-3.5') }}</a>{% endif -%}
                            </div>
                            <div class="chat-bubble">{{ message.content|mention_links }}</div>
                        </div>
                    </div>
                {% endfor %}
            {% endif %}
        </div>

        {# BOUTON « DERNIERS MESSAGES » #}
        <div class="relative">
            <button type="button" id="scroll-btn" data-chat-target="scrollButton" data-action="chat#jumpToBottom" aria-label="Aller aux derniers messages"
                    class="hidden btn btn-secondary btn-icon chat-scroll-btn">
                {{- ui.icon('chevron-down') -}}
                <span id="scroll-badge" data-chat-target="scrollBadge"
                      class="hidden absolute -top-0.5 -right-0.5 size-3 rounded-pill bg-notify ring-2 ring-surface"></span>
            </button>
        </div>

        {# SAISIE #}
        {% if canSend %}
            <form id="message-form" data-chat-target="form" data-action="submit->chat#send"
                  action="{{ path('app_message_send', {username: targetUser.username}) }}"
                  method="post"
                  class="chat-composer">
                <input type="hidden" name="_token" value="{{ csrf_token('private_message') }}">
                <label for="message-input" class="sr-only">Votre message à {{ targetUser.username }}</label>
                <div class="flex-1" data-controller="mention-suggest">
                    <input type="text" name="content" id="message-input" data-chat-target="input" data-mention-suggest-target="input"
                           data-action="keydown->mention-suggest#onKeydown input->mention-suggest#onInput blur->mention-suggest#close"
                           placeholder="Écrire un message…"
                           autocomplete="off"
                           enterkeyhint="send"
                           maxlength="2000"
                           required
                           class="input w-full rounded-pill px-4">
                </div>
                <div data-controller="emoji-picker" data-emoji-picker-input-value="message-input"></div>
                <button type="submit" class="btn btn-primary btn-icon shrink-0 rounded-pill" aria-label="Envoyer le message">
                    {{- ui.icon('send') -}}
                </button>
            </form>
        {% else %}
            <div class="chat-composer justify-center text-center text-small text-fg-secondary" role="status">
                {{ ui.icon('lock', 'size-4 shrink-0 text-muted') }}
                <p>Vous n'êtes plus amis avec {{ targetUser.username }} : la conversation est en lecture seule.</p>
            </div>
        {% endif %}

    </div>
</div>

{% endblock %}
