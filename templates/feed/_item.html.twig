{#
    Élément du fil d'actualité (App\Feed\FeedItem).
    Paramètre : item. Types : photo, thread, army, badges.
#}
{% import '_macros/ui.html.twig' as ui %}
{% set actor = item.actor %}
{% set actions = {
    photo: 'a partagé une photo',
    thread: 'a lancé une discussion',
    army: 'a publié une liste d\'armée',
    badges: item.type == 'badges' and item.subject|length > 1 ? 'a obtenu ' ~ item.subject|length ~ ' badges' : 'a obtenu un badge',
} %}
<article class="card feed-item" aria-labelledby="feed-{{ item.key }}-title">
    <header class="flex items-start gap-3 px-4 pt-4 sm:px-5">
        <a href="{{ path('app_profil_show', {username: actor.username}) }}" class="shrink-0 rounded-pill" tabindex="-1" aria-hidden="true">{{ ui.avatar(actor, 'md') }}</a>
        <p class="min-w-0 flex-1 text-small text-fg-secondary">
            <a href="{{ path('app_profil_show', {username: actor.username}) }}" class="font-semibold text-fg hover:text-primary-text">{{ actor.username }}</a>
            {{ include('gamification/_user_title.html.twig', {user: actor}) }}
            <span id="feed-{{ item.key }}-title">{{ actions[item.type] }}</span>
            <span class="block text-caption text-muted">
                <time datetime="{{ item.date|date('c') }}" title="{{ item.date|date('d/m/Y à H:i') }}">{{ item.date|time_ago }}</time>
            </span>
        </p>
        <span class="feed-item-type" aria-hidden="true">
            {{- ui.icon({photo: 'camera', thread: 'message-square', army: 'swords', badges: 'medal'}[item.type], 'size-4') -}}
        </span>
    </header>

    {% if item.type == 'photo' %}
        {% set photo = item.subject %}
        {% set photo_url = path('app_gallery_photo_show', {username: actor.username, id: photo.id}) %}
        <a href="{{ photo_url }}" class="mt-3 block bg-surface-raised" aria-label="Voir la photo de {{ actor.username }}">
            <img src="{{ asset('uploads/gallery/' ~ photo.filename) }}" alt="{{ photo.description ? (photo.description|length > 120 ? photo.description|slice(0, 119) ~ '…' : photo.description) : 'Photo de ' ~ actor.username }}"
                 loading="lazy" decoding="async" class="feed-photo">
        </a>
        {% if photo.description %}
            <p class="px-4 pt-3 text-small text-fg-secondary break-words sm:px-5 line-clamp-3">{{ photo.description }}</p>
        {% endif %}
        <footer class="flex flex-wrap items-center gap-2 px-4 py-3 sm:px-5" data-controller="like">
            {% if is_granted('GALLERY_PHOTO_LIKE', photo) %}
                {% set liked = item.meta.liked ?? false %}
                <form method="post" action="{{ path('app_gallery_photo_like', {username: actor.username, id: photo.id}) }}" data-like-target="form" data-action="like#submit">
                    <input type="hidden" name="_token" value="{{ csrf_token('gallery_like_' ~ photo.id) }}">
                    <input type="hidden" name="liked" value="{{ liked ? '0' : '1' }}" data-like-target="intent">
                    <button type="submit" class="btn btn-secondary btn-sm like-toggle {{ liked ? 'is-liked' : 'is-not-liked' }}" aria-pressed="{{ liked ? 'true' : 'false' }}" data-like-target="button">
                        <span class="like-toggle-heart" aria-hidden="true">{{ liked ? '♥' : '♡' }}</span>
                        <span data-like-target="label">{{ liked ? 'Je n’aime plus' : 'J’aime' }}</span>
                        <span class="like-toggle-count" data-like-target="count">{{ item.meta.likes ?? 0 }}</span>
                    </button>
                </form>
            {% else %}
                <span class="chip">{{ ui.icon('heart') }}{{ item.meta.likes ?? 0 }}<span class="sr-only"> j’aime</span></span>
            {% endif %}
            <a href="{{ photo_url }}#comments" class="btn btn-ghost btn-sm">
                {{- ui.icon('message-circle') }}{{ item.meta.comments ?? 0 }} commentaire{{ (item.meta.comments ?? 0) > 1 ? 's' }}
            </a>
            <p class="field-error hidden w-full" data-like-target="error" role="alert"></p>
        </footer>

    {% elseif item.type == 'thread' %}
        {% set thread = item.subject %}
        {% set thread_url = path('app_thread_show', {slug: thread.slug}) %}
        <div class="px-4 pt-3 sm:px-5">
            <p class="mb-1 flex flex-wrap items-center gap-1.5">
                <a href="{{ path('app_forum_category', {slug: thread.category.slug}) }}" class="chip hover:text-fg">{{ ui.icon('folder') }}{{ thread.category.name }}</a>
                {% if thread.solved %}<span class="chip chip-success">{{ ui.icon('check-circle') }}Résolu</span>{% endif %}
            </p>
            <h3 class="text-h3 text-fg break-words"><a href="{{ thread_url }}" class="hover:text-primary-text">{{ thread.title }}</a></h3>
            {% if item.meta.content ?? '' %}
                <p class="mt-1 line-clamp-3 break-words text-small text-fg-secondary">{{ item.meta.content|forum_excerpt(260) }}</p>
            {% endif %}
        </div>
        <footer class="flex flex-wrap items-center gap-2 px-4 py-3 sm:px-5">
            <span class="chip">{{ ui.icon('message-circle') }}{{ item.meta.replies ?? 0 }} réponse{{ (item.meta.replies ?? 0) > 1 ? 's' }}</span>
            <a href="{{ thread_url }}#reply" class="btn btn-ghost btn-sm ml-auto">{{ ui.icon('pencil') }}Répondre</a>
        </footer>

    {% elseif item.type == 'army' %}
        {% set list = item.subject %}
        <a href="{{ path('app_army_show', {id: list.id}) }}" class="mx-4 mt-3 mb-4 flex items-center gap-3 rounded-card border border-line bg-surface-raised p-3 hover:border-line-strong sm:mx-5">
            <span class="flex size-11 shrink-0 items-center justify-center rounded-control bg-primary-soft text-primary-text">{{ ui.icon('swords') }}</span>
            <span class="min-w-0 flex-1">
                <span class="block truncate font-semibold text-fg">{{ list.name }}</span>
                <span class="block truncate text-caption text-muted">
                    {{- list.faction -}}{% if list.detachment %} · {{ list.detachment }}{% endif %}
                </span>
            </span>
            <span class="chip chip-accent shrink-0">{{ list.totalPoints ?? 0 }} pts</span>
        </a>

    {% elseif item.type == 'badges' %}
        <ul class="flex flex-wrap gap-2 px-4 pt-3 pb-4 sm:px-5" aria-label="Badges obtenus">
            {% for badge in item.subject|slice(0, 6) %}
                <li class="user-title badge-tier-{{ badge.tier }} user-title-md" title="{{ badge.description }}">
                    <span class="user-title-icon" aria-hidden="true">{{ badge.icon }}</span>
                    <span class="user-title-name">{{ badge.name }}</span>
                </li>
            {% endfor %}
            {% if item.subject|length > 6 %}
                <li class="chip">+{{ item.subject|length - 6 }}</li>
            {% endif %}
        </ul>
    {% endif %}
</article>
