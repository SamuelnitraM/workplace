{#
    Items of a page of the feed + Turbo Frame of the next page, loaded automatically (loading="lazy") as soon as it
    comes into view: the response of /fil replaces this frame with the next items (and the frame of the page after).
    While the frame loads (« busy »), skeleton rows replace the « Voir plus » link, which stays available otherwise.
    Parameter: feed (result of FeedService::page).
#}
{% for item in feed.items %}
    {{ include('feed/_item.html.twig', {item: item}, with_context = false) }}
{% endfor %}
{% if feed.next %}
    <turbo-frame id="feed-page-{{ feed.next }}" class="block space-y-4" target="_top" loading="lazy"
                 src="{{ path('app_feed_page', {fil: feed.filter, apres: feed.next}) }}">
        <div class="feed-page-loading">{{ include('_partials/_skeleton_rows.html.twig', {rows: 2}, with_context = false) }}</div>
        <div class="feed-page-more flex justify-center pt-2">
            <a href="{{ path('app_feed_page', {fil: feed.filter, apres: feed.next}) }}" class="btn btn-secondary" data-turbo-frame="feed-page-{{ feed.next }}">
                Voir plus d'activité
            </a>
        </div>
    </turbo-frame>
{% endif %}
