{#
    Éléments d'une page du fil + lien « Voir plus » dans un Turbo Frame propre à la page suivante :
    la réponse de /fil remplace ce frame par les éléments suivants (et le lien de la page d'après).
    Paramètre : feed (résultat de FeedService::page).
#}
{% for item in feed.items %}
    {{ include('feed/_item.html.twig', {item: item}, with_context = false) }}
{% endfor %}
{% if feed.next %}
    <turbo-frame id="feed-page-{{ feed.next }}" class="block space-y-4" target="_top">
        <div class="flex justify-center pt-2">
            <a href="{{ path('app_feed_page', {fil: feed.filter, apres: feed.next}) }}" class="btn btn-secondary" data-turbo-frame="feed-page-{{ feed.next }}">
                Voir plus d'activité
            </a>
        </div>
    </turbo-frame>
{% endif %}
