{% extends 'base.html.twig' %}
{% import '_macros/ui.html.twig' as ui %}

{% block title %}Forum — SprueHub{% endblock %}

{% block body %}
<header class="page-header">
    <div>
        <h1 class="page-header-title">Forum</h1>
        <p class="page-header-subtitle">Techniques de peinture, listes d'armée, rapports de bataille : posez vos questions et partagez votre expérience.</p>
    </div>
</header>

{% if categories is empty %}
    {{ include('_partials/_empty_state.html.twig', {
        icon: 'messages-square',
        title: 'Le forum se prépare',
        text: 'Aucune catégorie n\'est encore ouverte. En attendant, retrouvez les autres passionnés dans les groupes.',
        cta: app.user
            ? {label: 'Découvrir les groupes', url: path('app_group_index'), icon: 'users'}
            : {label: 'Créer mon compte', url: path('app_register')},
        secondary: app.user ? null : {label: 'J\'ai déjà un compte', url: path('app_login')},
    }) }}
{% else %}
    {# Regroupe les racines : chaque catégorie de regroupement forme une section ;
       les racines ordinaires consécutives partagent une même liste. #}
    {% set blocks = [] %}
    {% set run = [] %}
    {% for category in categories %}
        {% if category.grouping %}
            {% if run is not empty %}
                {% set blocks = blocks|merge([{grouping: null, items: run}]) %}
                {% set run = [] %}
            {% endif %}
            {% set blocks = blocks|merge([{grouping: category, items: category.children}]) %}
        {% else %}
            {% set run = run|merge([category]) %}
        {% endif %}
    {% endfor %}
    {% if run is not empty %}
        {% set blocks = blocks|merge([{grouping: null, items: run}]) %}
    {% endif %}

    <div class="space-y-8">
        {% for block in blocks %}
            {% if block.grouping %}
                {% set group = block.grouping %}
                {% set group_total = threadTotals[group.id] ?? 0 %}
                <section aria-labelledby="forum-section-{{ group.id }}">
                    <div class="mb-3 flex flex-wrap items-end justify-between gap-x-4 gap-y-1">
                        <div class="min-w-0">
                            <h2 id="forum-section-{{ group.id }}" class="section-title mb-0">
                                <a href="{{ path('app_forum_category', {slug: group.slug}) }}" class="rounded-sm hover:text-primary-text">{{ group.name }}</a>
                            </h2>
                            {% if group.description %}
                                <p class="mt-0.5 text-small text-fg-secondary">{{ group.description }}</p>
                            {% endif %}
                        </div>
                        <p class="text-caption text-muted tabular-nums">{{ group_total }} sujet{{ group_total > 1 ? 's' }}</p>
                    </div>
                    <div class="card overflow-hidden">
                        {% if block.items|length > 0 %}
                            {{ include('forum/_category_list.html.twig', {children: block.items, icon: 'folder'}) }}
                        {% else %}
                            <p class="px-4 py-5 text-small text-muted">Aucune sous-catégorie pour le moment.</p>
                        {% endif %}
                    </div>
                </section>
            {% else %}
                <section aria-label="Catégories">
                    <div class="card overflow-hidden">
                        {{ include('forum/_category_list.html.twig', {children: block.items, icon: 'messages-square', heading: 2}) }}
                    </div>
                </section>
            {% endif %}
        {% endfor %}
    </div>
{% endif %}
{% endblock %}
