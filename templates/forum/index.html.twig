{% extends 'base.html.twig' %}

{% block title %}Forum — HighlightForge{% endblock %}

{% block body %}
<div class="max-w-4xl mx-auto">

    <h1 class="text-3xl font-bold text-white mb-8">💬 Forum</h1>

    {% if categories is empty %}
        <div class="bg-gray-800 rounded-xl border border-gray-700 p-8 text-center text-gray-400">
            Aucune catégorie pour le moment.
        </div>
    {% else %}
        <div class="space-y-4">
            {% for category in categories %}
                <div class="bg-gray-800 rounded-xl border border-gray-700 p-6 hover:border-indigo-500 transition">
                    <div class="flex justify-between items-start">
                        <div>
                            <a href="{{ path('app_forum_category', {slug: category.slug}) }}"
                               class="text-xl font-bold text-indigo-400 hover:text-indigo-300 transition">
                                {{ category.name }}
                            </a>
                            {% if category.description %}
                                <p class="text-gray-400 text-sm mt-1">{{ category.description }}</p>
                            {% endif %}
                        </div>
                        <div class="text-right text-sm text-gray-500">
                            <div>{{ category.threads|length }} sujet(s)</div>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}

</div>
{% endblock %}