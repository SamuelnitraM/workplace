{# Grille compacte de sous-catégories (avec compteur de sujets).
   Paramètres : children (Category[]), threadCounts, threadTotals #}
{% import '_macros/ui.html.twig' as ui %}
<ul role="list" class="grid gap-2 sm:grid-cols-2">
    {% for child in children %}
        {% set own = threadCounts[child.id] ?? 0 %}
        {% set total = threadTotals[child.id] ?? own %}
        <li>
            <a href="{{ path('app_forum_category', {slug: child.slug}) }}"
               class="card card-interactive flex items-center gap-3 px-3 py-2.5 min-h-14">
                <span class="icon-tile size-9" aria-hidden="true">{{ ui.icon('folder', 'size-4') }}</span>
                <span class="min-w-0 flex-1">
                    <span class="block font-semibold text-fg truncate">{{ child.name }}</span>
                    <span class="block text-caption text-muted">
                        {{- own }} sujet{{ own > 1 ? 's' }}
                        {%- if total != own %} · {{ total }} au total{% endif %}
                        {%- if child.children|length > 0 %} · {{ child.children|length }} sous-catégorie{{ child.children|length > 1 ? 's' }}{% endif -%}
                    </span>
                </span>
                <span class="text-muted shrink-0" aria-hidden="true">{{ ui.icon('chevron-right', 'size-4') }}</span>
            </a>
        </li>
    {% endfor %}
</ul>
