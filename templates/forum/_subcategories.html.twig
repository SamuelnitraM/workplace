{# Vertical list of subcategories (left column of a category page), with thread counts.
   Parameters: children (Category[]), threadCounts, threadTotals #}
<ul role="list" class="forum-subcategory-list">
    {% for child in children %}
        {% set own = threadCounts[child.id] ?? 0 %}
        {% set total = threadTotals[child.id] ?? own %}
        <li>
            <a href="{{ path('app_forum_category', {slug: child.slug}) }}" class="forum-subcategory-link">
                <span class="min-w-0 flex-1 truncate">{{ child.name }}</span>
                <span class="forum-subcategory-count" title="{{ total }} sujet{{ total > 1 ? 's' }}{{ total != own ? ' (sous-catégories incluses)' }}">{{ total }}</span>
            </a>
        </li>
    {% endfor %}
</ul>
