{% extends 'base.html.twig' %}

{% block title %}{{ category.name }} — Forum{% endblock %}

{% block body %}
<div class="max-w-4xl mx-auto">

    <div class="flex justify-between items-center mb-8">
        <div>
            <a href="{{ path('app_forum_index') }}" class="text-gray-400 hover:text-white text-sm transition">
                ← Retour au forum
            </a>
            <h1 class="text-3xl font-bold text-white mt-1">{{ category.name }}</h1>
        </div>
        {% if app.user %}
            <a href="{{ path('app_thread_new', {slug: category.slug}) }}"
               class="bg-indigo-600 hover:bg-indigo-700 px-5 py-2 rounded-lg transition">
                ✏️ Nouveau sujet
            </a>
        {% endif %}
    </div>

    {% if threads is empty %}
        <div class="bg-gray-800 rounded-xl border border-gray-700 p-8 text-center text-gray-400">
            Aucun sujet dans cette catégorie.
            {% if app.user %}
                <a href="{{ path('app_thread_new', {slug: category.slug}) }}"
                   class="text-indigo-400 hover:text-indigo-300 ml-1">Soyez le premier !</a>
            {% endif %}
        </div>
    {% else %}
        <div class="space-y-3">
            {% for thread in threads.items %}
                <a href="{{ path('app_thread_show', {slug: thread.slug}) }}" class="block bg-gray-800 rounded-xl border {{ thread.isPinned ? 'border-yellow-600' : 'border-gray-700' }} p-5 hover:border-indigo-500 transition">
                    <div class="flex justify-between items-start">
                        <div class="flex items-start gap-3">
                            <div class="flex flex-col gap-1 mt-1">
                                {% if thread.isPinned %}
                                    <span class="text-yellow-400 text-xs">📌 Épinglé</span>
                                {% endif %}
                                {% if thread.isLocked %}
                                    <span class="text-red-400 text-xs">🔒 Fermé</span>
                                {% endif %}
                            </div>
                            <div>
                                <div class="text-lg font-semibold text-white hover:text-indigo-400 transition">
                                    {{ thread.title }}
                                </div>
                                <div class="text-sm text-gray-500 mt-1">
                                    Par <span class="text-gray-400">{{ thread.author.username }}</span>
                                    le {{ thread.createdAt|date('d/m/Y à H:i') }}
                                </div>
                            </div>
                        </div>
                        <div class="text-right text-sm text-gray-500 shrink-0 ml-4">
                            <div>{{ thread.posts|length }} réponse(s)</div>
                            <div>{{ thread.views }} vue(s)</div>
                        </div>
                    </div>
                </a>
            {% endfor %}
        </div>

        {# Pagination #}
        <div class="mt-6 flex justify-center">
            {{ knp_pagination_render(threads) }}
        </div>

    {% endif %}

</div>
{% endblock %}