{% extends 'base.html.twig' %}
{% import '_macros/ui.html.twig' as ui %}

{% block title %}{{ category.name }} — Forum{% endblock %}

{% block body %}
{% set can_create_thread = is_granted('CATEGORY_CREATE_THREAD', category) %}
{% set has_sidebar = not category.grouping and category.children|length > 0 %}
<header class="page-header">
    <div class="min-w-0">
        {{ include('forum/_breadcrumb.html.twig', {category: category}) }}
        <h1 class="page-header-title flex items-center gap-3">
            {% if category.icon %}<span class="icon-tile" aria-hidden="true">{{ ui.icon(category.icon) }}</span>{% endif %}{{ category.name }}
        </h1>
        {% if category.description %}
            <p class="page-header-subtitle">{{ category.description }}</p>
        {% endif %}
        {% if category.readOnly %}
            <p class="mt-2"><span class="chip chip-info">{{ ui.icon('lock') }}Lecture seule : seuls les administrateurs publient ici</span></p>
        {% endif %}
    </div>
    {% if can_create_thread %}
        <div class="page-header-actions">
            <a href="{{ path('app_thread_new', {slug: category.slug}) }}" class="btn btn-primary">
                {{- ui.icon('plus') }}Nouveau sujet
            </a>
        </div>
    {% endif %}
</header>

<div class="{{ has_sidebar ? 'forum-category-layout' : 'space-y-8' }}">
    {% if category.grouping %}
        {# Grouping category: its subcategories replace the thread list #}
        {% if category.children|length > 0 %}
            <div class="card overflow-hidden">
                {{ include('forum/_category_list.html.twig', {children: category.children, heading: 2}) }}
            </div>
        {% else %}
            {{ include('_partials/_empty_state.html.twig', {
                icon: 'folder',
                title: 'Aucune sous-catégorie pour le moment',
                compact: true,
                heading: 2,
            }) }}
        {% endif %}
    {% elseif has_sidebar %}
        <nav class="forum-subcategory-nav" aria-labelledby="subcategories-title">
            <h2 id="subcategories-title" class="eyebrow mb-2">Sous-catégories</h2>
            {{ include('forum/_subcategories.html.twig', {children: category.children}) }}
        </nav>
    {% endif %}

    {% if threads is null %}
        {# Regroupement sans sujet hérité : rien de plus à afficher #}
    {% elseif threads is empty %}
        {% if not category.allowThreads %}
            {{ include('_partials/_empty_state.html.twig', {
                icon: 'folder',
                title: 'Aucun sujet dans cette catégorie',
                text: category.children|length > 0
                    ? 'Les discussions se passent dans les sous-catégories ci-dessus.'
                    : 'La création de sujets n\'est pas ouverte dans cette catégorie.',
                cta: {label: 'Retour au forum', url: path('app_forum_index'), icon: 'arrow-left'},
            }) }}
        {% elseif category.readOnly %}
            {{ include('_partials/_empty_state.html.twig', {
                icon: 'message-square',
                title: 'Aucune publication pour l\'instant',
                text: 'Les annonces de l\'équipe apparaîtront ici.',
                compact: true,
            }) }}
        {% elseif app.user %}
            {{ include('_partials/_empty_state.html.twig', {
                icon: 'message-square',
                title: 'Aucun sujet pour l\'instant',
                text: 'Lancez la discussion : une question, un schéma de peinture, une liste à faire relire…',
                hint: app.user.threads is empty ? 'Votre premier sujet débloque le badge Pionnier I (+50 XP).' : null,
                cta: {label: 'Créer le premier sujet', url: path('app_thread_new', {slug: category.slug}), icon: 'pencil'},
            }) }}
        {% else %}
            {{ include('_partials/_empty_state.html.twig', {
                icon: 'message-square',
                title: 'Aucun sujet pour l\'instant',
                text: 'Inscrivez-vous pour lancer la première discussion de cette catégorie.',
                hint: 'Votre premier sujet débloque le badge Pionnier I (+50 XP).',
                cta: {label: 'Créer mon compte', url: path('app_register')},
                secondary: {label: 'J\'ai déjà un compte', url: path('app_login')},
            }) }}
        {% endif %}
    {% else %}
        <section aria-labelledby="threads-title" class="min-w-0">
            {% if category.grouping %}
                {# Sujets créés avant la désactivation : toujours consultables #}
                <h2 id="threads-title" class="section-title">{{ ui.icon('message-square') }}Sujets existants</h2>
                <div class="alert alert-info mb-4">
                    {{ ui.icon('info') }}
                    <p>La création de nouveaux sujets est désactivée dans cette catégorie ; les sujets ci-dessous restent consultables.</p>
                </div>
            {% else %}
                <div class="mb-3 flex items-baseline justify-between gap-4">
                    <h2 id="threads-title" class="section-title mb-0">{{ ui.icon('message-square') }}Sujets</h2>
                    <p class="text-caption text-muted tabular-nums">{{ threads.getTotalItemCount }} sujet{{ threads.getTotalItemCount > 1 ? 's' }}</p>
                </div>
            {% endif %}

            <ul role="list" class="card overflow-hidden">
                {% for thread in threads.items %}
                    {% set replies = max(thread.posts|length - 1, 0) %}
                    {% set activity = thread.updatedAt ?? thread.createdAt %}
                    <li class="list-row list-row-interactive relative items-start {{ thread.isPinned ? 'shadow-[inset_3px_0_0_var(--color-accent)]' }}">
                        {{ ui.avatar(thread.author, 'md', 'mt-0.5') }}
                        <div class="list-row-main">
                            {% if thread.isPinned or thread.isLocked or thread.solved %}
                                <p class="mb-1 flex flex-wrap gap-1.5">
                                    {% if thread.solved %}<span class="chip chip-success">{{ ui.icon('check-circle') }}Résolu</span>{% endif %}
                                    {% if thread.isPinned %}<span class="chip chip-accent">{{ ui.icon('pin') }}Épinglé</span>{% endif %}
                                    {% if thread.isLocked %}<span class="chip">{{ ui.icon('lock') }}Fermé</span>{% endif %}
                                </p>
                            {% endif %}
                            <h3 class="font-semibold text-fg leading-snug break-words">
                                <a href="{{ path('app_thread_show', {slug: thread.slug}) }}"
                                   class="rounded-sm hover:text-primary-text after:absolute after:inset-0 after:content-['']">{{ thread.title }}</a>
                            </h3>
                            <p class="mt-1 flex flex-wrap items-center gap-x-1.5 gap-y-1 text-caption text-muted">
                                <span>par <span class="font-medium text-fg-secondary">{{ thread.author.username }}</span></span>
                                {{ include('gamification/_user_title.html.twig', {user: thread.author}) }}
                                <span aria-hidden="true">·</span>
                                <time datetime="{{ thread.createdAt|date('c') }}" title="{{ thread.createdAt|date('d/m/Y à H:i') }}">{{ thread.createdAt|time_ago }}</time>
                            </p>
                            {# Statistiques compactes (mobile) #}
                            <p class="mt-1.5 flex flex-wrap items-center gap-x-3 text-caption text-muted sm:hidden">
                                <span class="inline-flex items-center gap-1">{{ ui.icon('message-circle', 'size-3.5') }}{{ replies }} réponse{{ replies > 1 ? 's' }}</span>
                                <span class="inline-flex items-center gap-1">{{ ui.icon('eye', 'size-3.5') }}{{ thread.views }} vue{{ thread.views > 1 ? 's' }}</span>
                            </p>
                        </div>
                        <div class="hidden sm:flex w-40 shrink-0 flex-col items-end gap-1 text-right">
                            <p class="flex items-center gap-3 text-small text-fg-secondary tabular-nums">
                                <span class="inline-flex items-center gap-1" title="Réponses">{{ ui.icon('message-circle', 'size-4 text-muted') }}{{ replies }}<span class="sr-only"> réponse{{ replies > 1 ? 's' }}</span></span>
                                <span class="inline-flex items-center gap-1" title="Vues">{{ ui.icon('eye', 'size-4 text-muted') }}{{ thread.views }}<span class="sr-only"> vue{{ thread.views > 1 ? 's' }}</span></span>
                            </p>
                            {% if replies > 0 %}
                                <p class="text-caption text-muted">Activité <time datetime="{{ activity|date('c') }}" title="{{ activity|date('d/m/Y à H:i') }}">{{ activity|time_ago }}</time></p>
                            {% endif %}
                        </div>
                    </li>
                {% endfor %}
            </ul>

            <div class="mt-6">
                {{ knp_pagination_render(threads, 'forum/_pagination.html.twig') }}
            </div>
        </section>
    {% endif %}
</div>
{% endblock %}
