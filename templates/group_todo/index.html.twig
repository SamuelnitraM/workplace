{% extends 'base.html.twig' %}
{% import '_macros/ui.html.twig' as ui %}

{% block title %}Tâches du groupe — {{ group.name }}{% endblock %}

{# Pencil button: same action as the double-click (todo#rename), target = id of the renamable element #}
{% macro rename_button(url, targetId, label) %}
    {% import '_macros/ui.html.twig' as ui %}
    <button type="button" class="btn btn-ghost btn-icon btn-sm reveal-on-hover shrink-0"
            aria-label="Renommer « {{ label }} »" title="Renommer (ou double-clic)"
            {{ stimulus_action('todo', 'rename:stop', 'click', {url: url, for: targetId}) }}>{{ ui.icon('pencil') }}</button>
{% endmacro %}

{% block body %}
{# Rights computed by the voters: writers (role >= group setting) = everything; member assigned to a task = sees it and progresses it;
   assignments handled by TodoAssignmentManager (request, approval, free mode). Lists are collapsed by default,
   except the one targeted by the address anchor (#list-…, #item-…). #}
<div {{ stimulus_controller('todo', {token: csrf_token('todo')}) }}>

    <header class="page-header">
        <div>
            <p class="page-header-eyebrow">
                <a class="link" href="{{ path('app_group_index') }}">Groupes</a>{{ ui.icon('chevron-right', 'size-4') }}<a class="link truncate" href="{{ path('app_group_show', {slug: group.slug}) }}">{{ group.name }}</a>
            </p>
            <h1 class="page-header-title">Tâches du groupe</h1>
            <p class="page-header-subtitle">
                {% if is_granted('TODO_WRITE', group) %}
                    Une liste par projet, des catégories, puis des tâches à assigner et à faire avancer par paliers de 25 %.
                    La progression des catégories et des listes se calcule à partir des tâches.
                {% elseif is_granted('TODO_VIEW_ALL', group) %}
                    Suivez l'avancement des projets du groupe.
                {% else %}
                    Les tâches qui vous sont assignées.
                {% endif %}
            </p>
            <div class="mt-2">
                {% if is_granted('TODO_WRITE', group) %}
                    <span class="chip chip-primary">{{ ui.icon('pencil', 'size-4') }}Vous pouvez modifier les tâches</span>
                {% elseif is_granted('TODO_VIEW_ALL', group) %}
                    <span class="chip">{{ ui.icon('eye', 'size-4') }}Lecture seule</span>
                {% else %}
                    <span class="chip">{{ ui.icon('user-check', 'size-4') }}Vos tâches assignées</span>
                {% endif %}
            </div>
        </div>
        <div class="page-header-actions">
            <a href="{{ path('app_group_show', {slug: group.slug}) }}" class="btn btn-ghost">{{ ui.icon('message-circle') }}Discussion</a>
            {% if is_granted('TODO_WRITE', group) %}
                <label for="new-group-todo-list" class="btn btn-primary">{{ ui.icon('plus') }}Nouvelle liste</label>
            {% endif %}
        </div>
    </header>

    <div class="space-y-6">

        {# EXISTING LISTS #}
        {% for list in lists %}
            {% set totalTasks = 0 %}
            {% set completedTasks = 0 %}
            {% set totalProgressSum = 0 %}

            {% for category in list.children %}
                {% for item in category.children %}
                    {% if is_granted('TODO_VIEW', item) %}
                    {% set totalTasks = totalTasks + 1 %}
                    {% set totalProgressSum = totalProgressSum + (item.progress ?? (item.isDone ? 100 : 0)) %}
                    {% if item.isDone or (item.progress ?? 0) >= 100 %}
                        {% set completedTasks = completedTasks + 1 %}
                    {% endif %}
                    {% endif %}
                {% endfor %}
            {% endfor %}

            {% set projectProgress = totalTasks > 0 ? (totalProgressSum / totalTasks)|round : 0 %}

            <section class="card" id="list-{{ list.id }}" x-data="{ open: false }"
                     x-init="open = location.hash.length > 1 && ($el.id === location.hash.slice(1) || $el.querySelector('#' + CSS.escape(location.hash.slice(1))) !== null)"
                     aria-labelledby="list-title-{{ list.id }}">

                {# LIST HEADER (click: expand / collapse) #}
                <div class="px-4 py-4 sm:px-5">
                    <div class="flex items-start gap-2 sm:gap-3">
                        <div class="group flex min-w-0 flex-1 cursor-pointer items-start gap-2 select-none" @click="open = !open">
                            <button type="button" class="btn btn-ghost btn-icon btn-sm -ml-1 shrink-0" :aria-expanded="open" aria-controls="list-body-{{ list.id }}"
                                    aria-label="Afficher ou masquer « {{ list.title }} »">
                                <span class="inline-flex transition-transform duration-(--duration-base)" :class="{ '-rotate-90': !open }">{{ ui.icon('chevron-down') }}</span>
                            </button>
                            <div class="min-w-0 flex-1">
                                <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
                                    <h2 id="list-title-{{ list.id }}" class="flex min-w-0 items-center gap-1 text-h3 text-fg">
                                        {% if is_granted('TODO_EDIT', list) %}
                                            <span id="rename-list-{{ list.id }}" class="truncate"
                                                  {{ stimulus_action('todo', 'rename:stop', 'dblclick', {url: path('app_group_todo_rename', {slug: group.slug, id: list.id})}) }}><span data-todo-title>{{ list.title }}</span></span>
                                            {{ _self.rename_button(path('app_group_todo_rename', {slug: group.slug, id: list.id}), 'rename-list-' ~ list.id, list.title) }}
                                        {% else %}
                                            <span class="truncate">{{ list.title }}</span>
                                        {% endif %}
                                    </h2>
                                    <span class="chip shrink-0 tabular-nums">{{ ui.icon('check-circle', 'size-4') }}{{ completedTasks }}/{{ totalTasks }} tâche{{ totalTasks > 1 ? 's' : '' }}</span>
                                </div>

                                {# OVERALL PROGRESS #}
                                <div class="mt-3 flex items-center gap-3">
                                    <div class="progress flex-1" aria-hidden="true">
                                        <div class="progress-bar" id="project-progress-bar-{{ list.id }}" style="width: {{ projectProgress }}%"></div>
                                    </div>
                                    <span class="w-11 shrink-0 text-right text-small font-semibold tabular-nums text-primary-text">
                                        <span class="sr-only">Progression de la liste : </span><span id="project-progress-text-{{ list.id }}">{{ projectProgress }}%</span>
                                    </span>
                                </div>
                            </div>
                        </div>

                        {% if is_granted('TODO_DELETE', list) %}
                            <form method="post" action="{{ path('app_group_todo_delete', {slug: group.slug, id: list.id}) }}" class="shrink-0"
                                  {{ stimulus_controller('confirm', {message: 'Supprimer cette liste ?'})|stimulus_action('confirm', 'ask', 'submit') }}>
                                <input type="hidden" name="_token" value="{{ csrf_token('todo') }}">
                                <button type="submit" class="btn btn-ghost btn-icon btn-sm hover:bg-danger-soft hover:text-danger-text"
                                        aria-label="Supprimer la liste « {{ list.title }} »" title="Supprimer la liste">{{ ui.icon('trash') }}</button>
                            </form>
                        {% endif %}
                    </div>
                </div>

                {# LIST CONTENT #}
                <div id="list-body-{{ list.id }}" x-show="open" x-transition.opacity.duration.200ms
                     class="space-y-3 rounded-b-card border-t border-line bg-canvas/40 p-3 sm:p-4">

                    <div class="grid grid-cols-1 items-start gap-3 lg:grid-cols-2">
                    {% for category in list.children %}
                        {# Visible tasks (TODO_VIEW): all of them for a writer, otherwise those of the assigned category or the assigned tasks #}
                        {% set visibleItems = [] %}
                        {% for item in category.children %}
                            {% if is_granted('TODO_VIEW', item) %}
                                {% set visibleItems = visibleItems|merge([item]) %}
                            {% endif %}
                        {% endfor %}
                        {% if is_granted('TODO_VIEW', category) %}
                        {% set categoryProgress = category.computedProgress %}
                        <div class="card-inset flex flex-col" id="category-{{ category.id }}">

                            {# CATEGORY HEADER: title, members assigned to its tasks, computed progress #}
                            <div class="border-b border-line">
                            <div class="group flex items-center gap-2 py-1.5 pr-1.5 pl-3">
                                <h3 class="flex min-w-0 flex-1 items-center gap-1 text-small font-semibold text-fg">
                                    {% if is_granted('TODO_EDIT', category) %}
                                        <span id="rename-category-{{ category.id }}" class="truncate cursor-text"
                                              {{ stimulus_action('todo', 'rename', 'dblclick', {url: path('app_group_todo_rename', {slug: group.slug, id: category.id})}) }}><span data-todo-title>{{ category.title }}</span></span>
                                        {{ _self.rename_button(path('app_group_todo_rename', {slug: group.slug, id: category.id}), 'rename-category-' ~ category.id, category.title) }}
                                    {% else %}
                                        <span class="truncate">{{ category.title }}</span>
                                    {% endif %}
                                    <span class="shrink-0 text-caption font-normal text-muted tabular-nums">· {{ visibleItems|length }}</span>
                                </h3>

                                {{ include('group_todo/_category_assignees.html.twig', {category: category}) }}

                                {% if is_granted('TODO_DELETE', category) %}
                                    <form method="post" action="{{ path('app_group_todo_delete', {slug: group.slug, id: category.id}) }}"
                                          {{ stimulus_controller('confirm', {message: 'Supprimer cette catégorie ?'})|stimulus_action('confirm', 'ask', 'submit') }} class="m-0 shrink-0">
                                        <input type="hidden" name="_token" value="{{ csrf_token('todo') }}">
                                        <button type="submit" class="btn btn-ghost btn-icon btn-sm hover:bg-danger-soft hover:text-danger-text"
                                                aria-label="Supprimer la catégorie « {{ category.title }} »" title="Supprimer la catégorie">{{ ui.icon('trash') }}</button>
                                    </form>
                                {% endif %}
                            </div>
                            <div class="flex items-center gap-2 px-3 pb-2" title="Progression calculée à partir des tâches">
                                <div class="progress progress-sm flex-1" aria-hidden="true">
                                    <div class="progress-bar" id="category-progress-bar-{{ category.id }}" style="width: {{ categoryProgress }}%"></div>
                                </div>
                                <span class="w-10 shrink-0 text-right text-caption font-semibold tabular-nums text-fg-secondary">
                                    <span class="sr-only">Progression de la catégorie : </span><span id="category-progress-text-{{ category.id }}">{{ categoryProgress }}%</span>
                                </span>
                            </div>
                            </div>

                            {# TASKS #}
                            {% if visibleItems is not empty %}
                            <ul class="space-y-2 p-2" role="list">
                                {% for item in visibleItems %}
                                    {% set itemProgress = item.progress ?? (item.isDone ? 100 : 0) %}
                                    {% set isItemDone = item.isDone or (item.progress ?? 0) >= 100 %}
                                    <li class="group rounded-control border border-line px-3 py-2.5 transition-colors hover:border-line-strong {{ isItemDone ? 'bg-canvas' : 'bg-surface' }}"
                                        id="item-{{ item.id }}"
                                        data-project-id="{{ list.id }}"
                                        data-category-id="{{ category.id }}"
                                        data-progress="{{ itemProgress }}"
                                        data-is-done="{{ isItemDone ? '1' : '0' }}">

                                        {# TITLE (click: full text; double-click or pencil: rename) #}
                                        <div class="flex items-start gap-1.5" x-data="{ expanded: false }">
                                            <div id="rename-item-{{ item.id }}" class="min-w-0 flex-1 cursor-pointer py-1 select-none"
                                                 @click="expanded = !expanded"
                                                 {% if is_granted('TODO_EDIT', item) %}{{ stimulus_action('todo', 'rename:stop', 'dblclick', {url: path('app_group_todo_rename', {slug: group.slug, id: item.id})}) }}{% endif %}>
                                                <p data-todo-title class="text-small font-medium {{ isItemDone ? 'line-through text-muted' : 'text-fg' }}"
                                                   :class="{ 'truncate': !expanded, 'break-words whitespace-normal': expanded }"
                                                   title="Cliquez pour afficher/masquer le texte complet">{{ item.title }}</p>
                                            </div>
                                            {% if is_granted('TODO_EDIT', item) %}
                                                {{ _self.rename_button(path('app_group_todo_rename', {slug: group.slug, id: item.id}), 'rename-item-' ~ item.id, item.title) }}
                                            {% endif %}
                                            <span class="chip {{ isItemDone ? 'chip-success' : '' }} shrink-0 tabular-nums" id="item-badge-{{ item.id }}">{{ itemProgress }}%</span>
                                        </div>

                                        <div class="progress progress-sm progress-success mt-1.5" aria-hidden="true">
                                            <div class="progress-bar" id="item-progress-bar-{{ item.id }}" style="width: {{ itemProgress }}%"></div>
                                        </div>

                                        {# CONTROLS: progress, assignment, deletion #}
                                        <div class="mt-2 flex flex-wrap items-center justify-between gap-2">
                                            {% if is_granted('TODO_PROGRESS', item) %}
                                                <div class="btn-group" role="group" aria-label="Progression de « {{ item.title }} »">
                                                    <button type="button" class="btn btn-secondary btn-sm btn-icon"
                                                            {{ stimulus_action('todo', 'progress', 'click', {url: path('app_group_todo_progress_down', {slug: group.slug, id: item.id}), item: item.id, project: list.id, category: category.id}) }}
                                                            aria-label="Diminuer la progression de 25 %" title="−25 %"><span aria-hidden="true" class="text-base leading-none">−</span></button>
                                                    <button type="button" class="btn btn-secondary btn-sm btn-icon"
                                                            {{ stimulus_action('todo', 'progress', 'click', {url: path('app_group_todo_progress_up', {slug: group.slug, id: item.id}), item: item.id, project: list.id, category: category.id}) }}
                                                            aria-label="Augmenter la progression de 25 %" title="+25 %">{{ ui.icon('plus') }}</button>
                                                    <button type="button" class="btn btn-secondary btn-sm"
                                                            {{ stimulus_action('todo', 'progress', 'click', {url: path('app_group_todo_progress_validate', {slug: group.slug, id: item.id}), item: item.id, project: list.id, category: category.id}) }}
                                                            title="Valider la tâche (100 %)">{{ ui.icon('check', 'size-4 text-success-text') }}Valider</button>
                                                </div>
                                            {% else %}
                                                <span></span>
                                            {% endif %}

                                            <div class="ml-auto flex items-center gap-1">
                                                {{ include('group_todo/_task_assignees.html.twig', {item: item, group: group}) }}
                                                {% if is_granted('TODO_DELETE', item) %}
                                                    <form method="post" action="{{ path('app_group_todo_delete', {slug: group.slug, id: item.id}) }}" class="m-0">
                                                        <input type="hidden" name="_token" value="{{ csrf_token('todo') }}">
                                                        <button type="submit" class="btn btn-ghost btn-icon btn-sm hover:bg-danger-soft hover:text-danger-text"
                                                                aria-label="Supprimer la tâche « {{ item.title }} »" title="Supprimer la tâche">{{ ui.icon('trash') }}</button>
                                                    </form>
                                                {% endif %}
                                            </div>
                                        </div>
                                    </li>
                                {% endfor %}
                            </ul>
                            {% else %}
                                <p class="px-3 py-4 text-center text-caption text-muted">Aucune tâche dans cette catégorie.</p>
                            {% endif %}

                            {# ADD A TASK #}
                            {% if is_granted('TODO_CREATE_CHILD', category) %}
                            <form method="post" action="{{ path('app_group_todo_create', {slug: group.slug}) }}" class="mt-auto flex gap-2 border-t border-line p-2">
                                <input type="hidden" name="type" value="item">
                                <input type="hidden" name="_token" value="{{ csrf_token('todo') }}">
                                <input type="hidden" name="parent_id" value="{{ category.id }}">
                                <label for="new-item-{{ category.id }}" class="sr-only">Nouvelle tâche dans « {{ category.title }} »</label>
                                <input type="text" id="new-item-{{ category.id }}" name="title" placeholder="Ajouter une tâche…" required
                                       class="input min-w-0 flex-1 bg-surface">
                                <button type="submit" class="btn btn-secondary btn-icon" aria-label="Ajouter la tâche">{{ ui.icon('plus') }}</button>
                            </form>
                            {% endif %}

                        </div>
                        {% endif %}
                    {% endfor %}
                    </div>

                    {# ADD A CATEGORY #}
                    {% if is_granted('TODO_CREATE_CHILD', list) %}
                    <form method="post" action="{{ path('app_group_todo_create', {slug: group.slug}) }}" class="flex gap-2">
                        <input type="hidden" name="type" value="category">
                        <input type="hidden" name="_token" value="{{ csrf_token('todo') }}">
                        <input type="hidden" name="parent_id" value="{{ list.id }}">
                        <label for="new-category-{{ list.id }}" class="sr-only">Nouvelle catégorie dans « {{ list.title }} »</label>
                        <input type="text" id="new-category-{{ list.id }}" name="title" placeholder="Nouvelle catégorie…" required
                               class="input min-w-0 flex-1 border-dashed bg-transparent">
                        <button type="submit" class="btn btn-secondary">{{ ui.icon('plus') }}<span>Catégorie</span></button>
                    </form>
                    {% endif %}

                </div>
            </section>
        {% else %}
            {% if is_granted('TODO_WRITE', group) %}
                {{ include('_partials/_empty_state.html.twig', {
                    icon: 'clipboard-list',
                    title: 'Aucune liste de tâches pour le moment',
                    text: 'Organisez les projets du groupe : une liste par projet (armée, tournoi, décors), des catégories, puis des tâches à assigner aux membres.',
                    cta: {label: 'Créer la première liste', for: 'new-group-todo-list', icon: 'plus'},
                }) }}
            {% elseif not is_granted('TODO_VIEW_ALL', group) %}
                {{ include('_partials/_empty_state.html.twig', {
                    icon: 'clipboard-list',
                    title: 'Aucune tâche ne vous est assignée',
                    text: 'Les tâches qu\'on vous assigne apparaîtront ici. En attendant, passez discuter avec le groupe.',
                    cta: {label: 'Retour au groupe', url: path('app_group_show', {slug: group.slug}), icon: 'message-circle'},
                }) }}
            {% else %}
                {{ include('_partials/_empty_state.html.twig', {
                    icon: 'clipboard-list',
                    title: 'Aucune liste de tâches pour le moment',
                    text: 'Les listes créées par les membres autorisés à modifier les tâches apparaîtront ici.',
                    cta: {label: 'Retour au groupe', url: path('app_group_show', {slug: group.slug}), icon: 'message-circle'},
                }) }}
            {% endif %}
        {% endfor %}

        {# CREATE A LIST #}
        {% if is_granted('TODO_WRITE', group) %}
        <section class="card border-dashed" aria-labelledby="new-list-title">
            <div class="card-body">
                <h2 id="new-list-title" class="text-h3 text-fg">Nouvelle liste</h2>
                <p class="mt-1 text-small text-fg-secondary">Un projet du groupe : une armée, un tournoi, une table de décors…</p>
                <form method="post" action="{{ path('app_group_todo_create', {slug: group.slug}) }}" class="mt-4 flex flex-col gap-2 sm:flex-row">
                    <input type="hidden" name="type" value="list">
                    <input type="hidden" name="_token" value="{{ csrf_token('todo') }}">
                    <input type="text" id="new-group-todo-list" name="title" placeholder="Nom de la liste…" aria-label="Nom de la nouvelle liste" required
                           class="input min-w-0 flex-1 scroll-mt-40">
                    <button type="submit" class="btn btn-primary">{{ ui.icon('plus') }}Créer la liste</button>
                </form>
            </div>
        </section>
        {% endif %}

    </div>

    {# Decision on an assignment (manager): accept or refuse a request, remove an assignee #}
    <dialog class="modal" id="assignment-dialog" aria-labelledby="assignment-dialog-title" data-todo-target="assignmentDialog" data-action="click->todo#closeAssignmentOnBackdrop">
        <div class="modal-header">
            <p class="modal-title" id="assignment-dialog-title">Assignation</p>
            <button type="button" class="btn btn-ghost btn-icon btn-sm" data-action="todo#closeAssignment" aria-label="Fermer">{{ ui.icon('x') }}</button>
        </div>
        <div class="modal-body">
            <p class="text-fg-secondary" data-todo-target="assignmentText"></p>
            <p class="mt-2 text-small text-danger-text" data-todo-target="assignmentError" hidden></p>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-danger" data-todo-target="removeButton" data-action="todo#decideAssignment">{{ ui.icon('user-minus') }}Retirer de la tâche</button>
            <button type="button" class="btn btn-secondary" data-todo-target="refuseButton" data-action="todo#decideAssignment">{{ ui.icon('x') }}Refuser</button>
            <button type="button" class="btn btn-primary" data-todo-target="acceptButton" data-action="todo#decideAssignment">{{ ui.icon('check') }}Accepter</button>
        </div>
    </dialog>
</div>

{% endblock %}
