{% extends 'base.html.twig' %}
{% import '_macros/ui.html.twig' as ui %}

{% block title %}Modifier mon profil — SprueHub{% endblock %}

{% block body %}
<div class="container-reading" data-controller="avatar">

    <header class="page-header">
        <div>
            <p class="page-header-eyebrow"><a class="link" href="{{ path('app_profil_show', {username: app.user.username}) }}">Mon profil</a>{{ ui.icon('chevron-right', 'size-4') }}Paramètres</p>
            <h1 class="page-header-title">Modifier mon profil</h1>
            <p class="page-header-subtitle">Ta photo, ta présentation et ce que les autres membres voient de toi.</p>
        </div>
    </header>

    {{ form_start(form, {'attr': {'enctype': 'multipart/form-data', 'class': 'space-y-6'}}) }}
        {{ form_errors(form) }}

        <input type="hidden" name="delete_avatar" id="delete-avatar" value="0" data-avatar-target="deleteInput">

        {# ─── Profil ─── #}
        <section class="card" aria-labelledby="settings-profile">
            <div class="card-header">
                <h2 id="settings-profile" class="flex items-center gap-2 text-h3 text-fg"><span class="text-muted">{{ ui.icon('user') }}</span>Profil</h2>
            </div>
            <div class="card-body space-y-6">

                {# Photo de profil (assets/controllers/avatar_controller.js) #}
                <div class="flex flex-col items-center gap-5 sm:flex-row sm:items-center">
                    <div class="group relative size-28 shrink-0">
                        <div class="relative size-full overflow-hidden rounded-pill border-2 border-line-strong bg-surface-raised">
                            <img {% if user.avatar %}src="{{ asset('uploads/avatars/' ~ user.avatar) }}" {% endif %}
                                 alt="Photo de profil actuelle"
                                 id="avatar-preview" data-avatar-target="preview"
                                 class="size-full object-cover {{ user.avatar ? '' : 'hidden' }}">
                            <div id="avatar-placeholder" data-avatar-target="placeholder" aria-hidden="true"
                                 class="size-full items-center justify-center text-4xl font-bold text-muted {{ user.avatar ? 'hidden' : 'flex' }}">
                                {{ user.username|first|upper }}
                            </div>
                            <div class="pointer-events-none absolute inset-0 flex items-center justify-center bg-black/50 text-white opacity-0 transition-opacity duration-(--duration-fast) group-hover:opacity-100 group-focus-within:opacity-100" aria-hidden="true">
                                {{ ui.icon('camera', 'size-7') }}
                            </div>
                        </div>
                        {# Champ fichier masqué, ouvert par la photo ou le bouton « Changer la photo » #}
                        <div class="absolute inset-0">
                            {{ form_widget(form.avatarFile, {'attr': {'class': 'sr-only', 'data-action': 'change->avatar#preview'}, 'id': 'avatar-upload-input'}) }}
                            <label for="avatar-upload-input" class="absolute inset-0 cursor-pointer rounded-pill"><span class="sr-only">Choisir une nouvelle photo de profil</span></label>
                        </div>
                    </div>

                    <div class="flex flex-col items-center gap-3 text-center sm:items-start sm:text-left">
                        <div>
                            <p class="label">Photo de profil</p>
                            <p class="help">Clique sur la photo ou sur le bouton pour en choisir une nouvelle (JPG, PNG ou WEBP).</p>
                        </div>
                        <div class="flex flex-wrap items-center justify-center gap-2 sm:justify-start">
                            <label for="avatar-upload-input" class="btn btn-secondary btn-sm cursor-pointer">{{ ui.icon('upload') }}Changer la photo</label>
                            {% if user.avatar %}
                                <div id="select-avatar-container" data-avatar-target="selectContainer">
                                    <label class="check py-0 text-small text-fg-secondary">
                                        <input type="checkbox" id="select-avatar" class="checkbox" data-avatar-target="selectCheckbox" data-action="change->avatar#toggleDelete">
                                        <span>Retirer la photo actuelle</span>
                                    </label>
                                </div>
                            {% endif %}
                        </div>
                        {% if user.avatar %}
                            <button type="button" id="btn-delete-avatar"
                                    data-avatar-target="deleteButton" data-action="avatar#markForDeletion"
                                    class="btn btn-danger btn-sm hidden">
                                {{ ui.icon('trash') }}Supprimer la photo
                            </button>
                        {% endif %}
                        {{ form_errors(form.avatarFile) }}
                    </div>
                </div>

                <hr class="divider my-0">

                {{ form_row(form.username) }}
                {{ form_row(form.bio) }}
                <div class="grid items-start gap-5 sm:grid-cols-2">
                    {{ form_row(form.favoriteFaction) }}
                    {{ form_row(form.titleBadge, {help: form.titleBadge.vars.choices is empty
                        ? 'Débloque un badge pour pouvoir l\'afficher comme titre.'
                        : 'Seuls tes badges débloqués peuvent servir de titre.'}) }}
                </div>
            </div>
        </section>

        {# ─── Confidentialité ─── #}
        <section class="card" aria-labelledby="settings-privacy">
            <div class="card-header">
                <h2 id="settings-privacy" class="flex items-center gap-2 text-h3 text-fg"><span class="text-muted">{{ ui.icon('eye') }}</span>Confidentialité</h2>
            </div>
            <div class="card-body">
                <fieldset class="field">
                    <legend class="label mb-1.5">{{ form.showActivity.vars.label }}</legend>
                    <div class="flex flex-wrap gap-x-6">
                        {% for choice in form.showActivity %}
                            <label class="check">{{ form_widget(choice) }}<span>{{ choice.vars.label }}</span></label>
                        {% endfor %}
                    </div>
                    {{ form_errors(form.showActivity) }}
                </fieldset>
                {% do form.showActivity.setRendered() %}
            </div>
        </section>

        {# ─── Sécurité ─── #}
        <section class="card" aria-labelledby="settings-security">
            <div class="card-header">
                <h2 id="settings-security" class="flex items-center gap-2 text-h3 text-fg"><span class="text-muted">{{ ui.icon('shield') }}</span>Sécurité</h2>
            </div>
            <div class="card-body flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                <div>
                    <p class="font-medium text-fg">Mot de passe</p>
                    <p class="text-small text-muted">Choisis une phrase facile à retenir mais difficile à deviner.</p>
                </div>
                <a href="{{ path('app_profil_change_password') }}" class="btn btn-secondary shrink-0">{{ ui.icon('lock') }}Changer le mot de passe</a>
            </div>
        </section>

        {# ─── Barre d'enregistrement (collante en bas de l'écran) ─── #}
        <div class="sticky bottom-[calc(var(--bottom-bar-h)+env(safe-area-inset-bottom))] z-(--z-sticky) -mx-4 flex items-center justify-end gap-2 border-t border-line bg-canvas/90 px-4 py-3 backdrop-blur sm:mx-0 sm:rounded-card sm:border md:bottom-4">
            <a href="{{ path('app_profil_show', {username: app.user.username}) }}" class="btn btn-ghost">Annuler</a>
            <button type="submit" class="btn btn-primary">{{ ui.icon('check') }}Enregistrer</button>
        </div>

    {{ form_end(form) }}
</div>
{% endblock %}
