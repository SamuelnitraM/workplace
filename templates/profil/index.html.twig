{% extends 'base.html.twig' %}
{% import '_macros/ui.html.twig' as ui %}

{% block title %}Profil — {{ user.username }}{% endblock %}

{% block body %}
{% set photo_count = galleryPhotos|length %}
{% set gallery_full = photo_count >= 10 %}
<div class="profile max-w-5xl mx-auto" data-controller="tabs">

    {# ================= EN-TÊTE DU PROFIL ================= #}
    <header class="card profile-hero">
        <div class="profile-cover" aria-hidden="true"></div>

        <div class="profile-hero-body">
            <div class="profile-hero-top">
                {{ ui.avatar(user, 'xl', 'avatar-ring profile-avatar') }}

                {# ---- Actions ---- #}
                <div class="profile-actions">
                    {% if isOwner %}
                        <a href="{{ path('app_profil_edit') }}" class="btn btn-primary">{{ ui.icon('pencil') }}Modifier le profil</a>
                        <a href="{{ path('app_group_invitation_list') }}" class="btn btn-secondary">
                            {{ ui.icon('mail') }}Invitations
                            {% if pendingInvitationsCount > 0 %}
                                <span class="count-badge">{{ pendingInvitationsCount }}<span class="sr-only"> en attente</span></span>
                            {% endif %}
                        </a>
                        <a href="{{ path('app_army_index') }}" class="btn btn-ghost">{{ ui.icon('swords') }}Mes listes d'armée</a>

                    {% elseif app.user %}
                        {% if friendship is null %}
                            <form method="post" action="{{ path('app_friendship_request', {username: user.username}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('friendship') }}">
                                <button type="submit" class="btn btn-primary">{{ ui.icon('user-plus') }}Ajouter en ami</button>
                            </form>
                        {% elseif friendship.status == 'pending' and friendship.requester == app.user %}
                            <span class="profile-status chip chip-info">{{ ui.icon('clock') }}Demande envoyée</span>
                        {% elseif friendship.status == 'pending' and friendship.receiver == app.user %}
                            <form method="post" action="{{ path('app_friendship_accept', {id: friendship.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('friendship') }}">
                                <button type="submit" class="btn btn-primary">{{ ui.icon('user-check') }}Accepter la demande</button>
                            </form>
                            <form method="post" action="{{ path('app_friendship_refuse', {id: friendship.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('friendship') }}">
                                <button type="submit" class="btn btn-ghost text-danger-text">{{ ui.icon('x') }}Refuser</button>
                            </form>
                        {% elseif friendship.status == 'accepted' %}
                            <div x-data="{ open: false }" class="dropdown" @keydown.escape="open = false">
                                <button type="button" class="btn btn-secondary" @click="open = !open" :aria-expanded="open.toString()" aria-expanded="false" aria-haspopup="true">
                                    {{ ui.icon('user-check', 'size-5 text-success-text') }}Amis{{ ui.icon('chevron-down') }}
                                </button>
                                <div class="menu menu-start" x-show="open" x-cloak @click.outside="open = false" x-transition.opacity>
                                    <form method="post" action="{{ path('app_friendship_remove', {username: user.username}) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('friendship') }}">
                                        <button type="submit" class="menu-item menu-item-danger w-full">{{ ui.icon('x') }}Retirer l’ami</button>
                                    </form>
                                </div>
                            </div>
                        {% elseif friendship.status == 'blocked' and friendship.receiver == app.user %}
                            <form method="post" action="{{ path('app_friendship_unblock', {username: user.username}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('friendship') }}">
                                <button type="submit" class="btn btn-secondary">{{ ui.icon('lock') }}Débloquer</button>
                            </form>
                        {% elseif friendship.status == 'blocked' and friendship.requester == app.user %}
                            <span class="profile-status chip">{{ ui.icon('x-circle') }}Demande refusée</span>
                        {% endif %}

                        <a href="{{ path('app_message_show', {username: user.username}) }}"
                           class="btn {{ friendship is not null and friendship.status == 'accepted' ? 'btn-primary' : 'btn-secondary' }}">
                            {{ ui.icon('message-circle') }}Message
                        </a>

                        {% if myGroups is defined and myGroups is not empty %}
                            <div x-data="{ open: false }" class="dropdown" @keydown.escape="open = false">
                                <button type="button" class="btn btn-ghost" @click="open = !open" :aria-expanded="open.toString()" aria-expanded="false" aria-haspopup="true">
                                    {{ ui.icon('users') }}Inviter{{ ui.icon('chevron-down') }}
                                </button>
                                <div class="menu profile-invite-menu" x-show="open" x-cloak @click.outside="open = false" x-transition.opacity>
                                    <p class="menu-label eyebrow">Inviter dans un groupe</p>
                                    {% for group in myGroups %}
                                        <form method="post" action="{{ path('app_group_invitation_send', {username: user.username}) }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('group_invite') }}">
                                            <input type="hidden" name="group_id" value="{{ group.id }}">
                                            <button type="submit" class="menu-item w-full">
                                                {{ ui.icon(group.isPublic ? 'globe' : 'lock') }}
                                                <span class="min-w-0 flex-1 truncate text-left">{{ group.name }}</span>
                                                <span class="text-caption text-muted">{{ group.isPublic ? 'Public' : 'Privé' }}</span>
                                            </button>
                                        </form>
                                    {% endfor %}
                                </div>
                            </div>
                        {% endif %}
                    {% endif %}
                </div>
            </div>

            {# ---- Identité ---- #}
            <div class="profile-identity mt-3">
                <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
                    <h1 class="text-h1 font-bold text-fg break-all">{{ user.username }}</h1>
                    {{ include('gamification/_user_title.html.twig', {user: user, size: 'md'}) }}
                    {% if 'ROLE_ADMIN' in user.roles %}
                        <span class="chip chip-danger">{{ ui.icon('shield') }}Admin</span>
                    {% elseif 'ROLE_MODERATOR' in user.roles %}
                        <span class="chip chip-success">{{ ui.icon('shield-check') }}Modérateur</span>
                    {% endif %}
                </div>
                <div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-2 text-small text-muted">
                    {% if user.favoriteFaction %}
                        <span class="chip chip-primary">{{ ui.icon('swords') }}{{ user.favoriteFaction }}</span>
                    {% endif %}
                    <span class="inline-flex items-center gap-1.5">{{ ui.icon('calendar', 'size-4') }}Membre depuis le {{ user.createdAt|date('d/m/Y') }}</span>
                </div>
                {% if user.bio %}
                    <p class="mt-3 max-w-reading text-fg-secondary whitespace-pre-line break-words">{{ user.bio }}</p>
                {% endif %}
            </div>

            {# ---- Statistiques + niveau ---- #}
            <div class="profile-hero-footer">
                <dl class="profile-stats">
                    <div class="profile-stat">
                        <dt>Amis</dt>
                        {% if isOwner %}
                            <dd><a href="{{ path('app_friendship_list') }}" class="profile-stat-link">{{ friends|length }}<span class="sr-only"> — voir mes amis</span></a></dd>
                        {% else %}
                            <dd>{{ friends|length }}</dd>
                        {% endif %}
                    </div>
                    <div class="profile-stat"><dt>Sujets</dt><dd>{{ user.threads|length }}</dd></div>
                    <div class="profile-stat"><dt>Messages</dt><dd>{{ user.posts|length }}</dd></div>
                </dl>

                <div class="profile-level">
                    <div class="flex items-center justify-between gap-3 text-small">
                        <span class="inline-flex items-center gap-1.5 font-semibold text-accent-text">{{ ui.icon('star', 'size-4') }}Niveau {{ user.level }}</span>
                        <span class="text-muted tabular-nums">{% if user.maxLevel %}{{ user.experience }} XP{% else %}{{ user.experience }} / {{ user.nextLevelExperience }} XP{% endif %}</span>
                    </div>
                    <div class="progress progress-accent mt-2" role="progressbar" aria-valuenow="{{ user.experienceProgress }}" aria-valuemin="0" aria-valuemax="100" aria-label="Progression d'expérience">
                        <div class="progress-bar" style="width: {{ user.experienceProgress }}%"></div>
                    </div>
                    {% if user.level < 50 %}
                        <p class="mt-1.5 text-caption text-muted">{{ user.experienceProgress }} % vers le niveau {{ user.level + 1 }}</p>
                    {% else %}
                        <p class="mt-1.5 text-caption text-accent-text">Niveau maximum atteint</p>
                    {% endif %}
                </div>
            </div>
        </div>
    </header>

    {# ================= ONGLETS ================= #}
    <div class="profile-tabs-bar">
        <div id="profile-tabs" class="tabs profile-tabs" role="tablist" aria-label="Sections du profil">
            <button type="button" role="tab" id="tab-gallery" aria-controls="panel-gallery" aria-selected="true" data-tab="gallery" data-tabs-target="tab" data-action="tabs#select" class="tab">
                {{ ui.icon('camera') }}Galerie<span class="tab-count">{{ isOwner ? photo_count ~ '/10' : photo_count }}</span>
            </button>
            <button type="button" role="tab" id="tab-armies" aria-controls="panel-armies" aria-selected="false" data-tab="armies" data-tabs-target="tab" data-action="tabs#select" class="tab">
                {{ ui.icon('swords') }}Armées<span class="sr-only"> publiques</span><span class="tab-count">{{ publicArmyLists|length }}</span>
            </button>
            <button type="button" role="tab" id="tab-badges" aria-controls="panel-badges" aria-selected="false" data-tab="badges" data-tabs-target="tab" data-action="tabs#select" class="tab">
                {{ ui.icon('medal') }}Badges<span class="tab-count">{{ profileBadges.unlocked }}/{{ profileBadges.total }}</span>
            </button>
            {% if user.showActivity %}
                <button type="button" role="tab" id="tab-activity" aria-controls="panel-activity" aria-selected="false" data-tab="activity" data-tabs-target="tab" data-action="tabs#select" class="tab">
                    {{ ui.icon('clock') }}Activité<span class="sr-only"> récente</span>
                </button>
            {% endif %}
        </div>
    </div>

    {# ================= GALERIE ================= #}
    <section id="panel-gallery" role="tabpanel" aria-labelledby="tab-gallery" data-panel="gallery" data-tabs-target="panel" data-controller="profile-gallery" class="profile-gallery">
        {% if isOwner %}
            <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
                <p class="text-small text-muted max-w-reading">Survolez ou touchez une photo puis cochez-la pour la supprimer. L'œil masque une photo aux visiteurs.</p>
                <div class="flex items-center gap-3 min-w-44" title="{{ photo_count }} photo{{ photo_count > 1 ? 's' }} sur 10">
                    <div class="progress progress-sm flex-1 {{ gallery_full ? 'progress-accent' : '' }}" role="progressbar" aria-valuenow="{{ photo_count }}" aria-valuemin="0" aria-valuemax="10" aria-label="Photos publiées">
                        <div class="progress-bar" style="width: {{ photo_count * 10 }}%"></div>
                    </div>
                    <span class="text-small font-semibold tabular-nums {{ gallery_full ? 'text-accent-text' : 'text-fg-secondary' }}">{{ photo_count }}/10</span>
                </div>
            </div>
        {% endif %}

        <div class="gallery-grid">
            {% if isOwner %}
                <form id="gallery-upload-form" method="post" enctype="multipart/form-data" action="{{ path('app_profil_gallery_upload', {username: user.username}) }}" class="upload-zone bg-surface{% if gallery_full %} is-locked{% endif %}" data-profile-gallery-target="zone" data-action="dragover->profile-gallery#dragOver dragleave->profile-gallery#dragLeave drop->profile-gallery#drop" data-upload-locked="{{ gallery_full ? 'true' : 'false' }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('gallery_upload') }}">
                    <input type="file" id="profile-photo-upload" name="photo" accept="image/jpeg,image/png,image/webp" required class="sr-only" data-profile-gallery-target="input" data-action="change->profile-gallery#fileChanged" {% if gallery_full %}disabled{% endif %}>
                    <label for="profile-photo-upload" class="upload-zone-label{% if gallery_full %} pointer-events-none{% endif %}" data-profile-gallery-target="label">
                        {{ ui.icon(gallery_full ? 'lock' : 'image-plus', 'upload-zone-icon') }}
                        <span class="upload-zone-text">{% if gallery_full %}Limite de 10 photos atteinte{% else %}Ajouter une photo{% endif %}</span>
                        {% if not gallery_full %}<small class="upload-zone-hint">ou glissez-la ici · JPG, PNG, WebP</small>{% endif %}
                    </label>
                    <button type="submit" data-profile-gallery-target="submit" data-action="profile-gallery#submitClick" class="btn btn-primary btn-sm absolute bottom-3 left-1/2 z-20 -translate-x-1/2 {% if gallery_full %}hidden{% endif %}">Publier</button>
                    <div class="upload-zone-preview opacity-0" data-profile-gallery-target="preview"></div>
                </form>
            {% endif %}

            {% for photo in galleryPhotos %}
                {% set stats = galleryStats[photo.id] ?? {likes: 0, comments: 0} %}
                <div class="gallery-photo group{% if isOwner and not photo.isVisible %} is-hidden-photo{% endif %}" data-photo-id="{{ photo.id }}"{% if isOwner %} data-action="mouseenter->profile-gallery#showSelector mouseleave->profile-gallery#hideSelector"{% endif %}>
                    {% if isOwner %}
                        <button type="button" data-action="profile-gallery#toggleSelection" class="gallery-select is-idle" aria-label="Sélectionner la photo pour la supprimer">{{ ui.icon('check', 'size-4') }}</button>
                        <form method="post" action="{{ path('app_profil_gallery_visibility', {username: user.username, id: photo.id}) }}" class="gallery-photo-action">
                            <input type="hidden" name="_token" value="{{ csrf_token('gallery_visibility_' ~ photo.id) }}">
                            <button type="submit" class="gallery-tile-btn" aria-label="{{ photo.isVisible ? 'Masquer la photo' : 'Rendre la photo visible' }}" title="{{ photo.isVisible ? 'Masquer la photo aux visiteurs' : 'Rendre la photo visible' }}">
                                {{ ui.icon(photo.isVisible ? 'eye' : 'eye-off', 'size-4') }}
                            </button>
                        </form>
                    {% endif %}
                    <a href="{{ path('app_gallery_photo_show', {username: user.username, id: photo.id}) }}" class="gallery-photo-link" data-action="profile-gallery#followLink" aria-label="Voir la photo{% if photo.description %} : {{ photo.description|length > 80 ? photo.description|slice(0, 80) ~ '…' : photo.description }}{% endif %} ({{ stats.likes }} j'aime, {{ stats.comments }} commentaire{{ stats.comments > 1 ? 's' : '' }}){% if isOwner and not photo.isVisible %} — masquée{% endif %}">
                        <img src="{{ asset('uploads/gallery/' ~ photo.filename) }}" alt="Photo de {{ user.username }}" loading="lazy" decoding="async" class="gallery-photo-img">
                        {% if isOwner and not photo.isVisible %}
                            <span class="gallery-photo-flag" aria-hidden="true">{{ ui.icon('eye-off', 'size-3.5') }}Masquée</span>
                        {% endif %}
                        <span class="gallery-photo-stats" aria-hidden="true">
                            <span>{{ ui.icon('heart', 'size-4') }}{{ stats.likes }}</span>
                            <span>{{ ui.icon('message-circle', 'size-4') }}{{ stats.comments }}</span>
                        </span>
                    </a>
                </div>
            {% endfor %}
        </div>

        {% if isOwner %}
            {# Barre de sélection : affichée en CSS dès qu'une photo est cochée (:has(.is-selected)), compteur CSS #}
            <div class="gallery-toolbar" role="region" aria-label="Photos sélectionnées">
                <p class="gallery-toolbar-count">{{ ui.icon('check-circle', 'size-5') }}<span><span class="gallery-toolbar-number"></span> sélectionnée(s)</span></p>
                <div class="flex items-center gap-2">
                    <a href="{{ path('app_profil_show', {username: user.username}) }}" class="btn btn-ghost btn-sm">Annuler</a>
                    <button type="submit" form="gallery-delete-form" data-action="profile-gallery#submitClick" class="btn btn-danger btn-sm">{{ ui.icon('trash') }}Supprimer</button>
                </div>
            </div>
        {% endif %}

        {% if isOwner and not gallery_full %}
            <div class="field mt-4 max-w-reading" data-profile-gallery-target="description">
                <label for="gallery-upload-description" class="label">Description de la photo <span class="label-hint">(facultatif)</span></label>
                <textarea id="gallery-upload-description" name="description" form="gallery-upload-form" rows="2" maxlength="{{ galleryDescriptionMaxLength }}" placeholder="Quelques mots sur votre figurine, votre peinture, votre table…" class="textarea" aria-describedby="gallery-upload-description-help"></textarea>
                <p id="gallery-upload-description-help" class="help">{{ galleryDescriptionMaxLength }} caractères maximum — choisissez d'abord la photo, puis « Publier ».</p>
            </div>
        {% endif %}
        {% if isOwner and gallery_full %}
            <p class="mt-4 inline-flex items-center gap-2 text-small text-muted">{{ ui.icon('info', 'size-4') }}Limite de 10 photos atteinte : supprimez-en une pour en publier une nouvelle.</p>
        {% endif %}

        {% if galleryPhotos is empty %}
            <div class="mt-4">
                {% if isOwner %}
                    {{ include('_partials/_empty_state.html.twig', {
                        icon: 'camera',
                        title: 'Votre galerie est vide',
                        text: 'Montrez vos figurines, vos schémas de peinture ou votre table de jeu : jusqu\'à 10 photos, que la communauté peut aimer et commenter.',
                        cta: {label: 'Ajouter ma première photo', for: 'profile-photo-upload', icon: 'image-plus'},
                        compact: true,
                    }) }}
                {% elseif app.user %}
                    {{ include('_partials/_empty_state.html.twig', {
                        icon: 'camera',
                        title: user.username ~ ' n\'a pas encore partagé de photo',
                        text: 'Revenez plus tard… ou montrez l\'exemple en ajoutant vos propres photos.',
                        cta: {label: 'Ma galerie', url: path('app_profil_show', {username: app.user.username}), icon: 'camera'},
                        compact: true,
                    }) }}
                {% else %}
                    {{ include('_partials/_empty_state.html.twig', {
                        icon: 'camera',
                        title: user.username ~ ' n\'a pas encore partagé de photo',
                        text: 'Inscrivez-vous pour partager vos propres figurines avec la communauté.',
                        cta: {label: 'Créer mon compte', url: path('app_register')},
                        secondary: {label: 'Se connecter', url: path('app_login')},
                        compact: true,
                    }) }}
                {% endif %}
            </div>
        {% endif %}
        {% if isOwner %}
            <form id="gallery-delete-form" data-profile-gallery-target="deleteForm" method="post" action="{{ path('app_profil_gallery_delete', {username: user.username}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('gallery_delete') }}">
            </form>
        {% endif %}
    </section>

    {# ================= BADGES ================= #}
    <section id="panel-badges" role="tabpanel" aria-labelledby="tab-badges" data-panel="badges" data-tabs-target="panel" hidden>
        {% set current_title_code = user.titleBadge ? user.titleBadge.code : null %}
        {% set badges_percent = profileBadges.total > 0 ? (profileBadges.unlocked * 100 / profileBadges.total)|round : 0 %}

        {# En-tête : niveau, XP, badges obtenus #}
        <div class="card mb-8">
            <div class="card-body grid gap-5 md:grid-cols-[minmax(0,1fr)_14rem] md:items-start">
                <div>
                    <div class="flex flex-wrap items-baseline justify-between gap-3">
                        <h2 class="text-h3 text-fg inline-flex items-center gap-2">{{ ui.icon('star', 'size-5 text-accent-text') }}Niveau {{ user.level }}{% if user.maxLevel %} <span class="chip chip-accent">Niveau max</span>{% endif %}</h2>
                        <span class="text-small text-muted tabular-nums">
                            {% if user.maxLevel %}{{ user.experience }} XP{% else %}{{ user.experience }} / {{ user.nextLevelExperience }} XP{% endif %}
                        </span>
                    </div>
                    <div class="progress progress-accent mt-2" role="progressbar" aria-valuenow="{{ user.experienceProgress }}" aria-valuemin="0" aria-valuemax="100" aria-label="Progression vers le niveau suivant">
                        <div class="progress-bar" style="width: {{ user.experienceProgress }}%"></div>
                    </div>

                    {# Gains quotidiens : phrase générique (visiteurs) ou personnalisée (propriétaire) #}
                    <div class="card-inset mt-4 p-3 text-small text-fg-secondary" data-daily-xp-info>
                        {% if streakStatus %}
                            {% set s = streakStatus %}
                            <p class="flex gap-2">
                                {{ ui.icon('flame', 'size-5 shrink-0 text-accent-text') }}
                                <span>Connecte-toi chaque jour : <strong class="text-primary-text">+{{ dailyLoginXp }} XP par jour</strong>, et <strong class="text-accent-text">+{{ streakBonusXp }} XP bonus</strong> tous les {{ streakBonusEvery }} jours de série.
                                Ta série actuelle : <strong class="text-fg">{{ s.streak }} jour{{ s.streak > 1 ? 's' }}</strong>.</span>
                            </p>
                            <div class="mt-3 flex flex-wrap gap-2">
                                {% if s.countedToday %}
                                    <span class="chip chip-success">{{ ui.icon('check') }}XP du jour obtenue</span>
                                {% else %}
                                    <span class="chip">{{ ui.icon('clock') }}XP du jour pas encore obtenue</span>
                                {% endif %}
                                {% if s.countedToday and s.streak > 0 and s.streak % streakBonusEvery == 0 %}
                                    <span class="chip chip-accent">{{ ui.icon('sparkles') }}Bonus de série obtenu aujourd'hui !</span>
                                {% endif %}
                                <span class="chip">{{ ui.icon('calendar') }}Prochain bonus dans {{ s.nextBonusIn }} jour{{ s.nextBonusIn > 1 ? 's' }} de connexion</span>
                                {% if s.atRisk %}
                                    <span class="chip chip-warning">{{ ui.icon('alert-triangle') }}Série en danger : reconnecte-toi avant le {{ s.expiresOn|date('d/m') }}</span>
                                {% endif %}
                            </div>
                            <p class="mt-2 text-caption text-muted">Pas d'inquiétude : ta série est conservée jusqu'à {{ streakMaxMissedDays }} jours d'absence.</p>
                        {% else %}
                            <p class="flex gap-2">
                                {{ ui.icon('flame', 'size-5 shrink-0 text-accent-text') }}
                                <span>Connecte-toi chaque jour : <strong class="text-primary-text">+{{ dailyLoginXp }} XP par jour</strong>, et <strong class="text-accent-text">+{{ streakBonusXp }} XP bonus</strong> tous les {{ streakBonusEvery }} jours de série. La série est conservée jusqu'à {{ streakMaxMissedDays }} jours d'absence.</span>
                            </p>
                        {% endif %}
                    </div>
                </div>

                <div class="md:border-l md:border-line md:pl-5 md:text-center">
                    <p class="eyebrow">Badges obtenus</p>
                    <p class="mt-1 text-h1 font-bold text-fg tabular-nums">{{ profileBadges.unlocked }}<span class="text-h3 text-muted"> / {{ profileBadges.total }}</span></p>
                    <div class="progress progress-sm mt-2" role="progressbar" aria-valuenow="{{ profileBadges.unlocked }}" aria-valuemin="0" aria-valuemax="{{ profileBadges.total }}" aria-label="Badges obtenus">
                        <div class="progress-bar" style="width: {{ badges_percent }}%"></div>
                    </div>
                    {% if user.titleBadge %}
                        <p class="mt-3 text-caption text-muted">Titre affiché</p>
                        <div class="mt-1">{{ include('gamification/_user_title.html.twig', {user: user, size: 'md'}) }}</div>
                    {% endif %}
                </div>
            </div>
        </div>

        {% if isOwner and profileBadges.unlocked == 0 %}
            <div class="mb-8">
                {{ include('_partials/_empty_state.html.twig', {
                    icon: 'medal',
                    title: 'Aucun badge obtenu pour l\'instant',
                    text: 'Les badges ci-dessous se débloquent en participant à la vie du site : forum, galerie, groupes, listes d\'armée…',
                    hint: user.threads is empty ? 'Le plus rapide : publiez votre premier sujet pour débloquer Pionnier I (+50 XP).' : null,
                    cta: {label: 'Publier sur le forum', url: path('app_forum_index'), icon: 'pencil'},
                    compact: true,
                }) }}
            </div>
        {% elseif not isOwner and profileBadges.unlocked == 0 %}
            <p class="mb-8 text-center text-small text-muted">{{ user.username }} n'a pas encore obtenu de badge.</p>
        {% endif %}

        {% for category, badges in profileBadges.categories %}
            {% set cat_unlocked = badges|filter(b => b.unlocked)|length %}
            <div class="mb-3 flex items-center justify-between gap-3 {% if not loop.first %}mt-10{% endif %}">
                <h3 class="eyebrow">{{ category }}</h3>
                <span class="text-caption text-muted tabular-nums">{{ cat_unlocked }}/{{ badges|length }}</span>
            </div>
            <div class="grid grid-cols-1 min-[420px]:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
                {% for badge in badges %}
                    {% set is_current = isOwner and badge.code == current_title_code %}
                    <article class="badge-card badge-tier-{{ badge.tier }}{% if not badge.unlocked %} badge-locked{% endif %}{% if is_current %} is-current-title{% endif %}" data-badge="{{ badge.code }}" aria-label="{{ badge.name }} — {{ badge.unlocked ? 'obtenu' : 'verrouillé' }}{% if is_current %} — titre actuel{% endif %}">
                        {% if is_current %}
                            <span class="badge-current-flag">{{ ui.icon('crown', 'size-3.5') }}Titre actuel</span>
                        {% elseif not badge.unlocked %}
                            <span class="badge-lock" aria-hidden="true">{{ ui.icon('lock', 'size-3.5') }}</span>
                        {% endif %}
                        <div class="badge-medal mb-1" aria-hidden="true">{{ badge.icon }}</div>
                        <h4 class="badge-name font-semibold text-fg">{{ badge.name }}</h4>
                        <span class="badge-tier-pill">{{ badge.tierLabel }}</span>
                        <p class="mt-1 text-caption text-fg-secondary">{{ badge.description }}</p>
                        <p class="text-caption font-semibold badge-accent-text">{{ badge.xp > 0 ? '+' ~ badge.xp ~ ' XP' : 'Honorifique' }}</p>
                        {% if badge.unlocked %}
                            <p class="inline-flex items-center gap-1 text-caption text-muted">{{ ui.icon('check-circle', 'size-3.5 text-success-text') }}Obtenu le {{ badge.unlockedAt|date('d/m/Y') }}</p>
                        {% elseif badge.progress %}
                            <div class="mt-1 w-full text-left">
                                <div class="mb-1 flex justify-between gap-2 text-caption text-muted"><span>{{ badge.progress.label }}</span><span class="tabular-nums">{{ badge.progress.percent }} %</span></div>
                                <div class="badge-progress-bar" role="progressbar" aria-valuenow="{{ badge.progress.current }}" aria-valuemin="0" aria-valuemax="{{ badge.progress.target }}" aria-label="Progression : {{ badge.progress.label }}"><span style="width: {{ badge.progress.percent }}%"></span></div>
                                {% if badge.progress.items is not empty %}
                                    <ul class="mt-2 grid grid-cols-2 gap-x-2 gap-y-0.5 text-caption">
                                        {% for label, visited in badge.progress.items %}
                                            <li class="flex items-center gap-1 {{ visited ? 'text-success-text' : 'text-muted' }}">{{ ui.icon(visited ? 'check' : 'clock', 'size-3 shrink-0') }}{{ label }}<span class="sr-only">{{ visited ? ' (fait)' : ' (à faire)' }}</span></li>
                                        {% endfor %}
                                    </ul>
                                {% endif %}
                            </div>
                        {% else %}
                            <p class="text-caption text-muted">Verrouillé</p>
                        {% endif %}
                        {% set rarity = badgeRarity[badge.code] ?? null %}
                        {% if rarity %}
                            <p class="badge-rarity mt-auto pt-2" title="{{ rarity.holders }} membre{{ rarity.holders > 1 ? 's' }} sur {{ rarity.members }}">
                                <span class="badge-rarity-label badge-rarity-{{ rarity.key }}">{{ rarity.label }}</span>
                                <span class="block mt-1">
                                {% if rarity.holders > 0 %}
                                    Débloqué par {{ rarity.percentLabel }} % des membres ({{ rarity.holders }})
                                {% else %}
                                    Encore jamais débloqué
                                {% endif %}
                                </span>
                            </p>
                        {% endif %}
                        {% if isOwner and badge.unlocked %}
                            <form method="post" action="{{ path('app_profil_title') }}" class="{{ rarity ? '' : 'mt-auto ' }}pt-2">
                                <input type="hidden" name="_token" value="{{ csrf_token('profile_title') }}">
                                {% if badge.code == current_title_code %}
                                    <input type="hidden" name="badge" value="">
                                    <button type="submit" class="btn btn-ghost btn-sm">{{ ui.icon('x') }}Retirer le titre</button>
                                {% else %}
                                    <input type="hidden" name="badge" value="{{ badge.code }}">
                                    <button type="submit" class="btn btn-secondary btn-sm">{{ ui.icon('crown') }}Utiliser comme titre</button>
                                {% endif %}
                            </form>
                        {% endif %}
                    </article>
                {% endfor %}
            </div>
        {% endfor %}

        {# Historique d'XP : privé (propriétaire uniquement), replié par défaut #}
        {% if isOwner and xpHistory %}
            <details class="xp-history card mt-10" data-xp-history>
                <summary class="xp-history-summary">
                    <span class="flex min-w-0 items-center gap-2 font-semibold text-fg">
                        {{ ui.icon('chevron-right', 'xp-history-chevron size-5 text-muted') }}
                        {{ ui.icon('bar-chart', 'size-5 text-accent-text') }}
                        <span>Historique d'XP <span class="block text-caption font-normal text-muted sm:inline">(visible par vous uniquement)</span></span>
                    </span>
                    <span class="shrink-0 text-small text-muted"><strong class="text-accent-text">{{ xpHistory.total }} XP</strong> · {{ xpHistory.count }} gain{{ xpHistory.count > 1 ? 's' }}</span>
                </summary>
                <div class="border-t border-line">
                    {{ include('profil/_xp_history_rows.html.twig', {rows: xpHistory.rows}) }}
                    <div class="card-footer justify-between flex-wrap text-small">
                        <span class="text-muted">Total : <strong class="text-fg">{{ xpHistory.total }} XP</strong>{% if xpHistory.count > xpHistory.rows|length %} — {{ xpHistory.rows|length }} derniers gains affichés sur {{ xpHistory.count }}{% endif %}</span>
                        {% if xpHistory.count > xpHistory.rows|length %}
                            <a href="{{ path('app_profil_xp_history', {username: user.username}) }}" class="btn btn-link btn-sm">Voir tout l'historique{{ ui.icon('arrow-right', 'size-4') }}</a>
                        {% endif %}
                    </div>
                </div>
            </details>
        {% endif %}
    </section>

    {# ================= ARMÉES PUBLIQUES ================= #}
    <section id="panel-armies" role="tabpanel" aria-labelledby="tab-armies" data-panel="armies" data-tabs-target="panel" hidden>
        {% if publicArmyLists is empty %}
            {% if isOwner %}
                {{ include('_partials/_empty_state.html.twig', {
                    icon: 'swords',
                    title: 'Aucune liste d\'armée publique',
                    text: 'Créez une liste et cochez « publique » pour la présenter ici aux visiteurs de votre profil.',
                    cta: {label: 'Créer une liste d\'armée', url: path('app_army_new'), icon: 'plus'},
                    secondary: {label: 'Mes listes d\'armée', url: path('app_army_index')},
                    compact: true,
                }) }}
            {% elseif app.user %}
                {{ include('_partials/_empty_state.html.twig', {
                    icon: 'swords',
                    title: user.username ~ ' n\'a pas encore de liste d\'armée publique',
                    text: 'Et vous, quelle armée alignez-vous ? Composez votre liste en quelques clics.',
                    cta: {label: 'Créer ma liste d\'armée', url: path('app_army_new'), icon: 'plus'},
                    compact: true,
                }) }}
            {% else %}
                {{ include('_partials/_empty_state.html.twig', {
                    icon: 'swords',
                    title: user.username ~ ' n\'a pas encore de liste d\'armée publique',
                    text: 'Inscrivez-vous pour composer et partager vos propres listes d\'armée.',
                    cta: {label: 'Créer mon compte', url: path('app_register')},
                    secondary: {label: 'Se connecter', url: path('app_login')},
                    compact: true,
                }) }}
            {% endif %}
        {% else %}
            {% if isOwner %}
                <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
                    <p class="text-small text-muted">Vos listes publiques, visibles par les visiteurs de votre profil.</p>
                    <div class="flex gap-2">
                        <a href="{{ path('app_army_index') }}" class="btn btn-ghost btn-sm">Toutes mes listes</a>
                        <a href="{{ path('app_army_new') }}" class="btn btn-secondary btn-sm">{{ ui.icon('plus') }}Nouvelle liste</a>
                    </div>
                </div>
            {% endif %}
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                {% for list in publicArmyLists %}
                    {{ include('army/_card.html.twig', {list: list, heading: 3}) }}
                {% endfor %}
            </div>
        {% endif %}
    </section>

    {# ================= ACTIVITÉ ================= #}
    {% if user.showActivity %}
    <section id="panel-activity" role="tabpanel" aria-labelledby="tab-activity" data-panel="activity" data-tabs-target="panel" hidden>
        <div class="card">
            {% if activities is empty %}
                {% if isOwner %}
                    {{ include('_partials/_empty_state.html.twig', {
                        icon: 'clock',
                        title: 'Aucune activité récente',
                        text: 'Vos sujets, réponses, listes d\'armée publiques, photos, amitiés et groupes publics apparaîtront ici.',
                        cta: {label: 'Participer au forum', url: path('app_forum_index'), icon: 'message-circle'},
                        secondary: {label: 'Rejoindre un groupe', url: path('app_group_index'), icon: 'users'},
                        variant: 'plain',
                        compact: true,
                    }) }}
                {% else %}
                    {{ include('_partials/_empty_state.html.twig', {
                        icon: 'clock',
                        title: user.username ~ ' n\'a pas d\'activité récente',
                        text: 'Ses prochains sujets, photos et listes d\'armée publiques apparaîtront ici.',
                        cta: app.user ? {label: 'Voir le forum', url: path('app_forum_index'), icon: 'message-circle'} : {label: 'Créer mon compte', url: path('app_register')},
                        variant: 'plain',
                        compact: true,
                    }) }}
                {% endif %}
            {% else %}
                <ol>
                    {% for activity in activities %}
                        <li class="list-row items-start text-small">
                            <span class="mt-0.5 text-muted">{{ ui.icon('clock', 'size-4') }}</span>
                            <p class="list-row-main text-fg-secondary break-words">
                                {{ user.username }} {{ activity.label }}
                                {% if activity.url and activity.subject %}
                                    <a href="{{ path(activity.url, activity.parameters) }}" class="link">« {{ activity.subject }} »</a>
                                {% else %}
                                    <span class="text-fg">{% if activity.subject %}« {{ activity.subject }} »{% else %}une photo{% endif %}</span>
                                {% endif %}
                            </p>
                            <time class="shrink-0 text-caption text-muted whitespace-nowrap">{{ activity.time }}</time>
                        </li>
                    {% endfor %}
                </ol>
            {% endif %}
        </div>
    </section>
    {% endif %}

</div>
{% endblock %}
