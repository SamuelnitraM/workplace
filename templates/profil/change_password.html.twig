{% extends 'base.html.twig' %}

{% block title %}Changer mon mot de passe{% endblock %}

{% block body %}
<div class="max-w-lg mx-auto">

    <div class="bg-gray-800 rounded-xl border border-gray-700 p-8">
        <h1 class="text-2xl font-bold text-white mb-6">🔒 Changer mon mot de passe</h1>

        {{ form_start(form) }}

            <div class="space-y-5">

                <div>
                    {{ form_label(form.currentPassword, null, {'label_attr': {'class': 'block text-sm text-gray-400 mb-1'}}) }}
                    {{ form_widget(form.currentPassword, {'attr': {'class': 'w-full bg-gray-700 border border-gray-600 rounded-lg px-4 py-2 text-white focus:outline-none focus:border-indigo-500'}}) }}
                    {{ form_errors(form.currentPassword) }}
                </div>

                <div>
                    {{ form_label(form.newPassword.first, null, {'label_attr': {'class': 'block text-sm text-gray-400 mb-1'}}) }}
                    {{ form_widget(form.newPassword.first, {'attr': {'class': 'w-full bg-gray-700 border border-gray-600 rounded-lg px-4 py-2 text-white focus:outline-none focus:border-indigo-500'}}) }}
                    {{ form_errors(form.newPassword.first) }}
                </div>

                <div>
                    {{ form_label(form.newPassword.second, null, {'label_attr': {'class': 'block text-sm text-gray-400 mb-1'}}) }}
                    {{ form_widget(form.newPassword.second, {'attr': {'class': 'w-full bg-gray-700 border border-gray-600 rounded-lg px-4 py-2 text-white focus:outline-none focus:border-indigo-500'}}) }}
                    {{ form_errors(form.newPassword.second) }}
                </div>

            </div>

            <div class="flex gap-3 mt-8">
                <button type="submit"
                        class="bg-indigo-600 hover:bg-indigo-700 px-6 py-2 rounded-lg transition">
                    💾 Modifier le mot de passe
                </button>
                <a href="{{ path('app_profil_index') }}"
                   class="bg-gray-700 hover:bg-gray-600 px-6 py-2 rounded-lg transition">
                    Annuler
                </a>
            </div>

        {{ form_end(form) }}
    </div>

</div>
{% endblock %}