{% extends 'base.html.twig' %}
{% import '_macros/ui.html.twig' as ui %}

{% block title %}Changer mon mot de passe — SprueHub{% endblock %}

{% block body %}
<div class="container-form">

    <header class="page-header">
        <div>
            <p class="page-header-eyebrow"><a class="link" href="{{ path('app_profil_edit') }}">Paramètres</a>{{ ui.icon('chevron-right', 'size-4') }}Sécurité</p>
            <h1 class="page-header-title">Changer mon mot de passe</h1>
            <p class="page-header-subtitle">Par sécurité, confirme d'abord ton mot de passe actuel.</p>
        </div>
    </header>

    {{ form_start(form, {attr: {class: 'card'}}) }}
        <div class="card-body space-y-5">
            {{ form_errors(form) }}
            {{ form_row(form.currentPassword, {attr: form.currentPassword.vars.attr|merge({autofocus: 'autofocus'})}) }}
            {{ form_row(form.newPassword.first, {help: 'Au moins ' ~ constant('App\\Form\\RegistrationFormType::PASSWORD_MIN_LENGTH') ~ ' caractères (une phrase facile à retenir est idéale).'}) }}
            {{ form_row(form.newPassword.second) }}
        </div>
        <div class="card-footer">
            <a href="{{ path('app_profil_show', {username: app.user.username}) }}" class="btn btn-ghost">Annuler</a>
            <button type="submit" class="btn btn-primary">{{ ui.icon('lock') }}Modifier le mot de passe</button>
        </div>
    {{ form_end(form) }}

</div>
{% endblock %}
