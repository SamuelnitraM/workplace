<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <title>{% block title %}HighlightForge{% endblock %}</title>
    {% block stylesheets %}
        {{ encore_entry_link_tags('app') }}
    {% endblock %}
    {% block javascripts %}
        {{ importmap('app') }}
    {% endblock %}
</head>
<body class="bg-gray-900 text-gray-100 min-h-screen flex flex-col">

    {# NAVBAR #}
    <nav class="bg-gray-800 border-b border-gray-700 px-6 py-4">
        <div class="max-w-7xl mx-auto flex justify-between items-center">
            <a href="{{ path('app_home') }}" class="text-xl font-bold text-indigo-400">
                ⚔️ HighlightForge
            </a>

            <a href="{{ path('app_forum_index') }}" class="text-gray-300 hover:text-white transition text-sm">
                💬 Forum
            </a>

            <a href="{{ path('app_group_index') }}" class="text-gray-300 hover:text-white transition text-sm">
                👥 Groupes
            </a>

            <div class="flex gap-4 items-center">

                {% if app.user %}
                    {# MENU DÉROULANT PROFIL #}
                    <div class="relative" x-data="{ open: false }">
                        <button @click="open = !open"
                                class="flex items-center gap-2 text-gray-300 hover:text-white transition text-sm">
                            <div class="relative">
                                <div class="w-8 h-8 rounded-full bg-indigo-600 flex items-center justify-center font-bold text-sm">
                                    {% if app.user.avatar %}
                                        <img src="{{ asset('uploads/avatars/' ~ app.user.avatar) }}"
                                            class="w-8 h-8 rounded-full object-cover">
                                    {% else %}
                                        {{ app.user.username|first|upper }}
                                    {% endif %}
                                </div>
                                {# BADGE ROUGE #}
                                {% if pendingInvitationsCount > 0 %}
                                    <span class="absolute -top-1 -right-1 w-4 h-4 bg-red-500 rounded-full text-white text-xs flex items-center justify-center">
                                        {{ pendingInvitationsCount }}
                                    </span>
                                {% endif %}
                            </div>
                            <span>{{ app.user.username }}</span>
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                            </svg>
                        </button>

                        {# DROPDOWN #}
                        <div x-show="open"
                            @click.outside="open = false"
                            x-transition
                            class="absolute right-0 mt-2 w-48 bg-gray-800 border border-gray-700 rounded-xl shadow-lg z-50">
                            <div class="py-2">
                                <a href="{{ path('app_profil_show', {username: app.user.username}) }}" class="flex items-center justify-between px-4 py-2 text-gray-300 hover:text-white hover:bg-gray-700 transition text-sm">
                                    <span>👤 Mon profil</span>
                                    {% if pendingInvitationsCount > 0 %}
                                        <span class="w-5 h-5 bg-red-500 rounded-full text-white text-xs flex items-center justify-center">
                                            {{ pendingInvitationsCount }}
                                        </span>
                                    {% endif %}
                                </a>
                                <a href="{{ path('app_todo_index') }}" class="flex items-center gap-3 px-4 py-2 text-gray-300 hover:text-white hover:bg-gray-700 transition text-sm">
                                    📋 Todo liste
                                </a>
                                <a href="{{ path('app_friendship_list') }}" class="flex items-center gap-3 px-4 py-2 text-gray-300 hover:text-white hover:bg-gray-700 transition text-sm">
                                    👥 Mes amis
                                </a>
                                <div class="border-t border-gray-700 my-1"></div>
                                <a href="{{ path('app_logout') }}"
                                class="flex items-center gap-3 px-4 py-2 text-red-400 hover:text-red-300 hover:bg-gray-700 transition text-sm">
                                    🚪 Déconnexion
                                </a>
                            </div>
                        </div>
                    </div>
                {% else %}
                    <a href="{{ path('app_login') }}" 
                       class="bg-indigo-600 hover:bg-indigo-700 px-4 py-2 rounded text-sm transition">
                        Connexion
                    </a>
                    <a href="{{ path('app_register') }}" 
                       class="bg-green-600 hover:bg-green-700 px-4 py-2 rounded text-sm transition">
                        Inscription
                    </a>
                {% endif %}
            </div>
        </div>
    </nav>

{# FLASH MESSAGES #}
{% set flashes = app.flashes %}
{% if flashes is not empty %}
    <div class="fixed top-20 left-1/2 -translate-x-1/2 z-50 w-full max-w-lg px-6">
        {% for type, messages in flashes %}
            {% for message in messages %}
                <div class="mb-2 px-4 py-3 rounded shadow-lg
                    {% if type == 'success' %}bg-green-700
                    {% elseif type == 'error' %}bg-red-700
                    {% else %}bg-blue-700{% endif %}">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}
    </div>
{% endif %}

    {# CONTENU PRINCIPAL #}
    <main class="flex-1 max-w-7xl mx-auto w-full px-6">
        {% block body %}{% endblock %}
    </main>

    {# FOOTER #}
    <footer class="bg-gray-800 border-t border-gray-700 text-center text-gray-500 text-sm py-4">
        © {{ "now"|date("Y") }} HighlightForge — Communauté Miniaturiste
    </footer>

</body>
</html>