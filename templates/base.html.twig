<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="theme-color" content="#0d1016">
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <script src="https://js.pusher.com/8.2.0/pusher.min.js"></script>
    <style>[x-cloak] { display: none !important; }</style>
    <link rel="icon" type="image/png" href="{{ asset('images/SprueHub-W-1-min.png') }}">
    <title>{% block title %}SprueHub{% endblock %}</title>
    {# Pas de préchargement au survol (Turbo 8) : l'affichage de certaines pages marque des éléments comme lus
       (notifications, conversations), ce qui ne doit arriver que si l'utilisateur ouvre réellement la page. #}
    <meta name="turbo-prefetch" content="false">
    {% if app.user %}
    {# Configuration du temps réel (lue par assets/lib/realtime.js) #}
    <meta name="hf-user-id" content="{{ app.user.id }}">
    <meta name="hf-pusher-key" content="{{ pusher_key }}">
    <meta name="hf-pusher-cluster" content="{{ pusher_cluster }}">
    <meta name="hf-pusher-auth" content="{{ path('app_pusher_auth') }}">
    <meta name="hf-csrf-private-message" content="{{ csrf_token('private_message') }}">
    <meta name="hf-csrf-notification" content="{{ csrf_token('notification') }}">
    <meta name="hf-notification-sound" content="{{ app.user.notificationSound }}">
    {% endif %}
    {% block stylesheets %}{% endblock %}
    {% block javascripts %}
        {{ importmap('app') }}
    {% endblock %}
</head>
{# Section active de la navigation (aria-current) d'après le préfixe de la route courante #}
{%- set _route = app.current_route ?? '' -%}
{%- if _route == 'app_home' -%}{% set shell_section = 'home' %}
{%- elseif _route starts with 'app_forum' or _route starts with 'app_thread' -%}{% set shell_section = 'forum' %}
{%- elseif _route starts with 'app_group' -%}{% set shell_section = 'groups' %}
{%- elseif _route == 'app_leaderboard' -%}{% set shell_section = 'leaderboard' %}
{%- elseif _route starts with 'app_message' -%}{% set shell_section = 'messages' %}
{%- elseif _route starts with 'app_notification' -%}{% set shell_section = 'notifications' %}
{%- elseif _route == 'app_login' -%}{% set shell_section = 'login' %}
{%- elseif _route == 'app_register' -%}{% set shell_section = 'register' %}
{%- elseif app.user and (_route starts with 'app_todo' or _route starts with 'app_army' or _route starts with 'app_friendship'
        or ((_route starts with 'app_profil' or _route starts with 'app_gallery') and (app.current_route_parameters.username ?? app.user.username) == app.user.username)) -%}
    {% set shell_section = 'me' %}
{%- else -%}{% set shell_section = '' %}
{%- endif %}
<body class="min-h-screen flex flex-col bg-canvas text-fg has-bottom-bar">
    <a href="#main" class="skip-link">Aller au contenu</a>

    {% if app.user %}
    <div data-controller="heartbeat" data-heartbeat-url-value="{{ path('app_heartbeat') }}" data-heartbeat-interval-value="{{ constant('App\\Service\\PresenceService::HEARTBEAT_INTERVAL_MS') }}" hidden></div>
    {% endif %}

    {{ include('_partials/shell/_header.html.twig') }}

    {{ include('_partials/shell/_toasts.html.twig') }}

    {% if app.user and not app.user.verified %}
        {{ include('_partials/shell/_verify_email_banner.html.twig') }}
    {% endif %}

    <main id="main" tabindex="-1" class="flex-1 container-app py-8 focus:outline-none">
        {% block body %}{% endblock %}
    </main>

    {{ include('_partials/shell/_footer.html.twig') }}

    {{ include('_partials/shell/_bottom_bar.html.twig') }}

    {% if app.user %}
        {{ include('_partials/shell/_messenger.html.twig') }}
    {% endif %}
</body>
</html>
