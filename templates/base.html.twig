<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <script src="https://js.pusher.com/8.2.0/pusher.min.js"></script>
    <style>[x-cloak] { display: none !important; }</style>
    <title>{% block title %}HighlightForge{% endblock %}</title>
    {% block stylesheets %}
        {{ encore_entry_link_tags('app') }}
    {% endblock %}
    {% block javascripts %}
        {{ importmap('app') }}
    {% endblock %}
</head>
<body class="bg-gray-900 text-gray-100 min-h-screen flex flex-col">

    {# NAVBAR #}
    <nav class="bg-gray-800/95 border-b border-gray-700 px-4 sm:px-6 py-3 sm:py-4 sticky top-0 z-40 backdrop-blur" x-data="{ menuOpen: false }">
        <div class="max-w-7xl mx-auto flex flex-wrap justify-between items-center gap-3">
            <a href="{{ path('app_home') }}" class="text-lg sm:text-xl font-bold text-indigo-400 shrink-0">
                ⚔️ HighlightForge
            </a>

            <button @click="menuOpen = !menuOpen" class="md:hidden inline-flex items-center justify-center w-10 h-10 rounded-lg text-gray-300 hover:bg-gray-700 hover:text-white transition" aria-label="Ouvrir le menu" :aria-expanded="menuOpen">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
                </svg>
            </button>

            <div class="site-nav-links items-center gap-5 order-3 md:order-none w-full md:w-auto" :class="{ 'is-open': menuOpen }">
                <a href="{{ path('app_forum_index') }}" class="text-gray-300 hover:text-white transition text-sm py-2">
                    💬 Forum
                </a>

                <a href="{{ path('app_group_index') }}" class="relative text-gray-300 hover:text-white transition text-sm py-2">
                    👥 Groupes
                    <span id="group-notification-badge" class="hidden ml-1 bg-red-500 text-white text-xs rounded-full px-1.5 py-0.5 notification-blink"></span>
                </a>

                {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('admin') }}" class="text-gray-300 hover:text-white transition text-sm py-2">
                    👥 Admin
                </a>
                {% endif %}
            </div>

            <div class="flex gap-2 sm:gap-4 items-center">
                {% if app.user %}
                    <div class="relative" x-data="{ open: false }">
                        <button @click="if (!open) clearUserMenuNotifications(); open = !open"
                            class="relative flex items-center gap-2 text-gray-300 hover:text-white transition text-sm max-w-[13rem]">
                            <div class="relative shrink-0">
                                <div class="w-8 h-8 rounded-full bg-indigo-600 flex items-center justify-center font-bold text-sm">
                                    {% if app.user.avatar %}
                                        <img src="{{ asset('uploads/avatars/' ~ app.user.avatar) }}"
                                             class="w-8 h-8 rounded-full object-cover">
                                    {% else %}
                                        {{ app.user.username|first|upper }}
                                    {% endif %}
                                </div>
                                {% if pendingInvitationsCount > 0 %}
                                    <span class="absolute -top-1 -right-1 w-4 h-4 bg-red-500 rounded-full text-white text-xs flex items-center justify-center">
                                        {{ pendingInvitationsCount }}
                                    </span>
                                {% endif %}
                            </div>
                            <span class="truncate hidden sm:inline">{{ app.user.username }}</span>
                            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                            </svg>
                            <span id="user-menu-notification-badge"
                                  class="hidden absolute -top-1 -right-1 min-w-4 h-4 px-1 bg-red-500 rounded-full text-white text-[10px] leading-4 text-center notification-blink"></span>
                        </button>

                        <div x-show="open"
                             @click.outside="open = false"
                             x-transition
                             class="absolute right-0 mt-2 w-48 bg-gray-800 border border-gray-700 rounded-xl shadow-lg z-50">
                            <div class="py-2">
                                <div class="px-4 pb-3 mb-1 border-b border-gray-700">
                                    <div class="flex items-center justify-between text-xs mb-1">
                                        <span class="text-indigo-300 font-semibold">Niveau {{ app.user.level }}</span>
                                        <span class="text-gray-500">{{ app.user.experience }} XP</span>
                                    </div>
                                    <div class="h-1.5 bg-gray-700 rounded-full overflow-hidden" title="Progression vers le niveau suivant">
                                        <div class="h-full bg-indigo-500" style="width: {{ app.user.experienceProgress }}%"></div>
                                    </div>
                                </div>
                                <a href="{{ path('app_profil_show', {username: app.user.username}) }}"
                                   class="flex items-center justify-between px-4 py-2 text-gray-300 hover:text-white hover:bg-gray-700 transition text-sm">
                                    <span>👤 Mon profil</span>
                                    {% if pendingInvitationsCount > 0 %}
                                        <span class="w-5 h-5 bg-red-500 rounded-full text-white text-xs flex items-center justify-center">
                                            {{ pendingInvitationsCount }}
                                        </span>
                                    {% endif %}
                                </a>
                                <a href="{{ path('app_todo_index') }}" class="flex items-center gap-3 px-4 py-2 text-gray-300 hover:text-white hover:bg-gray-700 transition text-sm">📋 Todo liste</a>
                                <a href="{{ path('app_army_index') }}" class="flex items-center gap-3 px-4 py-2 text-gray-300 hover:text-white hover:bg-gray-700 transition text-sm">⚔️ Listes d'armées</a>
                                <a href="{{ path('app_friendship_list') }}" onclick="clearFriendNotifications()" class="flex items-center justify-between gap-3 px-4 py-2 text-gray-300 hover:text-white hover:bg-gray-700 transition text-sm"> <span>👥 Mes amis</span><span id="friend-notification-badge" class="hidden bg-red-500 text-white text-xs rounded-full px-1.5 py-0.5 notification-blink"></span></a>
                                <a href="{{ path('app_message_index') }}" onclick="clearPrivateNotifications()" class="flex items-center justify-between gap-3 px-4 py-2 text-gray-300 hover:text-white hover:bg-gray-700 transition text-sm"> <span>✉️ Messages</span><span id="message-menu-badge" class="hidden bg-red-500 text-white text-xs rounded-full px-1.5 py-0.5 notification-blink"></span></a>
                                <div class="border-t border-gray-700 my-1"></div>
                                <a href="{{ path('app_logout') }}" class="flex items-center gap-3 px-4 py-2 text-red-400 hover:text-red-300 hover:bg-gray-700 transition text-sm">🚪 Déconnexion</a>
                            </div>
                        </div>
                    </div>
                {% else %}
                    <a href="{{ path('app_login') }}" class="bg-indigo-600 hover:bg-indigo-700 px-3 sm:px-4 py-2 rounded-lg text-sm transition">Connexion</a>
                    <a href="{{ path('app_register') }}" class="hidden sm:inline-block bg-green-600 hover:bg-green-700 px-4 py-2 rounded-lg text-sm transition">Inscription</a>
                {% endif %}
            </div>
        </div>
    </nav>

    {# FLASH MESSAGES #}
    {% set flashes = app.flashes %}
    {% if flashes is not empty %}
        <div id="flash-container" class="fixed top-20 left-1/2 -translate-x-1/2 z-50 w-full max-w-lg px-6">
            {% for type, messages in flashes %}
                {% for message in messages %}
                    <div class="flash-message mb-2 px-4 py-3 rounded shadow-lg flex items-center justify-between gap-4
                        {% if type == 'success' %}bg-green-700
                        {% elseif type == 'error' %}bg-red-700
                        {% else %}bg-blue-700{% endif %}">
                        <span>{{ message }}</span>
                        <button onclick="this.parentElement.remove()"
                                class="text-white/70 hover:text-white text-lg leading-none shrink-0">
                            ✕
                        </button>
                    </div>
                {% endfor %}
            {% endfor %}
        </div>

        <script>
        (function() {
            const messages = document.querySelectorAll('.flash-message');
            messages.forEach((msg, index) => {
                // Disparition progressive après 4 secondes (décalé selon l'index)
                setTimeout(() => {
                    msg.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
                    msg.style.opacity = '0';
                    msg.style.transform = 'translateY(-10px)';
                    setTimeout(() => msg.remove(), 500);
                }, 4000 + (index * 500));
            });
        })();
        </script>
    {% endif %}

    {# CONTENU PRINCIPAL #}
    <main class="flex-1 max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8 py-8">
        {% block body %}{% endblock %}
    </main>

    {# FOOTER #}
    <footer class="bg-gray-800 border-t border-gray-700 text-center text-gray-500 text-sm py-4">
        © {{ "now"|date("Y") }} HighlightForge — Communauté Miniaturiste
    </footer>

    {% if app.user %}
    {# ─── MESSENGER ─────────────────────────────────────────── #}
    <div id="messenger" class="fixed bottom-0 right-2 sm:right-4 z-50 flex items-end gap-2 max-w-[calc(100vw-1rem)]">

        {# BOUTON FLECHE GAUCHE #}
        <button id="messenger-prev"
                class="hidden self-end mb-1 w-8 h-8 bg-gray-700 hover:bg-gray-600 rounded-full text-white text-sm transition">
            ◀
        </button>

        {# ONGLETS CONVERSATIONS (à gauche, générés dynamiquement) #}
        <div id="messenger-conv-tabs" class="flex items-end gap-2"></div>

        {# BOUTON FLECHE DROITE #}
        <button id="messenger-next"
                class="hidden self-end mb-1 w-8 h-8 bg-gray-700 hover:bg-gray-600 rounded-full text-white text-sm transition">
            ▶
        </button>

        {# ONGLET PRINCIPAL (toujours à droite) #}
        <div id="messenger-main" class="w-[min(16rem,calc(100vw-1rem))]">
            <div class="bg-gray-800 border border-gray-700 border-b-0 rounded-t-xl">
                <div class="flex justify-between items-center px-4 py-3 cursor-pointer"
                     onclick="toggleMessengerMain()">
                    <span class="font-semibold text-white text-sm flex items-center gap-2">
                        💬 Messages
                        <span id="messenger-badge"
                            class="hidden bg-red-500 text-white text-xs rounded-full px-1.5 py-0.5 notification-blink">
                        </span>
                    </span>
                    <span id="messenger-main-arrow" class="text-gray-400 text-xs">▲</span>
                </div>
                <div id="messenger-main-body" class="hidden border-t border-gray-700 max-h-80 overflow-y-auto">
                    <div id="messenger-conversations" class="p-2 space-y-1">
                        <div class="text-gray-500 text-sm text-center py-4">Chargement...</div>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <script>
    (function() {

        // ─── État ─────────────────────────────────────────────
        const state = {
            mainOpen: false,
            openConvs: [],      // { username, avatar, convId, open, messages, loaded, unread }
            visibleStart: 0,
            maxVisible: 3,
            globalSource: null,
        };

        const notificationState = {
            privateMessages: 0,
            friendRequests: 0,
            userMenuNotifications: 0,
            groupMessages: JSON.parse(localStorage.getItem('hf-group-notifications') || '{}'),
        };

        function groupNotificationCount() {
            return Object.values(notificationState.groupMessages).reduce((total, count) => total + count, 0);
        }

        function saveGroupNotifications() {
            localStorage.setItem('hf-group-notifications', JSON.stringify(notificationState.groupMessages));
        }

        function renderNotifications() {
            const privateBadge = document.getElementById('message-menu-badge');
            const friendBadge = document.getElementById('friend-notification-badge');
            const groupBadge = document.getElementById('group-notification-badge');
            const messengerBadge = document.getElementById('messenger-badge');
            const userMenuBadge = document.getElementById('user-menu-notification-badge');
            const total = notificationState.privateMessages + notificationState.friendRequests;
            const groupTotal = groupNotificationCount();

            [[privateBadge, notificationState.privateMessages], [friendBadge, notificationState.friendRequests], [groupBadge, groupTotal]].forEach(([badge, count]) => {
                if (!badge) return;
                badge.textContent = count > 0 ? count : '';
                badge.classList.toggle('hidden', count === 0);
            });

            if (messengerBadge) {
                messengerBadge.textContent = total > 0 ? total : '';
                messengerBadge.classList.toggle('hidden', total === 0);
            }

            if (userMenuBadge) {
                userMenuBadge.textContent = notificationState.userMenuNotifications > 0
                    ? notificationState.userMenuNotifications
                    : '';
                userMenuBadge.classList.toggle('hidden', notificationState.userMenuNotifications === 0);
            }
        }

        function notifyUserMenu(count = 1) {
            notificationState.userMenuNotifications += count;
            renderNotifications();
        }

        window.clearUserMenuNotifications = function() {
            notificationState.userMenuNotifications = 0;
            renderNotifications();
        };

        window.clearPrivateNotifications = function() {
            notificationState.privateMessages = 0;
            renderNotifications();
        };

        window.clearFriendNotifications = function() {
            notificationState.friendRequests = 0;
            renderNotifications();
        };

        window.clearGroupNotifications = function() {
            notificationState.groupMessages = {};
            saveGroupNotifications();
            renderNotifications();
        };

        window.clearGroupNotification = function(slug) {
            if (!slug || !notificationState.groupMessages[slug]) return;
            delete notificationState.groupMessages[slug];
            saveGroupNotifications();
            renderNotifications();
        };

        // ─── Init Pusher global ────────────────────────────────
        // S'abonne à toutes les conversations existantes pour recevoir
        // les notifications même sans ouvrir le messenger
            function initGlobalPusher() {
                if (window.activeGroupSlug) {
                    clearGroupNotification(window.activeGroupSlug);
                }

            const pusher = new Pusher('{{ pusher_key }}', {
                cluster: '{{ pusher_cluster }}'
            });

            const userChannel = pusher.subscribe('user-{{ app.user.id }}');
            userChannel.bind('friend-request', function() {
                notificationState.friendRequests++;
                notifyUserMenu();
            });
            userChannel.bind('group-message', function(data) {
                if (!data.slug || window.activeGroupSlug === data.slug) return;
                notificationState.groupMessages[data.slug] = (notificationState.groupMessages[data.slug] || 0) + 1;
                saveGroupNotifications();
                renderNotifications();
            });

            fetch('/messages/ajax/notification-context')
                .then(r => r.json())
                .then(context => {
                    const unreadMessages = context.unreadMessages || 0;
                    const pendingFriendships = context.pendingFriendships || 0;
                    notificationState.privateMessages = Math.max(notificationState.privateMessages, unreadMessages);
                    notificationState.friendRequests = Math.max(notificationState.friendRequests, pendingFriendships);
                    notificationState.userMenuNotifications = Math.max(
                        notificationState.userMenuNotifications,
                        unreadMessages + pendingFriendships
                    );
                    renderNotifications();
                });

            fetch('/messages/ajax/conversation-ids')
                .then(r => r.json())
                .then(ids => {
                    if (ids.length === 0) return;

                    ids.forEach(id => {
                        const channel = pusher.subscribe('conversation-' + id);

                        channel.bind('new-message', function(data) {
                            // Ignorer nos propres messages
                            if (data.author === '{{ app.user.username }}') return;

                            const conv = state.openConvs.find(c => c.convId === data.conversationId);

                            if (conv && conv.open) {
                                // Une conversation dépliée garde sa notification sur son onglet.
                                conv.unread = (conv.unread || 0) + 1;
                                data.isCurrentUser = false;
                                conv.messages.push(data);
                                renderTabs();
                                if (conv.open) {
                                    setTimeout(() => {
                                        const chatEl = document.getElementById(`chat-${conv.username}`);
                                        if (chatEl) chatEl.scrollTop = chatEl.scrollHeight;
                                    }, 50);
                                }
                            } else {
                                // Conversation fermée ou absente → badge sur l'onglet principal.
                                notificationState.privateMessages++;
                                notifyUserMenu();
                            }
                        });
                    });
                });
        }

        // ─── Badge onglet principal ────────────────────────────
        function resetMainBadge() {
            clearPrivateNotifications();
        }

        // ─── Toggle onglet principal ───────────────────────────
        window.toggleMessengerMain = function() {
            state.mainOpen = !state.mainOpen;
            const body = document.getElementById('messenger-main-body');
            const arrow = document.getElementById('messenger-main-arrow');

            if (state.mainOpen) {
                body.classList.remove('hidden');
                arrow.textContent = '▼';
                loadConversations();
                resetMainBadge();
            } else {
                body.classList.add('hidden');
                arrow.textContent = '▲';
            }
        };

        // ─── Charger la liste des conversations ───────────────
        function loadConversations() {
            fetch('/messages/ajax/conversations')
                .then(r => r.json())
                .then(data => {
                    const container = document.getElementById('messenger-conversations');

                    if (data.length === 0) {
                        container.innerHTML = '<div class="text-gray-500 text-sm text-center py-4">Aucune conversation</div>';
                        return;
                    }

                    container.innerHTML = data.map(conv => `
                        <div class="flex items-center gap-3 px-2 py-2 rounded-lg hover:bg-gray-700 cursor-pointer transition group"
                             onclick="openConversation('${conv.username}', '${conv.avatar || ''}', ${conv.id})">
                            <div class="w-8 h-8 rounded-full bg-indigo-600 flex items-center justify-center text-xs font-bold shrink-0">
                                ${conv.avatar
                                    ? `<img src="/uploads/avatars/${conv.avatar}" class="w-8 h-8 rounded-full object-cover">`
                                    : conv.username.charAt(0).toUpperCase()
                                }
                            </div>
                            <div class="flex-1 min-w-0">
                                <div class="text-sm font-semibold text-white">${conv.username}</div>
                                <div class="text-xs text-gray-400 truncate">${conv.lastMessage}</div>
                            </div>
                            <div class="flex items-center gap-1 shrink-0">
                                ${conv.unread > 0
                                    ? `<span class="bg-red-500 text-white text-xs rounded-full px-1.5">${conv.unread}</span>`
                                    : ''
                                }
                            </div>
                        </div>
                    `).join('');

                });
        }

        // ─── Ouvrir une conversation ───────────────────────────
        window.openConversation = function(username, avatar, convId) {
            // Déjà ouverte → juste déplier
            const existing = state.openConvs.find(c => c.username === username);
            if (existing) {
                existing.open = true;
                existing.unread = 0;
                renderTabs();
                setTimeout(() => {
                    const chatEl = document.getElementById(`chat-${username}`);
                    if (chatEl) chatEl.scrollTop = chatEl.scrollHeight;
                }, 50);
                return;
            }

            state.openConvs.push({
                username,
                avatar,
                convId,
                open: true,
                messages: [],
                loaded: false,
                unread: 0,
            });

            state.visibleStart = Math.max(0, state.openConvs.length - state.maxVisible);
            renderTabs();
            loadMessages(username);

            if (state.mainOpen) toggleMessengerMain();
        };

        // ─── Charger les messages ──────────────────────────────
        function loadMessages(username) {
            fetch(`/messages/ajax/messages/${username}`)
                .then(r => r.json())
                .then(data => {
                    const conv = state.openConvs.find(c => c.username === username);
                    if (!conv) return;

                    conv.messages = data.messages || [];
                    conv.convId = data.conversationId;
                    conv.loaded = true;
                    conv.unread = 0;

                    renderTabs();

                    setTimeout(() => {
                        const chatEl = document.getElementById(`chat-${username}`);
                        if (chatEl) chatEl.scrollTop = chatEl.scrollHeight;
                    }, 50);
                });
        }

        // ─── Fermer une conversation ───────────────────────────
        window.closeConversation = function(username) {
            const idx = state.openConvs.findIndex(c => c.username === username);
            if (idx !== -1) {
                state.openConvs.splice(idx, 1);
                state.visibleStart = Math.min(
                    state.visibleStart,
                    Math.max(0, state.openConvs.length - state.maxVisible)
                );
            }
            renderTabs();
        };

        // ─── Toggle une conversation (déplier/replier) ─────────
        window.toggleConversation = function(username) {
            const conv = state.openConvs.find(c => c.username === username);
            if (!conv) return;

            conv.open = !conv.open;

            // Si on déplie → marquer comme lu
            if (conv.open) {
                conv.unread = 0;
                // Marquer comme lus côté serveur
                if (conv.convId) {
                    fetch(`/messages/ajax/messages/${username}`);
                }
            }

            renderTabs();

            if (conv.open) {
                setTimeout(() => {
                    const chatEl = document.getElementById(`chat-${username}`);
                    if (chatEl) chatEl.scrollTop = chatEl.scrollHeight;
                }, 50);
            }
        };

        // ─── Envoyer un message ────────────────────────────────
        window.sendMessage = function(username, inputId) {
            const input = document.getElementById(inputId);
            const content = input.value.trim();
            if (!content) return;

            input.value = '';

            fetch(`/messages/ajax/send/${username}`, {
                method: 'POST',
                body: new URLSearchParams({ content }),
            })
            .then(r => r.json())
            .then(data => {
                if (data.error) {
                    console.error(data.error);
                    return;
                }

                const conv = state.openConvs.find(c => c.username === username);
                if (!conv) return;

                if (!conv.convId && data.conversationId) {
                    conv.convId = data.conversationId;
                }

                data.isCurrentUser = true;
                conv.messages.push(data);
                renderTabs();

                setTimeout(() => {
                    const chatEl = document.getElementById(`chat-${username}`);
                    if (chatEl) chatEl.scrollTop = chatEl.scrollHeight;
                }, 50);
            });
        };

        // ─── Navigation carousel ──────────────────────────────
        document.getElementById('messenger-prev').addEventListener('click', () => {
            if (state.visibleStart > 0) {
                state.visibleStart--;
                renderTabs();
            }
        });

        document.getElementById('messenger-next').addEventListener('click', () => {
            if (state.visibleStart + state.maxVisible < state.openConvs.length) {
                state.visibleStart++;
                renderTabs();
            }
        });

        // ─── Rendu des onglets ─────────────────────────────────
        function renderTabs() {
            const container = document.getElementById('messenger-conv-tabs');
            const prevBtn = document.getElementById('messenger-prev');
            const nextBtn = document.getElementById('messenger-next');

            // Flèches
            const needArrows = state.openConvs.length > state.maxVisible;
            prevBtn.classList.toggle('hidden', !needArrows || state.visibleStart === 0);
            nextBtn.classList.toggle('hidden', !needArrows || state.visibleStart + state.maxVisible >= state.openConvs.length);

            const visible = state.openConvs.slice(state.visibleStart, state.visibleStart + state.maxVisible);

            container.innerHTML = visible.map(conv => {
                const avatarHtml = conv.avatar
                    ? `<img src="/uploads/avatars/${conv.avatar}" class="w-6 h-6 rounded-full object-cover">`
                    : `<span class="text-xs font-bold">${conv.username.charAt(0).toUpperCase()}</span>`;

                const messagesHtml = conv.loaded
                    ? (conv.messages.length > 0
                        ? conv.messages.map(msg => `
                            <div class="flex gap-2 ${msg.isCurrentUser ? 'flex-row-reverse' : ''}">
                                <div class="px-3 py-1.5 rounded-xl text-xs max-w-xs break-words ${msg.isCurrentUser ? 'bg-indigo-600 text-white' : 'bg-gray-600 text-gray-200'}">
                                    ${msg.content}
                                </div>
                            </div>
                        `).join('')
                        : '<div class="text-gray-500 text-xs text-center py-4">Commencez la conversation !</div>'
                    )
                    : '<div class="text-gray-500 text-xs text-center py-4">Chargement...</div>';

                const unreadBadge = conv.unread > 0
                    ? `<span class="w-4 h-4 bg-red-500 rounded-full text-white text-xs flex items-center justify-center">${conv.unread}</span>`
                    : '';

                return `
                    <div class="w-64">
                        <div class="bg-gray-800 border border-gray-700 border-b-0 rounded-t-xl shadow-lg">

                            {# Header #}
                            <div class="flex justify-between items-center px-3 py-2 cursor-pointer hover:bg-gray-700 rounded-t-xl transition"
                                 onclick="toggleConversation('${conv.username}')">
                                <div class="flex items-center gap-2">
                                    <div class="w-6 h-6 rounded-full bg-indigo-600 flex items-center justify-center shrink-0">
                                        ${avatarHtml}
                                    </div>
                                    <span class="text-sm font-semibold text-white">${conv.username}</span>
                                    ${unreadBadge}
                                </div>
                                <div class="flex items-center gap-1">
                                    <span class="text-gray-400 text-xs">${conv.open ? '▼' : '▲'}</span>
                                    <button onclick="event.stopPropagation(); closeConversation('${conv.username}')"
                                            class="text-gray-400 hover:text-red-400 text-xs ml-1 transition">✕</button>
                                </div>
                            </div>

                            {# Corps #}
                            ${conv.open ? `
                                <div class="border-t border-gray-700">
                                    <div id="chat-${conv.username}"
                                         class="h-64 overflow-y-auto p-3 space-y-2">
                                        ${messagesHtml}
                                    </div>
                                    <div class="p-2 border-t border-gray-700 flex gap-2">
                                        <input id="input-${conv.username}"
                                               type="text"
                                               placeholder="Message..."
                                               autocomplete="off"
                                               onkeydown="if(event.key==='Enter'){ sendMessage('${conv.username}', 'input-${conv.username}') }"
                                               class="flex-1 bg-gray-700 border border-gray-600 rounded-lg px-2 py-1 text-xs text-white focus:outline-none focus:border-indigo-500">
                                        <button onclick="sendMessage('${conv.username}', 'input-${conv.username}')"
                                                class="bg-indigo-600 hover:bg-indigo-700 px-2 py-1 rounded text-xs text-white transition">
                                            ➤
                                        </button>
                                    </div>
                                </div>
                            ` : ''}

                        </div>
                    </div>
                `;
            }).join('');
        }

        // ─── Initialisation ───────────────────────────────────
        loadConversations();
        initGlobalPusher();

    })();
    </script>
    {% endif %}

</body>
</html>