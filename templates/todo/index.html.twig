{% extends "base.html.twig" %}

{% block title %}Mes Todo Lists{% endblock %}

{% block body %}
<div class="max-w-5xl mx-auto">

    <div class="flex justify-between items-center mb-8">
        <h1 class="text-3xl font-bold text-white">📋 Mes Todo Lists</h1>
    </div>

    <div class="space-y-6">

        {# LISTES / PROJETS EXISTANTS #}
        {% for list in lists %}
            {% set totalTasks = 0 %}
            {% set completedTasks = 0 %}
            {% set totalProgressSum = 0 %}

            {% for category in list.children %}
                {% set totalTasks = totalTasks + category.children|length %}
                {% for item in category.children %}
                    {% set totalProgressSum = totalProgressSum + (item.progress ?? (item.isDone ? 100 : 0)) %}
                    {% if item.isDone or (item.progress ?? 0) >= 100 %}
                        {% set completedTasks = completedTasks + 1 %}
                    {% endif %}
                {% endfor %}
            {% endfor %}

            {% set projectProgress = totalTasks > 0 ? (totalProgressSum / totalTasks)|round : 0 %}

            <div class="bg-gray-800 rounded-xl border border-gray-700 overflow-hidden shadow-lg transition-all duration-200" 
                 id="list-{{ list.id }}"
                 x-data="{ open: true }">

                {# HEADER DU PROJET (CLIQUABLE POUR DÉROULER) #}
                <div class="p-5 bg-gray-800/95 border-b border-gray-700/80">
                    <div class="flex items-center justify-between gap-4">
                        <div class="flex items-center gap-3 flex-1 min-w-0 cursor-pointer select-none" @click="open = !open">
                            <button type="button" class="text-gray-400 hover:text-white transition-transform duration-200 shrink-0"
                                    :class="{ 'rotate-180': open }">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                                </svg>
                            </button>
                            <div class="min-w-0 flex-1">
                                <div class="flex items-center gap-3">
                                    <h2 class="text-xl font-bold text-indigo-400 truncate"
                                        ondblclick="event.stopPropagation(); startRename({{ list.id }}, this, '{{ list.title|e('js') }}')">
                                        📁 {{ list.title }}
                                    </h2>
                                    <span class="text-xs px-2.5 py-0.5 rounded-full bg-gray-700 text-gray-300 font-medium shrink-0">
                                        {{ completedTasks }}/{{ totalTasks }} tâches
                                    </span>
                                </div>
                            </div>
                        </div>

                        <div class="flex items-center gap-3 shrink-0">
                            <form method="post" action="{{ path('app_todo_delete', {id: list.id}) }}"
                                  onsubmit="return confirm('Supprimer ce projet et tout son contenu ?')">
                                <input type="hidden" name="_token" value="{{ csrf_token('todo') }}">
                                <button type="submit" class="text-gray-400 hover:text-red-400 p-1.5 rounded-lg hover:bg-gray-700 transition" title="Supprimer le projet">
                                    🗑️
                                </button>
                            </form>
                        </div>
                    </div>

                    {# BARRE DE PROGRESSION GLOBALE DU PROJET #}
                    <div class="mt-4">
                        <div class="flex justify-between items-center text-xs mb-1.5">
                            <span class="text-gray-400 font-medium">Progression globale du projet</span>
                            <span class="text-indigo-400 font-bold text-sm" id="project-progress-text-{{ list.id }}">{{ projectProgress }}%</span>
                        </div>
                        <div class="w-full h-2.5 bg-gray-700 rounded-full overflow-hidden p-0.5">
                            <div class="h-full bg-gradient-to-r from-indigo-500 to-emerald-500 rounded-full transition-all duration-300"
                                 id="project-progress-bar-{{ list.id }}"
                                 style="width: {{ projectProgress }}%"></div>
                        </div>
                    </div>
                </div>

                {# CONTENU DU PROJET (DÉROULANT) #}
                <div x-show="open" x-transition.opacity.duration.200ms class="p-5 space-y-5 bg-gray-900/30">

                    {# CATEGORIES ET TACHES #}
                    {% for category in list.children %}
                        <div class="bg-gray-900/60 border border-gray-700/60 rounded-xl p-4 shadow-sm" id="category-{{ category.id }}">

                            {# HEADER CATEGORIE #}
                            <div class="flex justify-between items-center mb-3 pb-2 border-b border-gray-800">
                                <h3 class="text-sm font-semibold text-gray-300 cursor-pointer flex items-center gap-2"
                                    ondblclick="startRename({{ category.id }}, this, '{{ category.title|e('js') }}')">
                                    <span>📂</span>
                                    <span>{{ category.title }}</span>
                                </h3>
                                <form method="post" action="{{ path('app_todo_delete', {id: category.id}) }}"
                                      onsubmit="return confirm('Supprimer cette catégorie ?')">
                                    <input type="hidden" name="_token" value="{{ csrf_token('todo') }}">
                                    <button type="submit" class="text-gray-500 hover:text-red-400 text-xs p-1 transition" title="Supprimer la catégorie">
                                        🗑️
                                    </button>
                                </form>
                            </div>

                            {# LISTE DES TACHES #}
                            <div class="space-y-2.5 mb-3">
                                {% for item in category.children %}
                                    {% set isItemDone = item.isDone or (item.progress ?? 0) >= 100 %}
                                    <div class="rounded-lg p-3 border transition-all duration-200 group {{ isItemDone ? 'bg-gray-900/40 border-gray-800/80 opacity-60' : 'bg-gray-800/90 border-gray-700/80 hover:border-gray-600' }}"
                                         id="item-{{ item.id }}"
                                         data-project-id="{{ list.id }}"
                                         data-progress="{{ item.progress ?? (item.isDone ? 100 : 0) }}"
                                         data-is-done="{{ isItemDone ? '1' : '0' }}">

                                        {# TITRE AVEC EXPANSION AU CLIC SI TROP LONG #}
                                        <div x-data="{ expanded: false }" class="mb-2">
                                            <div class="flex items-start justify-between gap-2">
                                                <div class="flex-1 min-w-0 cursor-pointer select-none"
                                                     @click="expanded = !expanded"
                                                     ondblclick="event.stopPropagation(); startRename({{ item.id }}, this, '{{ item.title|e('js') }}')">
                                                    <p class="text-sm font-medium transition-colors {{ isItemDone ? 'line-through text-gray-500' : 'text-gray-200' }}"
                                                       :class="{ 'truncate': !expanded, 'break-words whitespace-normal': expanded }"
                                                       title="Cliquez pour afficher/masquer le texte complet">
                                                        {{ item.title }}
                                                    </p>
                                                </div>

                                                <span class="text-xs font-bold px-2 py-0.5 rounded {{ isItemDone ? 'bg-emerald-950/80 text-emerald-400 border border-emerald-800/50' : 'bg-gray-700 text-gray-300' }} shrink-0"
                                                      id="item-badge-{{ item.id }}">
                                                    {{ item.progress ?? (item.isDone ? 100 : 0) }}%
                                                </span>
                                            </div>
                                        </div>

                                        {# BARRE DE PROGRESSION DE LA TACHE #}
                                        <div class="w-full h-1.5 bg-gray-700 rounded-full overflow-hidden mb-3">
                                            <div class="h-full bg-emerald-500 transition-all duration-200"
                                                 id="item-progress-bar-{{ item.id }}"
                                                 style="width: {{ item.progress ?? (item.isDone ? 100 : 0) }}%"></div>
                                        </div>

                                        {# BOUTONS DE CONTROLE (+ / - / VALIDER / SUPPRIMER) #}
                                        <div class="flex items-center justify-between gap-2 pt-1 border-t border-gray-700/40">
                                            <div class="flex items-center gap-1.5">
                                                <button type="button" 
                                                        onclick="updateProgress({{ item.id }}, -25, {{ list.id }})" 
                                                        title="Diminuer la progression (-25%)"
                                                        class="w-7 h-7 rounded bg-gray-700 hover:bg-gray-600 text-gray-200 font-bold flex items-center justify-center text-sm transition shadow-sm">
                                                    −
                                                </button>
                                                <button type="button" 
                                                        onclick="updateProgress({{ item.id }}, 25, {{ list.id }})" 
                                                        title="Augmenter la progression (+25%)"
                                                        class="w-7 h-7 rounded bg-gray-700 hover:bg-gray-600 text-gray-200 font-bold flex items-center justify-center text-sm transition shadow-sm">
                                                    +
                                                </button>
                                                <button type="button" 
                                                        onclick="validateTask({{ item.id }}, {{ list.id }})" 
                                                        title="Valider la tâche (100%)"
                                                        class="px-2.5 h-7 rounded {{ isItemDone ? 'bg-emerald-700 text-white' : 'bg-emerald-600 hover:bg-emerald-500 text-white' }} font-medium flex items-center gap-1 text-xs transition shadow-sm">
                                                    <span>✓</span>
                                                    <span>Valider</span>
                                                </button>
                                            </div>

                                            <form method="post" action="{{ path('app_todo_delete', {id: item.id}) }}" class="m-0">
                                                <input type="hidden" name="_token" value="{{ csrf_token('todo') }}">
                                                <button type="submit" 
                                                        title="Supprimer la tâche" 
                                                        class="w-7 h-7 rounded bg-red-500/15 hover:bg-red-600 text-red-400 hover:text-white flex items-center justify-center text-xs font-bold transition">
                                                    ✕
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                {% else %}
                                    <p class="text-xs text-gray-500 italic py-1">Aucune tâche dans cette catégorie.</p>
                                {% endfor %}
                            </div>

                            {# FORMULAIRE AJOUT TACHE #}
                            <form method="post" action="{{ path('app_todo_create') }}" class="flex gap-2 mt-2">
                                <input type="hidden" name="type" value="item">
                                <input type="hidden" name="parent_id" value="{{ category.id }}">
                                <input type="text" name="title" placeholder="+ Ajouter une tâche..." required
                                       class="flex-1 bg-gray-800 border border-gray-700 rounded-lg px-3 py-1.5 text-sm text-white placeholder-gray-500 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500">
                                <button type="submit"
                                        class="bg-indigo-600 hover:bg-indigo-700 px-3 py-1.5 rounded-lg text-sm text-white font-medium transition shadow-sm">
                                    Ajouter
                                </button>
                            </form>
                        </div>
                    {% endfor %}

                    {# FORMULAIRE AJOUT CATEGORIE #}
                    <form method="post" action="{{ path('app_todo_create') }}" class="flex gap-2 pt-2 border-t border-gray-700/60">
                        <input type="hidden" name="type" value="category">
                        <input type="hidden" name="parent_id" value="{{ list.id }}">
                        <input type="text" name="title" placeholder="+ Nouvelle catégorie..." required
                               class="flex-1 bg-gray-900/60 border border-gray-700 rounded-lg px-3 py-2 text-sm text-white placeholder-gray-500 focus:outline-none focus:border-indigo-500">
                        <button type="submit"
                                class="bg-gray-700 hover:bg-gray-600 text-gray-200 px-4 py-2 rounded-lg text-sm font-medium transition">
                            + Catégorie
                        </button>
                    </form>

                </div>
            </div>
        {% endfor %}

        {# CRÉER UN NOUVEAU PROJET / LISTE #}
        <div class="bg-gray-800/60 rounded-xl border border-dashed border-gray-700 p-6 text-center">
            <h3 class="text-base font-semibold text-gray-300 mb-3">Créer un nouveau projet</h3>
            <form method="post" action="{{ path('app_todo_create') }}" class="flex gap-2 max-w-xl mx-auto">
                <input type="hidden" name="type" value="list">
                <input type="text" name="title" placeholder="Ex: Peinture Ork, Décors Médiévaux..." required
                       class="flex-1 bg-gray-900 border border-gray-700 rounded-lg px-4 py-2 text-sm text-white placeholder-gray-500 focus:outline-none focus:border-indigo-500">
                <button type="submit"
                        class="bg-indigo-600 hover:bg-indigo-700 px-5 py-2 rounded-lg text-sm text-white font-semibold transition shadow-md">
                    Créer le projet
                </button>
            </form>
        </div>

    </div>
</div>

<script>
function refreshProjectProgress(projectId) {
    const projectItems = document.querySelectorAll(`[data-project-id="${projectId}"]`);
    if (!projectItems.length) return;

    let sum = 0;
    projectItems.forEach(item => {
        sum += parseInt(item.getAttribute('data-progress') || '0', 10);
    });

    const avg = Math.round(sum / projectItems.length);
    const textEl = document.getElementById(`project-progress-text-${projectId}`);
    const barEl = document.getElementById(`project-progress-bar-${projectId}`);

    if (textEl) textEl.textContent = avg + '%';
    if (barEl) barEl.style.width = avg + '%';
}

function updateProgress(id, delta, projectId) {
    fetch(`/todo/progress/${delta > 0 ? "up" : "down"}/${id}`, {
        method: "POST",
        headers: {"Content-Type": "application/x-www-form-urlencoded"},
        body: "_token={{ csrf_token("todo") }}"
    })
    .then(r => r.json())
    .then(data => {
        applyTaskState(id, data.progress, data.isDone, projectId);
    });
}

function validateTask(id, projectId) {
    fetch(`/todo/progress/validate/${id}`, {
        method: "POST",
        headers: {"Content-Type": "application/x-www-form-urlencoded"},
        body: "_token={{ csrf_token("todo") }}"
    })
    .then(r => r.json())
    .then(data => {
        applyTaskState(id, data.progress, data.isDone, projectId);
    });
}

function applyTaskState(id, progress, isDone, projectId) {
    const itemDiv = document.getElementById(`item-${id}`);
    if (!itemDiv) return;

    itemDiv.setAttribute('data-progress', progress);
    itemDiv.setAttribute('data-is-done', isDone ? '1' : '0');

    const progressBar = document.getElementById(`item-progress-bar-${id}`);
    const badge = document.getElementById(`item-badge-${id}`);
    const titleP = itemDiv.querySelector('p');

    if (progressBar) progressBar.style.width = progress + "%";
    if (badge) badge.textContent = progress + "%";

    if (isDone || progress >= 100) {
        itemDiv.classList.add('opacity-60', 'bg-gray-900/40', 'border-gray-800/80');
        itemDiv.classList.remove('bg-gray-800/90', 'border-gray-700/80');
        if (titleP) {
            titleP.classList.add('line-through', 'text-gray-500');
            titleP.classList.remove('text-gray-200');
        }
        if (badge) {
            badge.className = "text-xs font-bold px-2 py-0.5 rounded bg-emerald-950/80 text-emerald-400 border border-emerald-800/50 shrink-0";
        }
    } else {
        itemDiv.classList.remove('opacity-60', 'bg-gray-900/40', 'border-gray-800/80');
        itemDiv.classList.add('bg-gray-800/90', 'border-gray-700/80');
        if (titleP) {
            titleP.classList.remove('line-through', 'text-gray-500');
            titleP.classList.add('text-gray-200');
        }
        if (badge) {
            badge.className = "text-xs font-bold px-2 py-0.5 rounded bg-gray-700 text-gray-300 shrink-0";
        }
    }

    if (projectId) {
        refreshProjectProgress(projectId);
    }
}

// Renommer via double-clic
function startRename(id, element, currentTitle) {
    const input = document.createElement("input");
    input.type = "text";
    input.value = currentTitle;
    input.className = "bg-gray-700 border border-indigo-500 rounded px-2 py-1 text-sm text-white w-full focus:outline-none";

    element.replaceWith(input);
    input.focus();
    input.select();

    function saveRename() {
        const newTitle = input.value.trim();
        if (!newTitle || newTitle === currentTitle) {
            input.replaceWith(element);
            return;
        }

        fetch(`/todo/rename/${id}`, {
            method: "POST",
            headers: {"Content-Type": "application/x-www-form-urlencoded"},
            body: `title=${encodeURIComponent(newTitle)}&_token={{ csrf_token("todo") }}`
        })
        .then(r => r.json())
        .then(data => {
            element.textContent = data.title;
            input.replaceWith(element);
        })
        .catch(() => {
            input.replaceWith(element);
        });
    }

    input.addEventListener("blur", saveRename);
    input.addEventListener("keydown", e => {
        if (e.key === "Enter") saveRename();
        if (e.key === "Escape") input.replaceWith(element);
    });
}
</script>

{% endblock %}
