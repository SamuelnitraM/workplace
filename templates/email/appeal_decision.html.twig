{% extends 'email/layout.html.twig' %}

{% block preheader %}La modération a examiné ta réclamation.{% endblock %}

{% block heading %}{{ appeal.status == 'lifted' ? 'Ta sanction est levée' : 'Ta sanction est maintenue' }}{% endblock %}

{% block content %}
    <p style="margin:0 0 20px 0;">Bonjour {{ recipient.username }},</p>
    <p style="margin:0 0 20px 0;">La modération a examiné ta réclamation du {{ appeal.createdAt|date('d/m/Y', 'Europe/Paris') }}.</p>
    <p style="margin:0 0 20px 0;padding:12px 16px;border-left:3px solid #4f46e5;background:#f4f5f8;white-space:pre-line;">{{ appeal.response }}</p>
    {% if appeal.status == 'lifted' %}
        <p style="margin:0 0 20px 0;">Tu peux à nouveau te connecter à ton compte.</p>
    {% else %}
        <p style="margin:0 0 20px 0;">{{ notice }}</p>
    {% endif %}
    <p style="margin:0 0 20px 0;font-size:14px;color:#5b6272;">Les règles de la communauté sont rappelées dans les <a href="{{ url('app_terms') }}" style="color:#4f46e5;">conditions d'utilisation</a>.</p>
{% endblock %}

{% block footer_note %}L'équipe de modération SprueHub{% endblock %}
