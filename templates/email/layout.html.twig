{# Shared layout of every e-mail (inline styles only: e-mail clients ignore stylesheets).
   Blocks: preheader (preview line in the inbox), heading, content, footer_note. #}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="color-scheme" content="light">
    <title>{{ subject|default('SprueHub') }}</title>
</head>
<body style="margin:0;padding:0;background-color:#f4f5f8;">
<span style="display:none;max-height:0;overflow:hidden;opacity:0;">{% block preheader %}{% endblock %}</span>
<div style="margin:0;padding:24px 12px;background-color:#f4f5f8;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#1f2430;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:520px;margin:0 auto;background-color:#ffffff;border:1px solid #e3e6ec;border-radius:12px;">
        <tr>
            <td style="padding:28px 28px 8px 28px;">
                <p style="margin:0 0 4px 0;font-size:12px;font-weight:600;letter-spacing:0.06em;text-transform:uppercase;color:#4f46e5;">SprueHub</p>
                <h1 style="margin:0;font-size:22px;line-height:1.3;font-weight:700;color:#1f2430;">{% block heading %}{% endblock %}</h1>
            </td>
        </tr>
        <tr>
            <td style="padding:12px 28px 0 28px;font-size:16px;line-height:1.6;color:#3d4454;">
                {% block content %}{% endblock %}
            </td>
        </tr>
        <tr>
            <td style="padding:0 28px 28px 28px;border-top:1px solid #e3e6ec;font-size:14px;line-height:1.5;color:#5b6272;">
                <p style="margin:16px 0 0 0;">{% block footer_note %}À bientôt sur SprueHub !{% endblock %}</p>
                <p style="margin:8px 0 0 0;font-size:12px;color:#8a90a0;">Cet e-mail t'a été envoyé automatiquement, merci de ne pas y répondre.</p>
            </td>
        </tr>
    </table>
</div>
</body>
</html>
