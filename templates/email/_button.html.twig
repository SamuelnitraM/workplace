{# Call-to-action button of an e-mail: expects "url" and "label". The raw URL is printed as a fallback link. #}
<p style="margin:0 0 20px 0;">
    <a href="{{ url }}" style="display:inline-block;padding:12px 22px;background-color:#4f46e5;color:#ffffff;font-weight:600;text-decoration:none;border-radius:8px;">{{ label }}</a>
</p>
<p style="margin:0 0 20px 0;font-size:13px;color:#5b6272;">Le bouton ne fonctionne pas ? Copie ce lien dans ton navigateur :<br><a href="{{ url }}" style="color:#4f46e5;word-break:break-all;">{{ url }}</a></p>
