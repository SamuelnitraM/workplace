{% extends 'base.html.twig' %}
{% import '_macros/ui.html.twig' as ui %}

{% block title %}Nouveau sujet — {{ category.name }}{% endblock %}

{% block body %}
<div class="mx-auto w-full max-w-2xl">

    <header class="page-header">
        <div class="min-w-0">
            {{ include('forum/_breadcrumb.html.twig', {category: category, link_last: true}) }}
            <h1 class="page-header-title">Nouveau sujet</h1>
            <p class="page-header-subtitle">Dans <span class="font-semibold text-fg">{{ category.name }}</span></p>
        </div>
    </header>

    {% if app.user and app.user.threads is empty %}
        <p class="mb-4 flex items-start gap-2 rounded-card border border-accent/30 bg-accent-soft px-3 py-2 text-small font-medium text-accent-text">
            {{- ui.icon('trophy', 'size-4 mt-0.5 shrink-0') }}<span>Votre premier sujet débloque le badge Pionnier I (+50 XP).</span>
        </p>
    {% endif %}

    <div class="card" {{ include('forum/_editor_attributes.html.twig', {draft_key: 'thread-' ~ category.id}) }}>
        {{ form_start(form) }}
            <div class="card-body space-y-5">
                {{ form_errors(form) }}
                {{ form_row(form.title, {
                    attr: form.title.vars.attr|merge({maxlength: 255, autofocus: true}),
                    help: 'Entre 5 et 255 caractères. Soyez précis : « Schéma de peinture pour Ultramarines » plutôt que « Besoin d\'aide ».',
                }) }}
                <div class="field">
                    {{ form_label(form.content) }}
                    {{ include('forum/_editor.html.twig', {field: form.content}) }}
                    <p class="help">10 caractères minimum. Détaillez votre question : figurines, peintures utilisées, ce que vous avez déjà essayé… Ajoutez des photos pour illustrer.</p>
                    {{ form_errors(form.content) }}
                </div>
            </div>

            <div class="card-footer flex-wrap">
                <a href="{{ path('app_forum_category', {slug: category.slug}) }}" class="btn btn-ghost">Annuler</a>
                <button type="submit" class="btn btn-primary">
                    {{- ui.icon('send') }}Publier le sujet
                </button>
            </div>
        {{ form_end(form) }}
    </div>

    <aside class="mt-6 card-inset p-4" aria-labelledby="thread-tips-title">
        <h2 id="thread-tips-title" class="mb-2 flex items-center gap-2 text-small font-semibold text-fg">{{ ui.icon('info', 'size-4 text-info-text') }}Pour obtenir de bonnes réponses</h2>
        <ul class="list-disc space-y-1 pl-5 text-small text-fg-secondary">
            <li>Un sujet = une question ou un projet.</li>
            <li>Précisez l'armée, l'édition ou la gamme concernée.</li>
            <li>Restez courtois : la communauté est là pour s'entraider.</li>
        </ul>
    </aside>

</div>
{% endblock %}
