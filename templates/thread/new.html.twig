{% extends 'base.html.twig' %}

{% block title %}Nouveau sujet — {{ category.name }}{% endblock %}

{% block body %}
<div class="max-w-3xl mx-auto">

    <div class="mb-6">
        <a href="{{ path('app_forum_category', {slug: category.slug}) }}"
           class="text-gray-400 hover:text-white text-sm transition">
            ← Retour à {{ category.name }}
        </a>
        <h1 class="text-2xl font-bold text-white mt-1">✏️ Nouveau sujet</h1>
    </div>

    <div class="bg-gray-800 rounded-xl border border-gray-700 p-8">
        {{ form_start(form) }}

            <div class="space-y-5">
                <div>
                    {{ form_label(form.title, null, {'label_attr': {'class': 'block text-sm text-gray-400 mb-1'}}) }}
                    {{ form_widget(form.title, {'attr': {'class': 'w-full bg-gray-700 border border-gray-600 rounded-lg px-4 py-2 text-white focus:outline-none focus:border-indigo-500'}}) }}
                    {{ form_errors(form.title) }}
                </div>
                <div>
                    {{ form_label(form.content, null, {'label_attr': {'class': 'block text-sm text-gray-400 mb-1'}}) }}
                    {{ form_widget(form.content, {'attr': {'class': 'w-full bg-gray-700 border border-gray-600 rounded-lg px-4 py-2 text-white focus:outline-none focus:border-indigo-500'}}) }}
                    {{ form_errors(form.content) }}
                </div>
            </div>

            <div class="flex gap-3 mt-8">
                <button type="submit"
                        class="bg-indigo-600 hover:bg-indigo-700 px-6 py-2 rounded-lg transition">
                    📨 Publier le sujet
                </button>
                <a href="{{ path('app_forum_category', {slug: category.slug}) }}"
                   class="bg-gray-700 hover:bg-gray-600 px-6 py-2 rounded-lg transition">
                    Annuler
                </a>
            </div>

        {{ form_end(form) }}
    </div>

</div>
{% endblock %}