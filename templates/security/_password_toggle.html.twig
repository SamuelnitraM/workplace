{# Bouton afficher / masquer le mot de passe (assets/controllers/password_visibility_controller.js).
   À placer dans un conteneur relatif, à côté d'un champ .input pr-12 ciblé data-password-visibility-target="input",
   le tout sous data-controller="password-visibility". Paramètre : controls (id du champ). #}
{% import '_macros/ui.html.twig' as ui %}
<button type="button"
        class="btn btn-ghost btn-icon absolute inset-y-0 right-0 h-auto min-h-0 w-11 rounded-l-none"
        aria-pressed="false"
        aria-controls="{{ controls }}"
        aria-label="Afficher le mot de passe"
        data-password-visibility-target="button"
        data-action="password-visibility#toggle">
    <span data-password-visibility-target="showIcon">{{ ui.icon('eye') }}</span>
    <span data-password-visibility-target="hideIcon" hidden>{{ ui.icon('eye-off') }}</span>
</button>
