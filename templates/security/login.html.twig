{% extends 'base.html.twig' %}
{% import '_macros/ui.html.twig' as ui %}

{% block title %}Connexion — SprueHub{% endblock %}

{% block body %}
<div class="container-form">

    <header class="mb-6 text-center">
        <h1 class="text-h1 text-fg">Connexion</h1>
        <p class="mt-2 text-fg-secondary">Content de te revoir ! Connecte-toi à ton compte SprueHub.</p>
    </header>

    <div class="card">
        <div class="card-body space-y-5 sm:p-8">

            {# ERREUR #}
            {% if error %}
                <div class="alert alert-danger" role="alert">
                    {{ ui.icon('alert-circle') }}
                    <p>{{ error.messageKey|trans(error.messageData, 'security') }}</p>
                </div>
            {% endif %}

            {# DÉJÀ CONNECTÉ #}
            {% if app.user %}
                <div class="alert alert-info">
                    {{ ui.icon('info') }}
                    <p>
                        Tu es connecté en tant que <strong class="font-semibold text-fg">{{ app.user.userIdentifier }}</strong>.
                        <a href="{{ logout_path() }}" class="link">Déconnexion</a>
                    </p>
                </div>
            {% endif %}

            <form method="post" class="space-y-5">

                <div class="field">
                    <label for="username" class="label">E-mail ou pseudo</label>
                    <input type="text" value="{{ last_username }}" name="_username" id="username" class="input"
                           autocomplete="username" autocapitalize="none" spellcheck="false" required autofocus
                           placeholder="Pseudo ou adresse e-mail"
                           {% if error %}aria-invalid="true"{% endif %}>
                </div>

                <div class="field" data-controller="password-visibility">
                    <div class="flex items-baseline justify-between gap-2">
                        <label for="password" class="label">Mot de passe</label>
                        <a href="{{ path('app_forgot_password_request') }}" class="link text-small">Mot de passe oublié ?</a>
                    </div>
                    <div class="relative">
                        <input type="password" name="_password" id="password" class="input pr-12"
                               autocomplete="current-password" required placeholder="Ton mot de passe"
                               data-password-visibility-target="input"
                               {% if error %}aria-invalid="true"{% endif %}>
                        {{ include('security/_password_toggle.html.twig', {controls: 'password'}, with_context = false) }}
                    </div>
                </div>

                {# CSRF #}
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <label class="check">
                    <input type="checkbox" name="_remember_me" class="checkbox">
                    <span>Se souvenir de moi pendant 30 jours</span>
                </label>

                <button type="submit" class="btn btn-primary btn-lg btn-block">{{ ui.icon('log-in') }}Se connecter</button>
            </form>
        </div>

        <div class="card-footer justify-center text-small text-fg-secondary">
            Pas encore de compte ?
            <a href="{{ path('app_register') }}" class="link font-semibold">Créer un compte</a>
        </div>
    </div>

</div>
{% endblock %}
