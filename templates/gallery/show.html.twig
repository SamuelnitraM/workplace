{% extends 'base.html.twig' %}
{% import '_macros/ui.html.twig' as ui %}

{% block title %}Photo de {{ owner.username }}{% endblock %}

{% block body %}
{% set isPhotoOwner = is_granted('GALLERY_PHOTO_EDIT', photo) %}
<div class="max-w-6xl mx-auto">

    <nav class="mb-4" aria-label="Fil d'Ariane">
        <a href="{{ path('app_profil_show', {username: owner.username}) }}" class="btn btn-ghost btn-sm -ml-2">{{ ui.icon('arrow-left') }}Profil de {{ owner.username }}</a>
    </nav>

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-[minmax(0,1fr)_24rem] lg:items-start">

        {# PHOTO #}
        <figure class="photo-stage">
            <img src="{{ asset('uploads/gallery/' ~ photo.filename) }}" alt="Photo de {{ owner.username }}{% if photo.description %} : {{ photo.description|length > 120 ? photo.description|slice(0, 120) ~ '…' : photo.description }}{% endif %}" class="photo-stage-img" decoding="async">
            {% if not photo.isVisible %}
                <figcaption class="absolute left-3 top-3 chip chip-warning shadow-overlay">{{ ui.icon('eye-off') }}Photo masquée — visible par vous seul</figcaption>
            {% endif %}
        </figure>

        {# INFOS / LIKES / COMMENTAIRES #}
        <div class="space-y-4">
            <section class="card" data-controller="like" aria-label="À propos de la photo">
                <div class="card-body">
                    <div class="flex items-center gap-3">
                        <a href="{{ path('app_profil_show', {username: owner.username}) }}" class="shrink-0 rounded-pill" tabindex="-1" aria-hidden="true">
                            {{ ui.avatar(owner, 'md') }}
                        </a>
                        <div class="min-w-0">
                            <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
                                <a href="{{ path('app_profil_show', {username: owner.username}) }}" class="font-semibold text-fg hover:text-primary-text">{{ owner.username }}</a>
                                {{ include('gamification/_user_title.html.twig', {user: owner}) }}
                            </div>
                            <p class="text-caption text-muted"><time datetime="{{ photo.createdAt|date('c') }}">Publiée le {{ photo.createdAt|date('d/m/Y à H:i') }}</time></p>
                        </div>
                        {% if app.user and not isPhotoOwner %}
                            <a href="{{ path('app_report', {type: 'photo', id: photo.id}) }}" class="btn btn-ghost btn-icon btn-sm ml-auto text-muted" rel="nofollow" aria-label="Signaler la photo" title="Signaler la photo">{{ ui.icon('flag', 'size-4') }}</a>
                        {% endif %}
                    </div>

                    {% if photo.hiddenByModeration %}
                        <p class="mt-4 chip chip-warning">{{ ui.icon('shield', 'size-4') }}Photo masquée par la modération : elle n'est visible que par toi.</p>
                    {% endif %}

                    {% if photo.description %}
                        <p class="mt-4 text-fg-secondary break-words">{{ photo.description|nl2br }}</p>
                    {% elseif isPhotoOwner %}
                        <p class="mt-4 text-small italic text-muted">Aucune description.</p>
                    {% endif %}

                    {% if isPhotoOwner %}
                        <details class="photo-edit mt-3" {% if not photo.description %}open{% endif %}>
                            <summary class="btn btn-link btn-sm -ml-1">{{ ui.icon('pencil', 'size-4') }}{{ photo.description ? 'Modifier la description' : 'Ajouter une description' }}</summary>
                            <form method="post" action="{{ path('app_gallery_photo_description', {username: owner.username, id: photo.id}) }}" class="field mt-2">
                                <input type="hidden" name="_token" value="{{ csrf_token('gallery_description_' ~ photo.id) }}">
                                <label for="photo-description" class="sr-only">Description</label>
                                <textarea id="photo-description" name="description" rows="3" maxlength="{{ descriptionMaxLength }}" class="textarea" aria-describedby="photo-description-help">{{ photo.description }}</textarea>
                                <div class="flex items-center justify-between gap-3">
                                    <span id="photo-description-help" class="help">{{ descriptionMaxLength }} caractères maximum</span>
                                    <button type="submit" class="btn btn-secondary btn-sm">Enregistrer</button>
                                </div>
                            </form>
                        </details>
                    {% endif %}

                    {# LIKES #}
                    <div class="mt-5 flex flex-wrap items-center gap-2 border-t border-line pt-4">
                        {% if is_granted('GALLERY_PHOTO_LIKE', photo) %}
                            <form method="post" action="{{ path('app_gallery_photo_like', {username: owner.username, id: photo.id}) }}" data-like-target="form" data-action="like#submit">
                                <input type="hidden" name="_token" value="{{ csrf_token('gallery_like_' ~ photo.id) }}">
                                <input type="hidden" name="liked" value="{{ likedByMe ? '0' : '1' }}" data-like-target="intent">
                                <button type="submit" class="btn btn-secondary like-toggle {{ likedByMe ? 'is-liked' : 'is-not-liked' }}" aria-pressed="{{ likedByMe ? 'true' : 'false' }}" data-like-target="button">
                                    <span class="like-toggle-heart" aria-hidden="true">{{ likedByMe ? '♥' : '♡' }}</span>
                                    <span data-like-target="label">{{ likedByMe ? 'Je n’aime plus' : 'J’aime' }}</span>
                                    <span class="like-toggle-count" data-like-target="count">{{ likeCount }}</span>
                                </button>
                            </form>
                        {% else %}
                            <span class="chip" {% if not app.user %}title="Connectez-vous pour aimer cette photo"{% endif %}>
                                {{ ui.icon('heart', 'size-4 text-danger-text') }}<span class="font-semibold">{{ likeCount }}</span> j’aime
                            </span>
                        {% endif %}
                        <a href="#comments" class="btn btn-ghost">{{ ui.icon('message-circle') }}{{ commentCount }} commentaire{{ commentCount > 1 ? 's' : '' }}</a>
                    </div>
                    <p class="field-error mt-2 hidden" data-like-target="error" role="alert"></p>
                </div>
            </section>

            {# COMMENTAIRES #}
            <section id="comments" class="card scroll-mt-[calc(var(--header-h)+1rem)]" aria-labelledby="comments-title">
                <div class="card-header">
                    <h2 id="comments-title" class="text-h3 text-fg">Commentaires</h2>
                    <span class="chip tabular-nums">{{ commentCount }}</span>
                </div>
                <div class="card-body">
                    {% if comments is empty %}
                        {% if is_granted('GALLERY_PHOTO_COMMENT', photo) %}
                            {{ include('_partials/_empty_state.html.twig', {
                                icon: 'message-circle',
                                title: 'Aucun commentaire pour le moment',
                                text: app.user and app.user.id == owner.id
                                    ? 'Ajoutez un mot sur votre figurine : schéma de peinture, techniques, difficultés…'
                                    : 'Un compliment, une question sur le schéma de peinture ? Lancez la discussion.',
                                cta: {label: 'Écrire le premier commentaire', for: 'photo-comment', icon: 'pencil'},
                                variant: 'plain',
                                compact: true,
                                heading: 3,
                            }) }}
                        {% elseif not app.user %}
                            {{ include('_partials/_empty_state.html.twig', {
                                icon: 'message-circle',
                                title: 'Aucun commentaire pour le moment',
                                text: 'Inscrivez-vous pour aimer et commenter les photos de la communauté.',
                                cta: {label: 'Créer mon compte', url: path('app_register')},
                                secondary: {label: 'Se connecter', url: path('app_login')},
                                variant: 'plain',
                                compact: true,
                                heading: 3,
                            }) }}
                        {% else %}
                            <p class="text-small text-muted">Aucun commentaire pour le moment.</p>
                        {% endif %}
                    {% endif %}

                    {% if comments is not empty %}
                        <ul class="space-y-3">
                            {% for comment in comments %}
                                <li id="comment-{{ comment.id }}" class="flex gap-3 scroll-mt-[calc(var(--header-h)+1rem)]">
                                    <a href="{{ path('app_profil_show', {username: comment.author.username}) }}" class="shrink-0 rounded-pill" tabindex="-1" aria-hidden="true">
                                        {{ ui.avatar(comment.author, 'sm') }}
                                    </a>
                                    <div class="min-w-0 flex-1 rounded-control bg-surface-raised px-3 py-2">
                                        <div class="flex items-start justify-between gap-2">
                                            <p class="min-w-0 text-caption">
                                                <a href="{{ path('app_profil_show', {username: comment.author.username}) }}" class="font-semibold text-fg hover:text-primary-text">{{ comment.author.username }}</a>
                                                {{ include('gamification/_user_title.html.twig', {user: comment.author}) }}
                                                <time class="block text-muted sm:ml-1 sm:inline" datetime="{{ comment.createdAt|date('c') }}">{{ comment.createdAt|date('d/m/Y à H:i') }}</time>
                                            </p>
                                            {% if app.user and app.user.id != comment.author.id %}
                                                <a href="{{ path('app_report', {type: 'commentaire', id: comment.id}) }}" class="btn btn-ghost btn-icon btn-sm -mr-1 -mt-1 text-muted" rel="nofollow" aria-label="Signaler le commentaire de {{ comment.author.username }}" title="Signaler">{{ ui.icon('flag', 'size-4') }}</a>
                                            {% endif %}
                                            {% if is_granted('GALLERY_PHOTO_COMMENT_DELETE', comment) %}
                                                <form method="post" action="{{ path('app_gallery_photo_comment_delete', {username: owner.username, id: photo.id, commentId: comment.id, page: page}) }}" class="-mr-1 -mt-1" {{ stimulus_controller('confirm', {message: 'Supprimer ce commentaire ?'})|stimulus_action('confirm', 'ask', 'submit') }}>
                                                    <input type="hidden" name="_token" value="{{ csrf_token('gallery_comment_delete_' ~ comment.id) }}">
                                                    <button type="submit" class="btn btn-ghost btn-icon btn-sm hover:text-danger-text" aria-label="Supprimer le commentaire de {{ comment.author.username }}">{{ ui.icon('trash') }}</button>
                                                </form>
                                            {% endif %}
                                        </div>
                                        <p class="mt-1 text-small text-fg break-words">{{ comment.content|nl2br }}</p>
                                    </div>
                                </li>
                            {% endfor %}
                        </ul>
                    {% endif %}

                    {% if pageCount > 1 %}
                        <nav class="mt-4 flex items-center justify-between gap-2 text-small" aria-label="Pagination des commentaires">
                            {% if page > 1 %}
                                <a href="{{ path('app_gallery_photo_show', {username: owner.username, id: photo.id, page: page - 1, _fragment: 'comments'}) }}" class="btn btn-ghost btn-sm">{{ ui.icon('chevron-left') }}Plus anciens</a>
                            {% else %}<span></span>{% endif %}
                            <span class="text-muted">Page {{ page }} / {{ pageCount }}</span>
                            {% if page < pageCount %}
                                <a href="{{ path('app_gallery_photo_show', {username: owner.username, id: photo.id, page: page + 1, _fragment: 'comments'}) }}" class="btn btn-ghost btn-sm">Plus récents{{ ui.icon('chevron-right') }}</a>
                            {% else %}<span></span>{% endif %}
                        </nav>
                    {% endif %}
                </div>

                {% if is_granted('GALLERY_PHOTO_COMMENT', photo) %}
                    <form method="post" action="{{ path('app_gallery_photo_comment', {username: owner.username, id: photo.id}) }}" class="field border-t border-line p-4 sm:p-5">
                        <input type="hidden" name="_token" value="{{ csrf_token('gallery_comment_' ~ photo.id) }}">
                        <label for="photo-comment" class="label">Votre commentaire</label>
                        <textarea id="photo-comment" name="content" rows="3" required maxlength="{{ commentMaxLength }}" placeholder="Un compliment, une question sur le schéma de peinture…" class="textarea" aria-describedby="photo-comment-help"></textarea>
                        <div class="flex items-center justify-between gap-3">
                            <span id="photo-comment-help" class="help">{{ commentMaxLength }} caractères maximum</span>
                            <button type="submit" class="btn btn-primary">{{ ui.icon('send') }}Commenter</button>
                        </div>
                    </form>
                {% elseif not app.user and comments is not empty %}
                    <p class="card-footer justify-start text-small text-fg-secondary"><a href="{{ path('app_login') }}" class="link">Connectez-vous</a>&nbsp;pour aimer et commenter cette photo.</p>
                {% endif %}
            </section>
        </div>
    </div>
</div>
{% endblock %}
