{#
    Card of a group (public groups page, visitors).
    Parameters: group, unread (unread messages, default 0), is_owner (default false: crown next to the name).
#}
{% import '_macros/ui.html.twig' as ui %}
<a href="{{ path('app_group_show', {slug: group.slug}) }}" class="card card-interactive group flex h-full flex-col gap-3 p-4 sm:p-5">
    <div class="flex items-start gap-3">
        <span class="avatar avatar-md rounded-card" style="background: hsl({{ (group.id * 47) % 360 }} 45% 34%)" aria-hidden="true">{{ group.name|first|upper }}</span>
        <div class="min-w-0 flex-1">
            <h3 class="flex items-center gap-1.5 text-h3 text-fg group-hover:text-primary-text">
                <span class="truncate">{{ group.name }}</span>
                {% if is_owner ?? false %}<span class="group-owner-crown" title="Vous êtes propriétaire">{{ ui.icon('crown', 'size-4') }}<span class="sr-only">Propriétaire</span></span>{% endif %}
            </h3>
            <p class="truncate text-caption text-muted">Par {{ group.creator.username }}</p>
        </div>
    </div>
    <p class="line-clamp-2 text-small {{ group.description ? 'text-fg-secondary' : 'text-muted italic' }}">{{ group.description ?: 'Pas encore de description.' }}</p>
    <div class="mt-auto flex flex-wrap items-center gap-2 pt-1">
        {% if group.isPublic %}<span class="chip chip-success">{{ ui.icon('globe', 'size-4') }}Public</span>{% else %}<span class="chip">{{ ui.icon('lock', 'size-4') }}Privé</span>{% endif %}
        <span class="chip">{{ ui.icon('users', 'size-4') }}{{ group.members|length }} membre{{ group.members|length > 1 ? 's' }}</span>
    </div>
</a>
