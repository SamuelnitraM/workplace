{% extends 'base.html.twig' %}
{% import '_macros/ui.html.twig' as ui %}

{% block title %}Paramètres — {{ group.name }}{% endblock %}

{# En-tête de section : titre + description #}
{% macro section_header(id, icon, title, description) %}
    {% import '_macros/ui.html.twig' as ui %}
    <div class="border-b border-line px-4 py-4 sm:px-5">
        <h2 id="{{ id }}-title" class="flex items-center gap-2 text-h3 text-fg">{{ ui.icon(icon, 'size-5 text-muted') }}{{ title }}</h2>
        {% if description %}<p class="mt-1 max-w-2xl text-small text-fg-secondary">{{ description }}</p>{% endif %}
    </div>
{% endmacro %}

{% block body %}
{% set roleLabels = {member: 'Membre', admin: 'Admin', owner: 'Propriétaire'} %}
{% set isOwner = is_granted('GROUP_OWNER', group) %}
{% set sections = [
    {id: 'informations', label: 'Informations', icon: 'file-text', show: true},
    {id: 'membres', label: 'Membres', icon: 'users', show: isOwner},
    {id: 'salons', label: 'Salons', icon: 'messages-square', show: true},
    {id: 'taches', label: 'Tâches', icon: 'list-checks', show: true},
    {id: 'epingles', label: 'Messages épinglés', icon: 'pin', show: true},
    {id: 'danger', label: 'Zone dangereuse', icon: 'alert-triangle', show: isOwner},
]|filter(s => s.show) %}

    <header class="page-header">
        <div>
            <p class="page-header-eyebrow">
                <a class="link" href="{{ path('app_group_index') }}">Groupes</a>{{ ui.icon('chevron-right', 'size-4') }}<a class="link truncate" href="{{ path('app_group_show', {slug: group.slug}) }}">{{ group.name }}</a>
            </p>
            <h1 class="page-header-title">Paramètres du groupe</h1>
            <p class="page-header-subtitle">Informations, membres, salons et droits de « {{ group.name }} ».</p>
        </div>
        <div class="page-header-actions">
            <a href="{{ path('app_group_show', {slug: group.slug}) }}" class="btn btn-ghost">{{ ui.icon('arrow-left') }}Retour au groupe</a>
        </div>
    </header>

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-[13rem_minmax(0,1fr)] lg:gap-8">

        {# NAVIGATION DES SECTIONS : colonne collante (desktop), pastilles défilantes (mobile) #}
        <nav aria-label="Sections des paramètres" class="min-w-0 lg:sticky lg:top-[calc(var(--header-h)+1.5rem)] lg:self-start">
            <ul class="scrollbar-none -mx-4 flex gap-2 overflow-x-auto px-4 pb-1 sm:-mx-6 sm:px-6 lg:mx-0 lg:block lg:space-y-0.5 lg:overflow-visible lg:px-0" role="list">
                {% for section in sections %}
                    <li class="shrink-0">
                        <a href="#{{ section.id }}"
                           class="chip min-h-10 px-3.5 text-small pointer-coarse:min-h-11 lg:hidden {{ section.id == 'danger' ? 'chip-danger' : '' }}">{{ section.label }}</a>
                        <a href="#{{ section.id }}"
                           class="menu-item hidden lg:flex {{ section.id == 'danger' ? 'text-danger-text hover:text-danger-text' : '' }}">{{ ui.icon(section.icon, 'size-4') }}{{ section.label }}</a>
                    </li>
                {% endfor %}
            </ul>
        </nav>

        <div class="min-w-0 space-y-6">

            {# INFORMATIONS GÉNÉRALES #}
            <section id="informations" class="card scroll-mt-24" aria-labelledby="informations-title">
                {{ _self.section_header('informations', 'file-text', 'Informations générales', 'Nom, description et visibilité du groupe.') }}
                <form method="post">
                    <input type="hidden" name="_token" value="{{ csrf_token('group') }}">
                    <input type="hidden" name="action" value="update_info">

                    <div class="card-body space-y-5">
                        <div class="field">
                            <label class="label" for="group-name">Nom du groupe</label>
                            <input type="text" id="group-name" name="name" value="{{ group.name }}" required class="input">
                        </div>
                        <div class="field">
                            <label class="label" for="group-description">Description <span class="label-hint">(facultatif)</span></label>
                            <textarea id="group-description" name="description" rows="3" class="textarea">{{ group.description }}</textarea>
                        </div>
                        <fieldset class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                            <legend class="label mb-2">Visibilité et accès</legend>
                            <label class="card-inset flex cursor-pointer items-start gap-3 p-4 transition-colors hover:border-line-strong has-[:checked]:border-primary-text has-[:checked]:bg-primary-soft">
                                <input type="checkbox" name="isPublic" value="1" {{ group.isPublic ? 'checked' : '' }} class="checkbox mt-0.5">
                                <span>
                                    <span class="flex items-center gap-1.5 font-semibold text-fg">{{ ui.icon('globe', 'size-4') }}Public</span>
                                    <span class="text-caption text-fg-secondary">Visible par toute la communauté.</span>
                                </span>
                            </label>
                            <label class="card-inset flex cursor-pointer items-start gap-3 p-4 transition-colors hover:border-line-strong has-[:checked]:border-primary-text has-[:checked]:bg-primary-soft">
                                <input type="checkbox" name="isJoinable" value="1" {{ group.isJoinable ? 'checked' : '' }} class="checkbox mt-0.5">
                                <span>
                                    <span class="flex items-center gap-1.5 font-semibold text-fg">{{ ui.icon('user-plus', 'size-4') }}Ouvert aux demandes</span>
                                    <span class="text-caption text-fg-secondary">Chacun peut rejoindre sans invitation.</span>
                                </span>
                            </label>
                        </fieldset>
                        <div class="field sm:max-w-sm">
                            <label class="label" for="invite-role">Qui peut inviter des membres</label>
                            <select id="invite-role" name="invite_role" class="select" aria-describedby="invite-role-help">
                                {% for role, label in roleLabels %}
                                    <option value="{{ role }}" {{ group.inviteRole == role ? 'selected' : '' }}>{{ label }}{{ role != 'owner' ? ' et plus' : '' }}</option>
                                {% endfor %}
                            </select>
                            <p id="invite-role-help" class="help">Dans un groupe en accès libre (public et ouvert aux demandes), tous les membres peuvent inviter.</p>
                        </div>
                    </div>
                    <div class="card-footer">
                        <button type="submit" class="btn btn-primary">{{ ui.icon('check') }}Enregistrer</button>
                    </div>
                </form>
            </section>

            {# GESTION DES MEMBRES (propriétaire uniquement) #}
            {% if isOwner %}
                <section id="membres" class="card scroll-mt-24" aria-labelledby="membres-title">
                    {{ _self.section_header('membres', 'users', 'Membres', 'Nommez des admins pour vous aider à gérer les salons, ou excluez un membre.') }}
                    {% if group.members|filter(m => m.role != 'owner') is empty %}
                        {{ include('_partials/_empty_state.html.twig', {
                            icon: 'mail',
                            title: 'Vous êtes seul dans ce groupe',
                            text: 'Invitez vos amis depuis leur profil (bouton « Inviter dans un groupe »)' ~ (group.isPublic and group.isJoinable ? ', ou partagez le lien du groupe : il est ouvert aux demandes.' : '.'),
                            cta: {label: 'Voir mes amis', url: path('app_friendship_list'), icon: 'users'},
                            variant: 'plain',
                            compact: true,
                            heading: 3,
                        }) }}
                    {% else %}
                        <ul role="list">
                            {% for member in group.members|filter(m => m.role == 'owner') %}
                                <li class="list-row flex-wrap">
                                    {{ ui.avatar(member.user, 'sm') }}
                                    <div class="list-row-main">
                                        <p class="truncate font-medium text-fg">{{ member.user.username }}</p>
                                    </div>
                                    <span class="chip chip-accent">{{ ui.icon('crown', 'size-4') }}Propriétaire</span>
                                </li>
                            {% endfor %}
                            {% for member in group.members|filter(m => m.role != 'owner') %}
                                <li class="list-row flex-wrap">
                                    {{ ui.avatar(member.user, 'sm') }}
                                    <div class="list-row-main">
                                        <p class="truncate font-medium text-fg">{{ member.user.username }}</p>
                                        <p class="text-caption text-muted">{{ roleLabels[member.role] ?? member.role }}</p>
                                    </div>
                                    <div class="flex w-full items-center gap-2 sm:w-auto">
                                        <form method="post" class="flex flex-1 items-center gap-2 sm:flex-none">
                                            <input type="hidden" name="_token" value="{{ csrf_token('group') }}">
                                            <input type="hidden" name="action" value="update_role">
                                            <input type="hidden" name="member_id" value="{{ member.id }}">
                                            <label for="role-{{ member.id }}" class="sr-only">Rôle de {{ member.user.username }}</label>
                                            <select id="role-{{ member.id }}" name="role" class="select min-w-0 flex-1 sm:w-32 sm:flex-none">
                                                <option value="member" {{ member.role == 'member' ? 'selected' : '' }}>Membre</option>
                                                <option value="admin" {{ member.role == 'admin' ? 'selected' : '' }}>Admin</option>
                                            </select>
                                            <button type="submit" class="btn btn-secondary">Appliquer</button>
                                        </form>
                                        <form method="post" action="{{ path('app_group_kick', {slug: group.slug, memberId: member.id}) }}"
                                            {{ stimulus_controller('confirm', {message: 'Exclure ' ~ member.user.username ~ ' ?'})|stimulus_action('confirm', 'ask', 'submit') }}>
                                            <input type="hidden" name="_token" value="{{ csrf_token('group') }}">
                                            <button type="submit" class="btn btn-ghost text-danger-text hover:bg-danger-soft hover:text-danger-text"
                                                    aria-label="Exclure {{ member.user.username }}">{{ ui.icon('x') }}<span class="hidden sm:inline">Exclure</span></button>
                                        </form>
                                    </div>
                                </li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                </section>
            {% endif %}

            {# GESTION DES SALONS (propriétaire/admin) #}
            <section id="salons" class="card scroll-mt-24" aria-labelledby="salons-title">
                {{ _self.section_header('salons', 'messages-square', 'Salons', 'Choisissez qui peut lire et écrire dans chaque salon.') }}

                {% if group.channels is empty %}
                    <p class="px-4 py-5 text-small text-muted sm:px-5">Aucun salon pour le moment.{{ isOwner ? ' Créez-en un ci-dessous pour ouvrir la discussion.' : '' }}</p>
                {% else %}
                    <ul role="list" class="group-settings-channels">
                        {% for channel in group.channels %}
                            <li class="list-row flex-wrap">
                                <span class="flex size-9 shrink-0 items-center justify-center rounded-control bg-surface-raised font-semibold text-muted" aria-hidden="true">#</span>
                                <div class="list-row-main">
                                    <p class="truncate font-medium text-fg">{{ channel.name }}</p>
                                    <p class="flex flex-wrap items-center gap-x-3 gap-y-0.5 text-caption text-muted">
                                        <span class="inline-flex items-center gap-1">{{ ui.icon('eye', 'size-3.5') }}Lecture : {{ roleLabels[channel.canRead] ?? channel.canRead }}</span>
                                        <span class="inline-flex items-center gap-1">{{ ui.icon('pencil', 'size-3.5') }}Écriture : {{ roleLabels[channel.canWrite] ?? channel.canWrite }}</span>
                                    </p>
                                </div>
                                <div class="flex w-full flex-wrap items-end gap-2 sm:w-auto">
                                    {# MODIFIER LES DROITS #}
                                    <form method="post" class="flex flex-1 flex-wrap items-end gap-2 sm:flex-none">
                                        <input type="hidden" name="_token" value="{{ csrf_token('group') }}">
                                        <input type="hidden" name="action" value="update_channel">
                                        <input type="hidden" name="channel_id" value="{{ channel.id }}">
                                        <div class="field flex-1 gap-1 sm:w-32 sm:flex-none">
                                            <label class="text-caption text-muted" for="can-read-{{ channel.id }}">Lecture</label>
                                            <select id="can-read-{{ channel.id }}" name="can_read" aria-label="Qui peut lire ce salon" class="select">
                                                {% for role, label in roleLabels %}
                                                    <option value="{{ role }}" {{ channel.canRead == role ? 'selected' : '' }}>{{ label }}</option>
                                                {% endfor %}
                                            </select>
                                        </div>
                                        <div class="field flex-1 gap-1 sm:w-32 sm:flex-none">
                                            <label class="text-caption text-muted" for="can-write-{{ channel.id }}">Écriture</label>
                                            <select id="can-write-{{ channel.id }}" name="can_write" aria-label="Qui peut écrire dans ce salon" class="select">
                                                {% for role, label in roleLabels %}
                                                    <option value="{{ role }}" {{ channel.canWrite == role ? 'selected' : '' }}>{{ label }}</option>
                                                {% endfor %}
                                            </select>
                                        </div>
                                        <button type="submit" class="btn btn-secondary">Appliquer</button>
                                    </form>
                                    {# SUPPRIMER (propriétaire uniquement) #}
                                    {% if isOwner %}
                                        <form method="post"
                                            action="{{ path('app_group_channel_delete', {slug: group.slug, channelId: channel.id}) }}"
                                            {{ stimulus_controller('confirm', {message: 'Supprimer ce salon et tous ses messages ?'})|stimulus_action('confirm', 'ask', 'submit') }}>
                                            <input type="hidden" name="_token" value="{{ csrf_token('group') }}">
                                            <button type="submit" class="btn btn-ghost btn-icon text-danger-text hover:bg-danger-soft hover:text-danger-text"
                                                    aria-label="Supprimer le salon #{{ channel.name }}" title="Supprimer le salon">{{ ui.icon('trash') }}</button>
                                        </form>
                                    {% endif %}
                                </div>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}

                {# CRÉER UN SALON (propriétaire uniquement) #}
                {% if isOwner %}
                    <form method="post" id="nouveau-salon" class="scroll-mt-24 border-t border-line bg-surface-raised/40 px-4 py-4 sm:px-5 rounded-b-card">
                        <input type="hidden" name="_token" value="{{ csrf_token('group') }}">
                        <input type="hidden" name="action" value="create_channel">
                        <p class="mb-3 text-small font-semibold text-fg">Nouveau salon</p>
                        <div class="grid grid-cols-2 items-end gap-3 sm:grid-cols-[minmax(0,1fr)_8rem_8rem_auto]">
                            <div class="field col-span-2 sm:col-span-1">
                                <label class="label" for="new-channel-name">Nom</label>
                                <input type="text" id="new-channel-name" name="channel_name" placeholder="ex. peinture" aria-label="Nom du nouveau salon" required maxlength="50" class="input">
                            </div>
                            <div class="field">
                                <label class="label" for="new-channel-read">Lecture</label>
                                <select id="new-channel-read" name="channel_can_read" aria-label="Qui peut lire ce salon" class="select">
                                    {% for role, label in roleLabels %}<option value="{{ role }}">{{ label }}</option>{% endfor %}
                                </select>
                            </div>
                            <div class="field">
                                <label class="label" for="new-channel-write">Écriture</label>
                                <select id="new-channel-write" name="channel_can_write" aria-label="Qui peut écrire dans ce salon" class="select">
                                    {% for role, label in roleLabels %}<option value="{{ role }}">{{ label }}</option>{% endfor %}
                                </select>
                            </div>
                            <button type="submit" class="btn btn-secondary col-span-2 sm:col-span-1">{{ ui.icon('plus') }}Créer le salon</button>
                        </div>
                    </form>
                {% endif %}
            </section>

            {# PARAMÈTRES DES TÂCHES (modifiables par le propriétaire, affichés aux admins) #}
            <section id="taches" class="card scroll-mt-24" aria-labelledby="taches-title">
                {{ _self.section_header('taches', 'list-checks', 'Tâches du groupe', null) }}
                <div class="card-body space-y-4">
                    <ul class="space-y-1.5 text-small text-fg-secondary" role="list">
                        <li class="flex gap-2">{{ ui.icon('pencil', 'size-4 mt-0.5 shrink-0 text-muted') }}<span><strong class="font-semibold text-fg">Rédacteurs</strong> : créent listes, catégories et tâches, renomment, suppriment et font progresser toutes les tâches.</span></li>
                        <li class="flex gap-2">{{ ui.icon('eye', 'size-4 mt-0.5 shrink-0 text-muted') }}<span><strong class="font-semibold text-fg">Lecteurs</strong> : voient toutes les tâches et peuvent demander à y être assignés. Les autres membres ne voient que ce qui leur est assigné.</span></li>
                        <li class="flex gap-2">{{ ui.icon('user-check', 'size-4 mt-0.5 shrink-0 text-muted') }}<span><strong class="font-semibold text-fg">Assignations</strong> : un membre assigné à une tâche la fait progresser. Sa demande attend la validation d'un gestionnaire (sa photo apparaît grisée), sauf en mode libre où il s'assigne directement ; seuls les administrateurs et le propriétaire retirent un assigné.</span></li>
                    </ul>
                    {% if isOwner %}
                        <form method="post" class="space-y-4">
                            <input type="hidden" name="_token" value="{{ csrf_token('group') }}">
                            <input type="hidden" name="action" value="update_todo_settings">
                            <div class="grid items-start gap-4 sm:grid-cols-2">
                                <div class="field">
                                    <label for="todo_write_role" class="label">Qui peut modifier les tâches</label>
                                    <select id="todo_write_role" name="todo_write_role" class="select">
                                        {% for role, label in roleLabels %}
                                            <option value="{{ role }}" {{ group.todoWriteRole == role ? 'selected' : '' }}>{{ label }}{{ role != 'owner' ? ' et plus' : '' }}</option>
                                        {% endfor %}
                                    </select>
                                </div>
                                <div class="field">
                                    <label for="todo_view_role" class="label">Qui peut voir toutes les tâches</label>
                                    <select id="todo_view_role" name="todo_view_role" class="select" aria-describedby="todo_view_role_help">
                                        {% for role, label in roleLabels %}
                                            <option value="{{ role }}" {{ group.todoViewRole == role ? 'selected' : '' }}>{{ label }}{{ role != 'owner' ? ' et plus' : '' }}</option>
                                        {% endfor %}
                                    </select>
                                    <p id="todo_view_role_help" class="help">Les rédacteurs voient toujours toutes les tâches.</p>
                                </div>
                                <div class="field">
                                    <label for="assignment_role" class="label">Gestion des assignations</label>
                                    <select id="assignment_role" name="assignment_role" class="select" aria-describedby="assignment_role_help">
                                        {% for role, label in {owner: 'Propriétaire', admin: 'Admins et propriétaire', member: 'Libre'} %}
                                            <option value="{{ role }}" {{ group.assignmentRole == role ? 'selected' : '' }}>{{ label }}</option>
                                        {% endfor %}
                                    </select>
                                    <p id="assignment_role_help" class="help">Qui valide les demandes et assigne les membres. En mode libre, chacun s'assigne sans validation.</p>
                                </div>
                                <div class="field">
                                    <label for="max_assignees" class="label">Membres par tâche</label>
                                    <select id="max_assignees" name="max_assignees" class="select">
                                        {% for count in 1..constant('App\\Entity\\Group::MAX_ASSIGNEES_LIMIT') %}
                                            <option value="{{ count }}" {{ group.maxAssigneesPerTask == count ? 'selected' : '' }}>{{ count }} au maximum</option>
                                        {% endfor %}
                                    </select>
                                </div>
                            </div>
                            <div class="flex justify-end">
                                <button type="submit" class="btn btn-primary">{{ ui.icon('check') }}Enregistrer</button>
                            </div>
                        </form>
                    {% else %}
                        <dl class="grid gap-3 sm:grid-cols-2">
                            <div class="card-inset px-4 py-3">
                                <dt class="text-caption text-muted">Qui peut modifier les tâches</dt>
                                <dd class="font-semibold text-fg">{{ roleLabels[group.todoWriteRole] ?? group.todoWriteRole }}{{ group.todoWriteRole != 'owner' ? ' et plus' : '' }}</dd>
                            </div>
                            <div class="card-inset px-4 py-3">
                                <dt class="text-caption text-muted">Qui peut voir toutes les tâches</dt>
                                <dd class="font-semibold text-fg">{{ roleLabels[group.todoViewRole] ?? group.todoViewRole }}{{ group.todoViewRole != 'owner' ? ' et plus' : '' }}</dd>
                            </div>
                            <div class="card-inset px-4 py-3">
                                <dt class="text-caption text-muted">Gestion des assignations</dt>
                                <dd class="font-semibold text-fg">{{ {owner: 'Propriétaire', admin: 'Admins et propriétaire', member: 'Libre'}[group.assignmentRole] }}</dd>
                            </div>
                            <div class="card-inset px-4 py-3">
                                <dt class="text-caption text-muted">Membres par tâche</dt>
                                <dd class="font-semibold text-fg">{{ group.maxAssigneesPerTask }} au maximum</dd>
                            </div>
                        </dl>
                        <p class="help flex items-center gap-1.5">{{ ui.icon('lock', 'size-3.5') }}Modifiable par le propriétaire.</p>
                    {% endif %}
                </div>
            </section>

            {# MESSAGES ÉPINGLÉS (modifiable par le propriétaire, affiché aux admins) #}
            <section id="epingles" class="card scroll-mt-24" aria-labelledby="epingles-title">
                {{ _self.section_header('epingles', 'pin', 'Messages épinglés', 'Les messages épinglés s\'affichent en haut du chat de leur salon. Pour épingler ou désépingler, il faut avoir au moins ce rôle et pouvoir lire le salon (20 messages épinglés maximum par salon).') }}
                <div class="card-body">
                    {% if isOwner %}
                        <form method="post" class="flex flex-wrap items-end gap-3">
                            <input type="hidden" name="_token" value="{{ csrf_token('group') }}">
                            <input type="hidden" name="action" value="update_pin_settings">
                            <div class="field w-full sm:w-64">
                                <label for="pin_role" class="label">Qui peut épingler des messages</label>
                                <select id="pin_role" name="pin_role" class="select">
                                    {% for role, label in roleLabels %}
                                        <option value="{{ role }}" {{ group.pinRole == role ? 'selected' : '' }}>{{ label }}{{ role != 'owner' ? ' et plus' : '' }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                            <button type="submit" class="btn btn-primary ml-auto">{{ ui.icon('check') }}Enregistrer</button>
                        </form>
                    {% else %}
                        <div class="card-inset px-4 py-3 sm:max-w-xs">
                            <p class="text-caption text-muted">Qui peut épingler des messages</p>
                            <p class="font-semibold text-fg">{{ roleLabels[group.pinRole] ?? group.pinRole }}{{ group.pinRole != 'owner' ? ' et plus' : '' }}</p>
                        </div>
                        <p class="help mt-3 flex items-center gap-1.5">{{ ui.icon('lock', 'size-3.5') }}Modifiable par le propriétaire.</p>
                    {% endif %}
                </div>
            </section>

            {# ZONE DANGEREUSE #}
            {% if isOwner %}
                <section id="danger" class="card scroll-mt-24 border-danger/60" aria-labelledby="danger-title">
                    <div class="flex flex-col gap-4 px-4 py-5 sm:flex-row sm:items-center sm:justify-between sm:px-5">
                        <div>
                            <h2 id="danger-title" class="flex items-center gap-2 text-h3 text-danger-text">{{ ui.icon('alert-triangle', 'size-5') }}Zone dangereuse</h2>
                            <p class="mt-1 max-w-xl text-small text-fg-secondary">Le groupe et tout son contenu (salons, messages, tâches) seront définitivement supprimés. Action irréversible.</p>
                        </div>
                        <form method="post" action="{{ path('app_group_delete', {slug: group.slug}) }}" class="shrink-0"
                              {{ stimulus_controller('confirm', {message: 'Supprimer définitivement ce groupe et tout son contenu ?'})|stimulus_action('confirm', 'ask', 'submit') }}>
                            <input type="hidden" name="_token" value="{{ csrf_token('group') }}">
                            <button type="submit" class="btn btn-danger">{{ ui.icon('trash') }}Supprimer le groupe</button>
                        </form>
                    </div>
                </section>
            {% endif %}

        </div>
    </div>
{% endblock %}
