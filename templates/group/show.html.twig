{% extends 'base.html.twig' %}
{% import '_macros/ui.html.twig' as ui %}

{# Ligne d'un message épinglé (barre en haut du chat) : même rendu que assets/controllers/pinned_controller.js (buildRow) #}
{% macro pinned_row(message, group) %}
    {% import '_macros/ui.html.twig' as ui %}
    <div class="flex min-w-0 items-center gap-1" data-pinned-row="{{ message.id }}">
        <button type="button" data-action="pinned#jump" data-pinned-id-param="{{ message.id }}"
                title="Épinglé{{ message.pinnedBy ? ' par ' ~ message.pinnedBy.username : '' }} le {{ message.pinnedAt|date('d/m H:i') }} — aller au message"
                class="flex min-h-9 min-w-0 flex-1 items-center gap-2 rounded-control px-2 py-1 text-left hover:bg-overlay pointer-coarse:min-h-11">
            {{ ui.icon('pin', 'size-4 shrink-0 text-accent-text') }}
            <span class="shrink-0 font-semibold text-fg">{{ message.author.username }}</span>
            <span class="shrink-0 text-caption text-muted">{{ message.createdAt|date('d/m H:i') }}</span>
            <span class="truncate text-fg-secondary">{{ message.content|length > 140 ? message.content|slice(0, 140) ~ '…' : message.content }}</span>
        </button>
        {% if is_granted('GROUP_MESSAGE_PIN', message) %}
            <form method="post" action="{{ path('app_group_message_unpin', {slug: group.slug, id: message.id}) }}" data-action="pinned#toggle" class="shrink-0">
                <input type="hidden" name="_token" value="{{ csrf_token('group') }}">
                <button type="submit" title="Désépingler" aria-label="Désépingler ce message"
                        class="btn btn-ghost btn-icon btn-sm hover:text-danger-text">{{ ui.icon('x') }}</button>
            </form>
        {% endif %}
    </div>
{% endmacro %}

{# Liste des membres (colonne desktop et volet repliable mobile) #}
{% macro member_list(group) %}
    {% import '_macros/ui.html.twig' as ui %}
    {% set rank = {owner: 0, admin: 1, member: 2} %}
    <ul class="space-y-0.5" role="list">
        {% for member in group.members|sort((a, b) => (rank[a.role] ?? 3) <=> (rank[b.role] ?? 3)) %}
            <li>
                <a href="{{ path('app_profil_show', {username: member.user.username}) }}"
                   class="flex min-h-10 items-center gap-2.5 rounded-control px-2 py-1 text-small text-fg-secondary transition-colors hover:bg-surface-raised hover:text-fg">
                    {{ ui.avatar(member.user, 'xs') }}
                    <span class="min-w-0 flex-1 truncate">{{ member.user.username }}</span>
                    {% if member.role == 'owner' %}
                        <span class="chip chip-accent" title="Propriétaire">{{ ui.icon('crown', 'size-3.5') }}<span class="sr-only">Propriétaire</span></span>
                    {% elseif member.role == 'admin' %}
                        <span class="chip chip-info">Admin</span>
                    {% endif %}
                </a>
            </li>
        {% endfor %}
    </ul>
{% endmacro %}

{% block title %}{{ group.name }}{% endblock %}

{% block body %}
{% set writeLabels = {admin: 'les admins et le propriétaire', owner: 'le propriétaire'} %}

    {# EN-TÊTE DU GROUPE #}
    <header class="page-header md:mb-6">
        <div class="flex min-w-0 items-start gap-3 sm:gap-4">
            <span class="avatar avatar-md rounded-card sm:[--avatar-size:4rem]" style="background: hsl({{ (group.id * 47) % 360 }} 45% 34%)" aria-hidden="true">{{ group.name|first|upper }}</span>
            <div class="min-w-0">
                <p class="page-header-eyebrow">
                    <a class="link" href="{{ path('app_group_index') }}">Groupes</a>{{ ui.icon('chevron-right', 'size-4') }}<span class="truncate">{{ group.name }}</span>
                </p>
                <h1 class="page-header-title break-words">{{ group.name }}</h1>
                {% if group.description %}
                    <p class="page-header-subtitle line-clamp-2">{{ group.description }}</p>
                {% endif %}
                <div class="mt-2 flex flex-wrap items-center gap-2">
                    {% if group.isPublic %}
                        <span class="chip chip-success">{{ ui.icon('globe', 'size-4') }}Public</span>
                    {% else %}
                        <span class="chip">{{ ui.icon('lock', 'size-4') }}Privé</span>
                    {% endif %}
                    <span class="chip">{{ ui.icon('users', 'size-4') }}{{ group.members|length }} membre{{ group.members|length > 1 ? 's' : '' }}</span>
                    <span class="text-caption text-muted">Créé par {{ group.creator.username }}</span>
                </div>
            </div>
        </div>

        {# ACTIONS #}
        <div class="page-header-actions">
            {% if currentMember %}
                <a href="{{ path('app_group_todo_index', {slug: group.slug}) }}" class="btn btn-secondary">
                    {{ ui.icon('list-checks') }}Tâches
                </a>
                {% if is_granted('GROUP_MANAGE', group) %}
                    <a href="{{ path('app_group_edit', {slug: group.slug}) }}" class="btn btn-secondary">
                        {{ ui.icon('settings') }}Paramètres
                    </a>
                {% endif %}
                {% if not is_granted('GROUP_OWNER', group) %}
                    <form method="post" action="{{ path('app_group_leave', {slug: group.slug}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('group') }}">
                        <button type="submit" class="btn btn-ghost text-danger-text hover:bg-danger-soft hover:text-danger-text">
                            {{ ui.icon('log-out') }}Quitter
                        </button>
                    </form>
                {% endif %}
            {% elseif app.user and group.isJoinable %}
                <form method="post" action="{{ path('app_group_join', {slug: group.slug}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('group') }}">
                    <button type="submit" class="btn btn-primary">{{ ui.icon('user-plus') }}Rejoindre</button>
                </form>
            {% elseif app.user %}
                <span class="chip min-h-10 px-3 text-small">{{ ui.icon('lock', 'size-4') }}Sur invitation uniquement</span>
            {% endif %}
        </div>
    </header>

    <div class="grid grid-cols-1 gap-4 lg:grid-cols-[15rem_minmax(0,1fr)]">

        {# COLONNE GAUCHE (desktop) : SALONS + MEMBRES #}
        <aside class="hidden min-h-[22rem] flex-col gap-4 lg:flex lg:h-[calc(100dvh-var(--header-h)-11rem)] lg:max-h-[52rem]" aria-label="Salons et membres">
            {% if currentMember and channels is not empty %}
                <nav class="card flex max-h-[60%] min-h-0 shrink-0 flex-col" aria-labelledby="channels-title">
                    <h2 id="channels-title" class="eyebrow px-4 pt-3 pb-2">Salons</h2>
                    <ul class="min-h-0 space-y-0.5 overflow-y-auto px-2 pb-2" role="list">
                        {% for channel in channels %}
                            {% set isActive = activeChannel and activeChannel.id == channel.id %}
                            {% set unreadInChannel = unreadChannelCounts[channel.id] ?? 0 %}
                            <li>
                                <a href="{{ path('app_group_show', {slug: group.slug, channel: channel.id}) }}"
                                   class="menu-item aria-[current=page]:bg-primary-soft aria-[current=page]:font-semibold {{ unreadInChannel > 0 ? 'text-fg' : '' }}"
                                   {% if isActive %}aria-current="page"{% endif %}>
                                    <span class="w-4 text-center font-semibold text-muted" aria-hidden="true">#</span>
                                    <span class="min-w-0 flex-1 truncate">{{ channel.name }}</span>
                                    {% if channel.canRead != 'member' %}
                                        {{ ui.icon('lock', 'size-3.5 shrink-0 text-muted', 'Salon à accès restreint') }}
                                    {% endif %}
                                    {% if unreadInChannel > 0 %}
                                        <span class="count-badge" title="Messages non lus">{{ unreadInChannel > 99 ? '99+' : unreadInChannel }}<span class="sr-only"> message(s) non lu(s)</span></span>
                                    {% endif %}
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                </nav>
            {% endif %}

            <section class="card flex min-h-0 flex-1 flex-col" aria-labelledby="members-title">
                <h2 id="members-title" class="eyebrow flex items-center justify-between px-4 pt-3 pb-2">
                    Membres <span class="font-semibold tabular-nums normal-case tracking-normal text-muted">{{ group.members|length }}</span>
                </h2>
                <div class="min-h-0 overflow-y-auto px-2 pb-2">
                    {{ _self.member_list(group) }}
                </div>
            </section>
        </aside>

        <div class="flex min-w-0 flex-col gap-3">

            {# SALONS (mobile) : barre de pastilles défilante #}
            {% if currentMember and channels is not empty %}
                <nav class="scrollbar-none -mx-4 flex gap-2 overflow-x-auto px-4 pb-1 sm:-mx-6 sm:px-6 lg:hidden" aria-label="Salons">
                    {% for channel in channels %}
                        {% set isActive = activeChannel and activeChannel.id == channel.id %}
                        {% set unreadInChannel = unreadChannelCounts[channel.id] ?? 0 %}
                        <a href="{{ path('app_group_show', {slug: group.slug, channel: channel.id}) }}"
                           class="chip min-h-10 shrink-0 px-3.5 text-small pointer-coarse:min-h-11"
                           {% if isActive %}aria-current="page"{% endif %}>
                            <span aria-hidden="true">#</span>{{ channel.name }}
                            {% if channel.canRead != 'member' %}{{ ui.icon('lock', 'size-3.5', 'Accès restreint') }}{% endif %}
                            {% if unreadInChannel > 0 %}
                                <span class="count-badge">{{ unreadInChannel > 99 ? '99+' : unreadInChannel }}<span class="sr-only"> non lu(s)</span></span>
                            {% endif %}
                        </a>
                    {% endfor %}
                </nav>
            {% endif %}

            {# ZONE PRINCIPALE - CHAT (assets/controllers/chat_controller.js + pinned_controller.js) #}
            <section class="card chat-panel"
                     aria-label="{{ activeChannel ? 'Salon #' ~ activeChannel.name : 'Discussion' }}"
                 {% if activeChannel and currentMember %}
                 data-controller="chat pinned"
                 data-action="chat:appended->pinned#decorate"
                 data-chat-channel-value="private-group-channel-{{ activeChannel.id }}"
                 data-chat-send-url-value="{{ path('app_group_message', {slug: group.slug}) }}"
                 data-chat-user-id-value="{{ app.user.id }}"
                 data-chat-avatar-base-value="{{ asset('uploads/avatars/') }}"
                 data-chat-show-author-value="true"
                 data-chat-notification-key-value="{{ channelNotificationKey }}"
                 data-pinned-channel-value="private-group-channel-{{ activeChannel.id }}"
                 data-pinned-pins-value="{{ pinnedData|json_encode }}"
                 data-pinned-can-pin-value="{{ canPin ? 'true' : 'false' }}"
                 data-pinned-pin-url-value="{{ path('app_group_message_pin', {slug: group.slug, id: 0})|replace({'/message/0/': '/message/__ID__/'}) }}"
                 data-pinned-unpin-url-value="{{ path('app_group_message_unpin', {slug: group.slug, id: 0})|replace({'/message/0/': '/message/__ID__/'}) }}"
                 data-pinned-csrf-value="{{ csrf_token('group') }}"
                 {% endif %}>

                {% if activeChannel %}
                    {# EN-TÊTE DU SALON #}
                    <div class="flex items-center gap-3 border-b border-line px-4 py-3">
                        <span class="flex size-9 shrink-0 items-center justify-center rounded-control bg-surface-raised text-h3 font-semibold text-muted" aria-hidden="true">#</span>
                        <div class="min-w-0 flex-1">
                            <h2 class="truncate text-h3 text-fg">{{ activeChannel.name }}</h2>
                            {% if activeChannel.description %}
                                <p class="truncate text-caption text-muted">{{ activeChannel.description }}</p>
                            {% endif %}
                        </div>
                        {% if activeChannel.canRead != 'member' %}
                            <span class="chip shrink-0">{{ ui.icon('lock', 'size-4') }}Restreint</span>
                        {% endif %}
                    </div>

                    {# MESSAGES ÉPINGLÉS (requête dédiée ; reconstruit en direct par pinned_controller.js) #}
                    <div data-pinned-target="bar"
                         class="{{ pinnedMessages is empty ? 'hidden' : '' }} border-b border-line bg-accent-soft/40 px-2 py-1.5 text-small">
                        {% if pinnedMessages|length == 1 %}
                            {{ _self.pinned_row(pinnedMessages|first, group) }}
                        {% elseif pinnedMessages|length > 1 %}
                            <details class="details-reset">
                                <summary class="flex min-h-9 items-center gap-2 rounded-control px-2 py-1 font-semibold text-accent-text select-none hover:bg-overlay pointer-coarse:min-h-11">
                                    {{ ui.icon('pin', 'size-4 shrink-0') }}<span class="flex-1">{{ pinnedMessages|length }} messages épinglés</span>{{ ui.icon('chevron-down', 'details-chevron size-4 shrink-0') }}
                                </summary>
                                <ul class="mt-1 max-h-60 space-y-0.5 overflow-y-auto">
                                    {% for pinned in pinnedMessages %}
                                        <li>{{ _self.pinned_row(pinned, group) }}</li>
                                    {% endfor %}
                                </ul>
                            </details>
                        {% endif %}
                    </div>

                    {# MESSAGES — même structure et classes que les messages ajoutés en direct (chat_controller.js : .chat-msg > .chat-msg-body > .chat-meta + .chat-bubble) #}
                    <div class="chat-stream" id="chat-messages"
                         data-chat-target="messages" data-action="scroll->chat#onScroll"
                         role="log" aria-label="Messages de #{{ activeChannel.name }}">
                        {% if messages is empty %}
                            <div id="chat-empty" data-chat-target="empty" class="my-auto">
                                {{ include('_partials/_empty_state.html.twig', {
                                    icon: 'message-circle',
                                    title: 'Aucun message dans #' ~ activeChannel.name,
                                    text: currentMember and is_granted('CHANNEL_WRITE', activeChannel)
                                        ? 'Brisez la glace : présentez-vous ou partagez votre dernière figurine peinte.'
                                        : 'Les messages de ce salon apparaîtront ici.',
                                    cta: currentMember and is_granted('CHANNEL_WRITE', activeChannel)
                                        ? {label: 'Écrire le premier message', for: 'message-input', icon: 'pencil'}
                                        : null,
                                    variant: 'plain',
                                    compact: true,
                                }) }}
                            </div>
                        {% else %}
                            {% set _days = ['lundi', 'mardi', 'mercredi', 'jeudi', 'vendredi', 'samedi', 'dimanche'] %}
                            {% set _months = ['janvier', 'février', 'mars', 'avril', 'mai', 'juin', 'juillet', 'août', 'septembre', 'octobre', 'novembre', 'décembre'] %}
                            {% set _today = 'now'|date('Y-m-d') %}
                            {% set _yesterday = '-1 day'|date('Y-m-d') %}
                            {% set _year = 'now'|date('Y') %}
                            {% set _prev_day = null %}
                            {% for message in messages %}
                                {% set _day = message.createdAt|date('Y-m-d') %}
                                {% if _day != _prev_day %}
                                    {% set _label = _day == _today ? 'Aujourd\'hui'
                                        : (_day == _yesterday ? 'Hier'
                                        : (_days[message.createdAt|date('N') - 1] ~ ' ' ~ message.createdAt|date('j') ~ ' ' ~ _months[message.createdAt|date('n') - 1]
                                           ~ (message.createdAt|date('Y') != _year ? ' ' ~ message.createdAt|date('Y') : ''))) %}
                                    <div class="chat-day" data-chat-day="{{ _day }}" role="separator" aria-label="{{ _label }}"><span>{{ _label|capitalize }}</span></div>
                                    {% set _prev_day = _day %}
                                {% endif %}
                                {% set _own = message.author == app.user %}
                                <div class="chat-msg group {{ _own ? 'chat-msg-own' }}" id="msg-{{ message.id }}">
                                    {{ ui.avatar(message.author, 'sm') }}
                                    <div class="chat-msg-body">
                                        {# Ligne meta : même texte que chat_controller (pseudo, titre, « — jj/mm HH:ii ») ; indicateur et bouton ajoutés comme pinned#decorate #}
                                        <div class="chat-meta flex flex-wrap items-center gap-1.5">
                                            <span class="inline-flex flex-wrap items-center gap-1">{{ message.author.username }}{{ include('gamification/_user_title.html.twig', {user: message.author}) }} — <time datetime="{{ message.createdAt|date('c') }}" title="{{ message.createdAt|date('d/m/Y à H:i') }}">{{ message.createdAt|date('d/m H:i') }}</time></span>
                                            <span data-pin-indicator class="{{ message.pinned ? '' : 'hidden' }} text-accent-text" title="Message épinglé">{{ ui.icon('pin', 'size-3.5', 'Épinglé') }}</span>
                                            {% if is_granted('GROUP_MESSAGE_PIN', message) %}
                                                <form method="post" data-pin-form data-action="pinned#toggle"
                                                      action="{{ path(message.pinned ? 'app_group_message_unpin' : 'app_group_message_pin', {slug: group.slug, id: message.id}) }}"
                                                      class="reveal-on-hover inline-flex">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('group') }}">
                                                    <button type="submit"
                                                            title="{{ message.pinned ? 'Désépingler' : 'Épingler' }}"
                                                            aria-label="{{ message.pinned ? 'Désépingler ce message' : 'Épingler ce message' }}"
                                                            class="-my-1.5 inline-flex size-7 items-center justify-center rounded-control hover:bg-surface-raised hover:text-accent-text pointer-coarse:-my-2.5 pointer-coarse:size-11 {{ message.pinned ? 'text-accent-text' : 'text-muted' }}">{{ ui.icon(message.pinned ? 'x' : 'pin', 'size-4') }}</button>
                                                </form>
                                            {% endif %}
                                        </div>
                                        <div class="chat-bubble" data-pin-bubble>{{ message.content }}</div>
                                    </div>
                                </div>
                            {% endfor %}
                        {% endif %}
                    </div>

                    {# BOUTON « DERNIERS MESSAGES » #}
                    <div class="relative">
                        <button type="button" id="scroll-btn" data-chat-target="scrollButton" data-action="chat#jumpToBottom" aria-label="Aller aux derniers messages"
                                class="hidden btn btn-secondary btn-icon chat-scroll-btn">
                            {{- ui.icon('chevron-down') -}}
                            <span id="scroll-badge" data-chat-target="scrollBadge"
                                  class="hidden absolute -top-0.5 -right-0.5 size-3 rounded-pill bg-notify ring-2 ring-surface"></span>
                        </button>
                    </div>

                    {# COMPOSITION DU MESSAGE #}
                    {% if currentMember %}
                        {% if is_granted('CHANNEL_WRITE', activeChannel) %}
                            <form method="post"
                                  action="{{ path('app_group_message', {slug: group.slug}) }}"
                                  class="chat-composer"
                                  id="message-form"
                                  data-chat-target="form" data-action="submit->chat#send">
                                <input type="hidden" name="_token" value="{{ csrf_token('group') }}">
                                <input type="hidden" name="channel_id" value="{{ activeChannel.id }}">
                                <label for="message-input" class="sr-only">Message dans #{{ activeChannel.name }}</label>
                                <input type="text" name="content" id="message-input" data-chat-target="input" maxlength="2000" required
                                       placeholder="Message dans #{{ activeChannel.name }}…"
                                       autocomplete="off" enterkeyhint="send"
                                       class="input flex-1 rounded-pill px-4">
                                <button type="submit" class="btn btn-primary btn-icon shrink-0 rounded-pill" aria-label="Envoyer le message">
                                    {{- ui.icon('send') -}}
                                </button>
                            </form>
                        {% else %}
                            <div class="chat-composer justify-center text-center text-small text-fg-secondary" role="status">
                                {{ ui.icon('lock', 'size-4 shrink-0 text-muted') }}
                                <p>Salon en lecture seule : seuls {{ writeLabels[activeChannel.canWrite] ?? 'certains membres' }} peuvent y écrire.</p>
                            </div>
                        {% endif %}
                    {% endif %}

                {% else %}
                    {# PAS DE SALON #}
                    <div class="flex flex-1 items-center justify-center overflow-y-auto">
                        {% if currentMember %}
                            {% if is_granted('GROUP_OWNER', group) %}
                                {{ include('_partials/_empty_state.html.twig', {
                                    icon: 'message-square',
                                    title: 'Aucun salon pour le moment',
                                    text: 'Créez un premier salon (#général, #peinture, #parties…) pour que les membres puissent discuter.',
                                    cta: {label: 'Créer un salon', url: path('app_group_edit', {slug: group.slug}) ~ '#nouveau-salon', icon: 'plus'},
                                    variant: 'plain',
                                }) }}
                            {% else %}
                                {{ include('_partials/_empty_state.html.twig', {
                                    icon: 'message-square',
                                    title: 'Aucun salon disponible',
                                    text: 'Le propriétaire du groupe n\'a pas encore ouvert de salon accessible. En attendant, consultez les tâches du groupe.',
                                    cta: {label: 'Voir les tâches', url: path('app_group_todo_index', {slug: group.slug}), icon: 'list-checks'},
                                    variant: 'plain',
                                }) }}
                            {% endif %}
                        {% elseif app.user and group.isJoinable %}
                            {{ include('_partials/_empty_state.html.twig', {
                                icon: 'lock',
                                title: 'Salons réservés aux membres',
                                text: 'Rejoignez le groupe avec le bouton « Rejoindre » ci-dessus pour accéder à ses salons.',
                                variant: 'plain',
                            }) }}
                        {% elseif app.user %}
                            {{ include('_partials/_empty_state.html.twig', {
                                icon: 'lock',
                                title: 'Salons réservés aux membres',
                                text: 'Ce groupe fonctionne sur invitation. Découvrez d\'autres groupes ouverts ou créez le vôtre.',
                                cta: {label: 'Voir les groupes', url: path('app_group_index'), icon: 'users'},
                                variant: 'plain',
                            }) }}
                        {% else %}
                            {{ include('_partials/_empty_state.html.twig', {
                                icon: 'lock',
                                title: 'Salons réservés aux membres',
                                text: 'Inscrivez-vous pour rejoindre ce groupe et discuter dans ses salons.',
                                cta: {label: 'Créer mon compte', url: path('app_register')},
                                secondary: {label: 'Se connecter', url: path('app_login')},
                                variant: 'plain',
                            }) }}
                        {% endif %}
                    </div>
                {% endif %}
            </section>

            {# MEMBRES (mobile) : volet repliable #}
            <details class="card details-reset lg:hidden">
                <summary class="flex min-h-12 items-center gap-2 px-4 py-3 font-semibold text-fg">
                    {{ ui.icon('users', 'size-5 text-muted') }}
                    <span class="flex-1">Membres <span class="font-normal text-muted">({{ group.members|length }})</span></span>
                    {{ ui.icon('chevron-down', 'details-chevron size-5 text-muted') }}
                </summary>
                <div class="border-t border-line p-2">
                    {{ _self.member_list(group) }}
                </div>
            </details>
        </div>
    </div>
{% endblock %}
