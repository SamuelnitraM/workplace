{% extends 'base.html.twig' %}

{% block title %}Créer un groupe{% endblock %}

{% block body %}
<div class="max-w-2xl mx-auto">

    <h1 class="text-3xl font-bold text-white mb-8">✚ Créer un groupe</h1>

    <div class="bg-gray-800 rounded-xl border border-gray-700 p-8">
        <form method="post">

            <div class="space-y-5">

                <div>
                    <label class="block text-sm text-gray-400 mb-1">Nom du groupe</label>
                    <input type="text" name="name" required
                           class="w-full bg-gray-700 border border-gray-600 rounded-lg px-4 py-2 text-white focus:outline-none focus:border-indigo-500"
                           placeholder="Nom de votre groupe">
                </div>

                <div>
                    <label class="block text-sm text-gray-400 mb-1">Description</label>
                    <textarea name="description" rows="3"
                              class="w-full bg-gray-700 border border-gray-600 rounded-lg px-4 py-2 text-white focus:outline-none focus:border-indigo-500"
                              placeholder="Décrivez votre groupe..."></textarea>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div class="bg-gray-700 rounded-lg p-4">
                        <label class="flex items-center gap-3 cursor-pointer">
                            <input type="checkbox" name="isPublic" value="1" checked
                                   class="w-5 h-5 accent-indigo-500">
                            <div>
                                <div class="text-white font-semibold">🌍 Public</div>
                                <div class="text-gray-400 text-xs">Visible par tous</div>
                            </div>
                        </label>
                    </div>
                    <div class="bg-gray-700 rounded-lg p-4">
                        <label class="flex items-center gap-3 cursor-pointer">
                            <input type="checkbox" name="isJoinable" value="1" checked
                                   class="w-5 h-5 accent-indigo-500">
                            <div>
                                <div class="text-white font-semibold">🚪 Demandes</div>
                                <div class="text-gray-400 text-xs">Autoriser les demandes d'adhésion</div>
                            </div>
                        </label>
                    </div>
                </div>

            </div>

            <div class="flex gap-3 mt-8">
                <button type="submit"
                        class="bg-indigo-600 hover:bg-indigo-700 px-6 py-2 rounded-lg transition">
                    ✚ Créer le groupe
                </button>
                <a href="{{ path('app_group_index') }}"
                   class="bg-gray-700 hover:bg-gray-600 px-6 py-2 rounded-lg transition">
                    Annuler
                </a>
            </div>

        </form>
    </div>

</div>
{% endblock %}