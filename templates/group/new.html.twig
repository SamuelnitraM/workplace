{% extends 'base.html.twig' %}
{% import '_macros/ui.html.twig' as ui %}

{% block title %}Créer un groupe{% endblock %}

{% block body %}
<div class="container-form">

    <header class="page-header">
        <div>
            <p class="page-header-eyebrow">
                <a class="link" href="{{ path('app_group_index') }}">Groupes</a>{{ ui.icon('chevron-right', 'size-4') }}Nouveau
            </p>
            <h1 class="page-header-title">Créer un groupe</h1>
            <p class="page-header-subtitle">Un espace pour votre club ou votre projet : salons de discussion, tâches partagées et messages épinglés.</p>
        </div>
    </header>

    <form method="post" class="card">
        <input type="hidden" name="_token" value="{{ csrf_token('group') }}">

        <div class="card-body space-y-5">
            <div class="field">
                <label class="label" for="group-name">Nom du groupe</label>
                <input type="text" id="group-name" name="name" value="{{ name|default('') }}" required maxlength="100"
                       class="input" placeholder="Ex. : Club de Lyon, Croisade de Noël…">
            </div>

            <div class="field">
                <label class="label" for="group-description">Description <span class="label-hint">(facultatif)</span></label>
                <textarea id="group-description" name="description" rows="3" class="textarea"
                          placeholder="Décrivez votre groupe : armées jouées, rythme des parties, objectifs…">{{ description|default('') }}</textarea>
            </div>

            <fieldset class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                <legend class="label mb-2">Visibilité et accès</legend>
                <label class="card-inset flex cursor-pointer items-start gap-3 p-4 transition-colors hover:border-line-strong has-[:checked]:border-primary-text has-[:checked]:bg-primary-soft">
                    <input type="checkbox" name="isPublic" value="1" checked class="checkbox mt-0.5">
                    <span>
                        <span class="flex items-center gap-1.5 font-semibold text-fg">{{ ui.icon('globe', 'size-4') }}Public</span>
                        <span class="text-caption text-fg-secondary">Visible par toute la communauté.</span>
                    </span>
                </label>
                <label class="card-inset flex cursor-pointer items-start gap-3 p-4 transition-colors hover:border-line-strong has-[:checked]:border-primary-text has-[:checked]:bg-primary-soft">
                    <input type="checkbox" name="isJoinable" value="1" checked class="checkbox mt-0.5">
                    <span>
                        <span class="flex items-center gap-1.5 font-semibold text-fg">{{ ui.icon('user-plus', 'size-4') }}Ouvert aux demandes</span>
                        <span class="text-caption text-fg-secondary">Chacun peut rejoindre sans invitation.</span>
                    </span>
                </label>
            </fieldset>
        </div>

        <div class="card-footer">
            <a href="{{ path('app_group_index') }}" class="btn btn-ghost">Annuler</a>
            <button type="submit" class="btn btn-primary">{{ ui.icon('plus') }}Créer le groupe</button>
        </div>
    </form>

</div>
{% endblock %}
