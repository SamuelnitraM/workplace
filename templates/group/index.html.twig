{% extends 'base.html.twig' %}
{% import '_macros/ui.html.twig' as ui %}

{% block title %}Groupes — SprueHub{% endblock %}

{# Carte d'un groupe (grille des onglets). role : 'owner' | 'admin' | 'member' | null (groupe public non rejoint) #}
{% macro group_card(group, unread, role) %}
    {% import '_macros/ui.html.twig' as ui %}
    {% set roleChips = {
        owner: {label: 'Propriétaire', class: 'chip-accent', icon: 'crown'},
        admin: {label: 'Admin', class: 'chip-info', icon: 'shield'},
        member: {label: 'Membre', class: '', icon: 'user'},
    } %}
    <a href="{{ path('app_group_show', {slug: group.slug}) }}"
       class="card card-interactive group flex h-full flex-col gap-3 p-4 sm:p-5">
        <div class="flex items-start gap-3">
            <span class="avatar avatar-md rounded-card" style="background: hsl({{ (group.id * 47) % 360 }} 45% 34%)" aria-hidden="true">{{ group.name|first|upper }}</span>
            <div class="min-w-0 flex-1">
                <h3 class="text-h3 truncate text-fg group-hover:text-primary-text">{{ group.name }}</h3>
                <p class="text-caption text-muted truncate">
                    {{ role == 'owner' ? 'Créé par vous' : 'Par ' ~ group.creator.username }}
                </p>
            </div>
            {% if unread > 0 %}
                <span class="count-badge mt-1 shrink-0" title="{{ unread }} message(s) non lu(s)">
                    {{ unread > 99 ? '99+' : unread }}<span class="sr-only"> message(s) non lu(s)</span>
                </span>
            {% endif %}
        </div>

        <p class="line-clamp-2 text-small {{ group.description ? 'text-fg-secondary' : 'text-muted italic' }}">
            {{ group.description ?: 'Pas encore de description.' }}
        </p>

        <div class="mt-auto flex flex-wrap items-center gap-2 pt-1">
            {% if group.isPublic %}
                <span class="chip chip-success">{{ ui.icon('globe', 'size-4') }}Public</span>
            {% else %}
                <span class="chip">{{ ui.icon('lock', 'size-4') }}Privé</span>
            {% endif %}
            <span class="chip">{{ ui.icon('users', 'size-4') }}{{ group.members|length }} membre{{ group.members|length > 1 ? 's' : '' }}</span>
            {% if role and roleChips[role] is defined %}
                <span class="chip {{ roleChips[role].class }}">{{ ui.icon(roleChips[role].icon, 'size-4') }}{{ roleChips[role].label }}</span>
            {% endif %}
        </div>
    </a>
{% endmacro %}

{% block body %}
    <header class="page-header">
        <div>
            <h1 class="page-header-title">Groupes</h1>
            <p class="page-header-subtitle">Votre club, votre table de jeu ou votre projet d'armée : discutez dans des salons et suivez vos tâches ensemble.</p>
        </div>
        {% if app.user %}
            <div class="page-header-actions">
                <a href="{{ path('app_group_new') }}" class="btn btn-primary">{{ ui.icon('plus') }}Créer un groupe</a>
            </div>
        {% endif %}
    </header>

    <div data-controller="tabs">

        {# ONGLETS (état actif : aria-selected, géré par tabs_controller) #}
        <div class="tabs mb-6" role="tablist" aria-label="Groupes">
            <button type="button" role="tab" class="tab" id="tab-mygroups" aria-selected="true" aria-controls="panel-mygroups"
                    data-tabs-target="tab" data-tab="mygroups" data-action="tabs#select">
                {{ ui.icon('users') }}Mes groupes
                <span class="rounded-pill bg-overlay px-2 py-0.5 text-caption font-semibold text-fg-secondary tabular-nums">{{ myGroups|length }}</span>
            </button>
            <button type="button" role="tab" class="tab" id="tab-public" aria-selected="false" aria-controls="panel-public"
                    data-tabs-target="tab" data-tab="public" data-action="tabs#select">
                {{ ui.icon('globe') }}Groupes publics
                <span class="rounded-pill bg-overlay px-2 py-0.5 text-caption font-semibold text-fg-secondary tabular-nums">{{ publicGroups|length }}</span>
            </button>
        </div>

        {# ONGLET MES GROUPES #}
        <div id="panel-mygroups" role="tabpanel" aria-labelledby="tab-mygroups" data-tabs-target="panel" data-panel="mygroups">
            {% if not app.user %}
                {{ include('_partials/_empty_state.html.twig', {
                    icon: 'users',
                    title: 'Rejoignez la communauté',
                    text: 'Connectez-vous pour retrouver vos groupes, discuter dans leurs salons et suivre leurs tâches.',
                    cta: {label: 'Créer mon compte', url: path('app_register')},
                    secondary: {label: 'Se connecter', url: path('app_login')},
                }) }}
            {% elseif myGroups is empty %}
                {{ include('_partials/_empty_state.html.twig', {
                    icon: 'users',
                    title: 'Vous n\'avez pas encore de groupe',
                    text: 'Créez un groupe pour votre club, votre table de jeu ou votre projet de peinture, ou rejoignez un groupe public.',
                    cta: {label: 'Créer un groupe', url: path('app_group_new'), icon: 'plus'},
                    secondary: publicGroups is not empty ? {label: 'Voir les groupes publics', tab: 'public'} : null,
                }) }}
            {% else %}
                {# GROUPES CRÉÉS #}
                {% set createdGroups = myGroups|filter(g => g.creator == app.user) %}
                {% if createdGroups is not empty %}
                    <section aria-labelledby="groups-created-title" class="mb-8">
                        <h2 id="groups-created-title" class="eyebrow mb-3">Groupes créés</h2>
                        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
                            {% for group in createdGroups %}
                                {{ _self.group_card(group, unreadGroupCounts[group.id] ?? 0, 'owner') }}
                            {% endfor %}
                        </div>
                    </section>
                {% endif %}

                {# GROUPES REJOINTS #}
                {% set joinedGroups = myGroups|filter(g => g.creator != app.user) %}
                {% if joinedGroups is not empty %}
                    <section aria-labelledby="groups-joined-title">
                        <h2 id="groups-joined-title" class="eyebrow mb-3">Groupes rejoints</h2>
                        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
                            {% for group in joinedGroups %}
                                {% set membership = group.members|filter(m => m.user == app.user)|first %}
                                {{ _self.group_card(group, unreadGroupCounts[group.id] ?? 0, membership ? membership.role : 'member') }}
                            {% endfor %}
                        </div>
                    </section>
                {% endif %}
            {% endif %}
        </div>

        {# ONGLET GROUPES PUBLICS #}
        <div id="panel-public" role="tabpanel" aria-labelledby="tab-public" data-tabs-target="panel" data-panel="public" hidden>
            {% if publicGroups is empty %}
                {{ include('_partials/_empty_state.html.twig', {
                    icon: 'globe',
                    title: 'Aucun groupe public pour le moment',
                    text: app.user
                        ? 'Lancez le premier : les groupes publics sont visibles par toute la communauté.'
                        : 'Inscrivez-vous pour créer le premier groupe public de la communauté.',
                    cta: app.user
                        ? {label: 'Créer un groupe public', url: path('app_group_new'), icon: 'plus'}
                        : {label: 'Créer mon compte', url: path('app_register')},
                    secondary: app.user ? null : {label: 'Se connecter', url: path('app_login')},
                }) }}
            {% else %}
                <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
                    {% for group in publicGroups %}
                        {% set membership = app.user ? group.members|filter(m => m.user == app.user)|first : null %}
                        {{ _self.group_card(group, unreadGroupCounts[group.id] ?? 0, membership ? membership.role : null) }}
                    {% endfor %}
                </div>
            {% endif %}
        </div>

    </div>
{% endblock %}
