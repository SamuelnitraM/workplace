{# Empty state turned into a call to action (shared rendering of the whole site, design system: .empty-state).
   Parameters:
     icon        (string, optional) name of an icon of the SVG set (e.g. 'camera', 'users', see /_styleguide)
     title       (string, required)                  text  (string, optional)
     hint        (string, optional, e.g. real XP reward, shown in the accent colour)
     cta         ({label, url}, {label, for} or {label, tab}; `for` = id of a field of the page: renders a <label> focusing it;
                  `tab` = name of a tab of the enclosing « tabs » Stimulus controller: renders a button showing it;
                  optional key `icon`: name of the icon shown before the label)
     secondary   (same shape as cta, optional, discreet button)
     variant     ('card' by default: standalone card; 'plain': no frame, inside an existing panel)
     compact     (bool, default false: smaller margins)
     heading     (heading level, default 2)
   All the text is escaped (autoescape). #}
{% import '_macros/ui.html.twig' as ui %}
{% set variant = variant ?? 'card' %}
{% set compact = compact ?? false %}
{% set heading = heading ?? 2 %}
{% set _icon = icon ?? null %}

{% macro action(item, classes) %}
    {%- import '_macros/ui.html.twig' as ui -%}
    {%- set inner -%}{% if item.icon ?? false %}{{ ui.icon(item.icon) }}{% endif %}{{ item.label }}{%- endset -%}
    {%- if item.for is defined and item.for -%}
        <label for="{{ item.for }}" class="{{ classes }}">{{ inner }}</label>
    {%- elseif item.tab is defined and item.tab -%}
        <button type="button" data-action="tabs#select" data-tab="{{ item.tab }}" class="{{ classes }}">{{ inner }}</button>
    {%- else -%}
        <a href="{{ item.url }}" class="{{ classes }}">{{ inner }}</a>
    {%- endif -%}
{% endmacro %}

<div class="empty-state{{ compact ? ' empty-state-compact' : '' }}{{ variant == 'card' ? ' card' : '' }}" data-empty-state>
    {% if _icon %}
        <div class="empty-state-icon" aria-hidden="true">
            {{- ui.icon(_icon) -}}
        </div>
    {% endif %}
    <h{{ heading }} class="empty-state-title">{{ title }}</h{{ heading }}>
    {% if text is defined and text %}
        <p class="empty-state-text">{{ text }}</p>
    {% endif %}
    {% if hint is defined and hint %}
        <p class="empty-state-hint">{{ hint }}</p>
    {% endif %}
    {% if (cta is defined and cta) or (secondary is defined and secondary) %}
        <div class="empty-state-actions">
            {% if cta is defined and cta %}{{ _self.action(cta, 'btn btn-primary') }}{% endif %}
            {% if secondary is defined and secondary %}{{ _self.action(secondary, 'btn btn-ghost') }}{% endif %}
        </div>
    {% endif %}
</div>
