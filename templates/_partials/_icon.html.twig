{%- set _aliases = {
    'house': 'home', 'edit': 'pencil', 'trash-2': 'trash', 'circle-check': 'check-circle', 'triangle-alert': 'alert-triangle',
    'circle-alert': 'alert-circle', 'ellipsis': 'more-horizontal', 'message': 'message-circle', 'close': 'x', 'brush': 'paintbrush',
} -%}
{%- if name == '__names' -%}
    {{- _icons|keys|join(',') -}}
{%- else -%}
    {%- set _key = _aliases[name] ?? name -%}
    {%- set _label = label ?? null -%}
    {%- if _icons[_key] is not defined %}<!-- icône inconnue : {{ name }} -->{% endif -%}
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="{{ stroke ?? 2 }}" stroke-linecap="round" stroke-linejoin="round" class="{{ class ?? 'size-5' }}"{% if _label %} role="img" aria-label="{{ _label }}"{% else %} aria-hidden="true" focusable="false"{% endif %}>{{ (_icons[_key] ?? _icons['help-circle'])|raw }}</svg>
{%- endif -%}
