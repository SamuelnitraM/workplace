{% extends 'base.html.twig' %}
{% import '_macros/ui.html.twig' as ui %}

{% block title %}Accueil — SprueHub{% endblock %}

{#
    Accueil : deux vues.
    - Visiteur : accroche plein écran, proposition de valeur, preuve sociale, carrousels de la galerie, discussions, sections.
    - Membre : tableau de bord (bienvenue, présentation guidée + « Premiers pas », carrousels de la galerie, fil d'actualité).
    The side blocks (latest discussions, my threads, forum sections) are hidden on mobile.
#}

{% block body %}
{% set me = app.user %}

{% if not me %}
    {# ════════════════ VISITEUR ════════════════ #}

    {# Accroche plein écran (sort du conteneur de <main>) #}
    <section class="relative left-1/2 -mt-8 w-screen -translate-x-1/2 overflow-hidden" aria-labelledby="hero-title">
        <div class="absolute inset-0 bg-[url(/images/bgHome.png)] bg-cover bg-center" aria-hidden="true"></div>
        <div class="absolute inset-0 bg-gradient-to-b from-canvas/40 via-canvas/70 to-canvas" aria-hidden="true"></div>
        <div class="relative container-app flex min-h-[26rem] flex-col items-center justify-center py-16 text-center sm:min-h-[32rem] lg:h-[clamp(32rem,60vh,40rem)]">
            <p class="eyebrow text-primary-text">Communauté · Création · Stratégie</p>
            <h1 id="hero-title" class="mt-3 max-w-3xl text-display text-fg sm:text-6xl lg:text-7xl">SprueHub</h1>
            <p class="mt-4 max-w-2xl text-body text-fg-secondary sm:text-lg">
                Le réseau des hobbyistes et passionnés de figurines. Partage tes créations, découvre de nouvelles techniques et échange avec d'autres passionnés.
            </p>
            <div class="mt-8 flex w-full flex-col gap-3 sm:w-auto sm:flex-row">
                <a href="{{ path('app_register') }}" class="btn btn-primary btn-lg">{{ ui.icon('user-plus') }}Rejoindre la communauté</a>
                <a href="{{ path('app_login') }}" class="btn btn-secondary btn-lg">Se connecter</a>
            </div>
        </div>
    </section>

    <div class="mt-4 space-y-12 sm:space-y-16">

        {# Proposition de valeur #}
        <section aria-labelledby="value-title">
            <h2 id="value-title" class="sr-only">Ce que tu trouveras sur SprueHub</h2>
            <ul class="grid gap-4 sm:grid-cols-3">
                {% for item in [
                    {icon: 'camera', title: 'Partage tes créations', text: 'Une galerie pour tes figurines, des « j\'aime » et des commentaires de passionnés.'},
                    {icon: 'swords', title: 'Stratégie et listes d\'armée', text: 'Discute tactique sur le forum et construis tes listes d\'armée.'},
                    {icon: 'trophy', title: 'Progresse avec la communauté', text: 'Gagne de l\'XP, débloque des badges et grimpe au classement.'},
                ] %}
                    <li class="card card-body flex gap-4 sm:flex-col sm:gap-3">
                        <span class="flex size-11 shrink-0 items-center justify-center rounded-control bg-primary-soft text-primary-text">{{ ui.icon(item.icon, 'size-6') }}</span>
                        <div>
                            <h3 class="text-h3 text-fg">{{ item.title }}</h3>
                            <p class="mt-1 text-small text-fg-secondary">{{ item.text }}</p>
                        </div>
                    </li>
                {% endfor %}
            </ul>
        </section>

        {# Preuve sociale : compteurs uniquement quand la communauté est assez grande (HomeController::SOCIAL_PROOF_MIN_MEMBERS) #}
        {% if stats %}
            <section aria-label="La communauté en chiffres">
                <dl class="grid grid-cols-3 gap-3 sm:gap-4">
                    {% for label, value in stats %}
                        <div class="card card-body text-center">
                            <dt class="eyebrow">{{ label }}</dt>
                            <dd class="mt-1 text-h1 text-fg">{{ value|number_format(0, ',', ' ') }}</dd>
                        </div>
                    {% endfor %}
                </dl>
            </section>
        {% else %}
            <section class="card flex flex-col items-center gap-4 border-accent/40 bg-accent-soft p-5 text-center sm:flex-row sm:p-6 sm:text-left" aria-label="Communauté naissante">
                <span class="flex size-12 shrink-0 items-center justify-center rounded-pill bg-accent/20 text-accent-text">{{ ui.icon('medal', 'size-6') }}</span>
                <p class="flex-1 text-fg-secondary">
                    <strong class="font-semibold text-fg">Une communauté toute neuve :</strong>
                    rejoins les premiers membres — les {{ earlyMemberLimit }} premiers inscrits reçoivent le badge <strong class="font-semibold text-accent-text">Avant-garde</strong>.
                </p>
                <a href="{{ path('app_register') }}" class="btn btn-accent shrink-0">Je m'inscris</a>
            </section>
        {% endif %}

        {{ block('gallery_carousels') }}

        <div class="grid gap-8 lg:grid-cols-3">
            <div class="hidden lg:col-span-2 lg:block">
                {{ block('latest_discussions') }}
            </div>
            <div class="hidden lg:block">
                {{ block('categories') }}
            </div>
        </div>
    </div>

{% else %}
    {# ════════════════ MEMBRE : TABLEAU DE BORD ════════════════ #}

    <header class="page-header">
        <div class="flex min-w-0 items-center gap-4">
            <a href="{{ path('app_profil_show', {username: me.username}) }}" class="shrink-0 rounded-pill" aria-label="Mon profil">{{ ui.avatar(me, 'lg') }}</a>
            <div class="min-w-0">
                <h1 class="page-header-title break-words">Bonjour, {{ me.username }}</h1>
                <p class="page-header-subtitle flex flex-wrap items-center gap-2">
                    <span class="chip chip-primary">{{ ui.icon('star') }}Niveau {{ me.level }}</span>
                    {% if me.loginStreak > 0 %}
                        <span class="chip chip-accent">{{ ui.icon('flame') }}Série de {{ me.loginStreak }} jour{{ me.loginStreak > 1 ? 's' }}</span>
                    {% endif %}
                </p>
            </div>
        </div>
    </header>

    <div class="space-y-10">

        {# Présentation guidée à terminer + « Premiers pas » (templates/home/_first_steps.html.twig) #}
        {% if me.onboardingCompletedAt is null or not userDashboard.checklist.complete %}
            <div class="space-y-4">
                {% include 'home/_first_steps.html.twig' with {checklist: userDashboard.checklist} %}
            </div>
        {% endif %}

        {{ block('gallery_carousels') }}

        <div class="grid gap-8 lg:grid-cols-3">
            {# The feed column is exactly as tall as the right column; the feed scrolls inside it #}
            <div class="home-feed-column min-w-0 lg:col-span-2">
                {# Fil d'actualité : amis, groupes ou communauté (templates/feed/_feed.html.twig) #}
                {{ include('feed/_feed.html.twig', {feed: userDashboard.feed, hasNetwork: userDashboard.hasNetwork, filters: feedFilters}, with_context = false) }}
            </div>

            <div class="hidden space-y-8 lg:block">
                {{ block('latest_discussions') }}

                {# Mes derniers sujets #}
                <section class="card" aria-labelledby="my-threads-title">
                    <div class="card-header">
                        <h2 id="my-threads-title" class="text-h3 text-fg">Mes derniers sujets</h2>
                    </div>
                    {% if userDashboard.myThreads is not empty %}
                        <ul>
                            {% for thread in userDashboard.myThreads %}
                                <li>
                                    <a href="{{ path('app_thread_show', {slug: thread.slug}) }}" class="list-row">
                                        <span class="text-muted">{{ ui.icon('file-text', 'size-4') }}</span>
                                        <span class="list-row-main truncate text-small">{{ thread.title }}</span>
                                        <span class="text-muted">{{ ui.icon('chevron-right', 'size-4') }}</span>
                                    </a>
                                </li>
                            {% endfor %}
                        </ul>
                    {% else %}
                        <div class="card-body text-small text-fg-secondary">
                            Pas encore de sujet ? <a href="{{ path('app_forum_index') }}" class="link">Lance ta première discussion</a>
                            <span class="mt-1 block text-caption font-medium text-accent-text">Badge Pionnier I : +50 XP</span>
                        </div>
                    {% endif %}
                </section>

                {{ block('categories') }}
            </div>
        </div>
    </div>
{% endif %}
{% endblock %}

{# ─── Dernières discussions (commun) ─── #}
{% block latest_discussions %}
    {% import '_macros/ui.html.twig' as ui %}
    <section aria-labelledby="latest-title">
        <div class="mb-4 flex items-center justify-between gap-2">
            <h2 id="latest-title" class="section-title mb-0">{{ ui.icon('messages-square') }}Dernières discussions</h2>
            <a href="{{ path('app_forum_index') }}" class="btn btn-link btn-sm">Tout le forum{{ ui.icon('arrow-right') }}</a>
        </div>
        {% if latestPosts is not empty %}
            <ul class="card overflow-hidden">
                {% for post in latestPosts %}
                    <li class="list-row list-row-interactive relative items-start">
                        <a href="{{ path('app_profil_show', {username: post.author.username}) }}" class="relative z-(--z-raised) shrink-0 rounded-pill" aria-label="Profil de {{ post.author.username }}">
                            {{ ui.avatar(post.author, 'md') }}
                        </a>
                        <div class="list-row-main">
                            <a href="{{ path('app_thread_show', {slug: post.thread.slug}) }}"
                               class="block font-medium text-fg after:absolute after:inset-0 after:content-[''] hover:text-primary-text focus-visible:outline-offset-[-2px]">
                                <span class="line-clamp-2 break-words">{{ post.thread.title }}</span>
                            </a>
                            <p class="mt-0.5 line-clamp-1 break-words text-small text-fg-secondary">{{ post.hiddenByModeration ? 'Message masqué par la modération.' : post.content|forum_excerpt(150) }}</p>
                            <p class="mt-1 text-caption text-muted">
                                <span class="font-medium text-fg-secondary">{{ post.author.username }}</span>
                                · <time datetime="{{ post.createdAt|date('c') }}" title="{{ post.createdAt|date('d/m/Y à H:i') }}">{{ post.createdAt|time_ago }}</time>
                            </p>
                        </div>
                    </li>
                {% endfor %}
            </ul>
        {% elseif app.user %}
            {{ include('_partials/_empty_state.html.twig', {
                icon: 'message-circle',
                title: 'Aucune discussion pour l\'instant',
                text: 'Lance la première discussion de la communauté.',
                hint: 'Badge Pionnier I : +50 XP',
                cta: {label: 'Ouvrir le forum', url: path('app_forum_index'), icon: 'message-square'},
            }, with_context = false) }}
        {% else %}
            {{ include('_partials/_empty_state.html.twig', {
                icon: 'message-circle',
                title: 'Aucune discussion pour l\'instant',
                text: 'Inscris-toi et lance la première !',
                cta: {label: 'Rejoindre la communauté', url: path('app_register')},
            }, with_context = false) }}
        {% endif %}
    </section>
{% endblock %}

{# ─── Sections du forum (commun) ─── #}
{% block categories %}
    {% import '_macros/ui.html.twig' as ui %}
    {% if categories is not empty %}
        <section class="card" aria-labelledby="sections-title">
            <div class="card-header">
                <h2 id="sections-title" class="text-h3 text-fg">Explorer les sections</h2>
            </div>
            <ul>
                {% for category in categories %}
                    <li>
                        <a href="{{ path('app_forum_category', {slug: category.slug}) }}" class="list-row">
                            {% if category.icon %}<span class="flex size-9 shrink-0 items-center justify-center rounded-control bg-surface-raised text-primary-text">{{ ui.icon(category.icon, 'size-4') }}</span>{% endif %}
                            <span class="list-row-main">
                                <span class="block truncate text-small font-medium">{{ category.name }}</span>
                                {% if category.description %}<span class="block truncate text-caption text-muted">{{ category.description }}</span>{% endif %}
                            </span>
                            <span class="text-muted">{{ ui.icon('chevron-right', 'size-4') }}</span>
                        </a>
                    </li>
                {% endfor %}
            </ul>
        </section>
    {% endif %}
{% endblock %}

{# ─── Galerie : carrousels « Dernières créations » et « Tendances de la semaine » (commun) ─── #}
{% block gallery_carousels %}
    {% import '_macros/ui.html.twig' as ui %}
    {% set publish_url = app.user ? path('app_profil_show', {username: app.user.username}) ~ '#gallery' : path('app_register') %}
    <section class="space-y-4" aria-label="Galerie de la communauté">
        {% if showcasePhotos is not empty %}
            <div class="flex flex-wrap items-center justify-between gap-3">
                <p class="text-small text-fg-secondary">Les figurines peintes, converties et exposées par la communauté.</p>
                <a href="{{ publish_url }}" class="btn btn-primary">{{ ui.icon('image-plus') }}Publier une photo</a>
            </div>
            <div class="grid gap-6 {{ trendingPhotos is not empty ? 'lg:grid-cols-2' }}">
                {{ include('home/_photo_carousel.html.twig', {id: 'showcase', title: 'Dernières créations de la communauté', icon: 'camera', subtitle: 'Les dernières photos publiées.', photos: showcasePhotos, photoStats: photoStats}, with_context = false) }}
                {% if trendingPhotos is not empty %}
                    {{ include('home/_photo_carousel.html.twig', {id: 'trending', title: 'Tendances de la semaine', icon: 'flame', subtitle: 'Les photos les plus aimées du moment.', photos: trendingPhotos, photoStats: photoStats}, with_context = false) }}
                {% endif %}
            </div>
        {% else %}
            {{ include('_partials/_empty_state.html.twig', {
                icon: 'camera',
                title: 'Aucune création partagée pour l\'instant',
                text: 'Montre la première figurine de la communauté !',
                cta: {label: 'Publier une photo', url: publish_url, icon: 'image-plus'},
            }, with_context = false) }}
        {% endif %}
    </section>
{% endblock %}
